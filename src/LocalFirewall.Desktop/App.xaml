<Application x:Class="LocalFirewall.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalFirewall.UI.ViewModels;assembly=LocalFirewall.UI"
             xmlns:views="clr-namespace:LocalFirewall.UI.Views;assembly=LocalFirewall.UI">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LocalFirewall.UI;component/Themes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/LocalFirewall.UI;component/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
        <views:OverviewView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LiveConnectionsViewModel}">
        <views:LiveConnectionsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AppsViewModel}">
        <views:AppsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:FirewallRulesViewModel}">
        <views:FirewallRulesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:EventsViewModel}">
        <views:EventsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:FirewallRulesViewModel}">
        <views:FirewallRulesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:FilesViewModel}">
        <views:FilesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SecurityViewModel}">
        <views:SecurityView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
