<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux adapters of the axiomd systemd daemon (docs/LINUX_ARCHITECTURE.md): the systemd
    installer and sd_notify, /proc-based connection and process facts, DNS control through
    systemd-resolved / NetworkManager / resolv.conf, the doctor, and the firewall adapter. The
    firewall adapter is a stub in this phase (Firewall/LinuxFirewallPolicyAdapter.cs); the
    nftables engine lands under Nft/ from its own branch and replaces it. Unix-generic code
    (socket IPC, peer authorization, data modes, protected-image audit) comes from
    Axiom.Infrastructure.Unix. Targets plain net10.0; Linux-only runtime code is marked
    [SupportedOSPlatform("linux")] or guarded with OperatingSystem.IsLinux().
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Axiom.Infrastructure.Linux</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
    <ProjectReference Include="..\Axiom.Core\Axiom.Core.csproj" />
    <ProjectReference Include="..\Axiom.Service.Hosting\Axiom.Service.Hosting.csproj" />
    <ProjectReference Include="..\Axiom.Infrastructure.Unix\Axiom.Infrastructure.Unix.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for self-contained single-file publish under central package management. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

</Project>
