<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             xmlns:views="using:Axiom.UI.Avalonia.Views"
             x:Class="Axiom.UI.Avalonia.Views.PrivacyOverviewView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,20,26,26" Spacing="16">

      <Border Classes="card" Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:AxiomSelectableTextBlock Text="Privacy Shield Resolver" Classes="section-title" />
              <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.StatusBadge}"
                                                   Foreground="{DynamicResource Axiom.Accent}"
                                                   FontSize="10" FontWeight="Bold" />
              </Border>
              <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.LastUpdatedText}"
                                                 Foreground="{DynamicResource Axiom.TextMuted}"
                                                 FontSize="10.5" VerticalAlignment="Center" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.StatusText}"
                                               Foreground="{DynamicResource Axiom.TextPrimary}"
                                               FontSize="11.5" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.DetailText}"
                                               Foreground="{DynamicResource Axiom.TextMuted}"
                                               FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Content="Refresh" Command="{Binding PrivacyShield.RefreshCommand}" Padding="12,6" />
            <Button Content="Configure" Command="{Binding OpenSettingsCommand}" Classes="primary" Padding="12,6" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,14,*,14,*,14,*,14,*">
        <Border Grid.Column="0" Classes="card" Padding="14,10">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Accent}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="ACTIVE RULES" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.RuleCountText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.ProfileSummaryText}"
                                               Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="14,10">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Download}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="QUERIES" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.QueriesCountText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.EndpointSummaryText}"
                                               Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="card" Padding="14,10">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Success}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="ALLOWED" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.AllowedCountText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="forwarded upstream" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Classes="card" Padding="14,10">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Critical}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="BLOCKED" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.BlockedCountText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.BlockRateText}"
                                               Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="8" Classes="card" Padding="14,10">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Warning}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="ERRORS" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.ErrorsCountText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="upstream / parse failures" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="8">
        <Border IsVisible="{Binding PrivacyShield.HasStatsHint}" Classes="card" Padding="12,10">
          <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.StatsHintText}" FontSize="11.5"
                                             Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" />
        </Border>
        <Border IsVisible="{Binding PrivacyShield.HasDohBypass}" Background="{DynamicResource Axiom.SurfaceAlt}"
                BorderBrush="{DynamicResource Axiom.Warning}" BorderThickness="1" CornerRadius="8" Padding="12,10">
          <StackPanel Spacing="3">
            <controls:AxiomSelectableTextBlock Text="Browser secure DNS (DoH) bypass" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Axiom.Warning}" />
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.DohBypassText}" FontSize="11"
                                               Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding PrivacyShield.HasDnsOutageRisk}" Background="{DynamicResource Axiom.SurfaceAlt}"
                BorderBrush="{DynamicResource Axiom.Warning}" BorderThickness="1" CornerRadius="8" Padding="12,10">
          <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.DnsOutageWarningText}" FontSize="11"
                                             Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="1.4*,14,*">
        <Border Grid.Column="0" Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Recently blocked (live)" Classes="section-title" />
              <Button Grid.Column="1" Content="{Binding PrivacyShield.RecentBlockedToggleText}"
                      Command="{Binding PrivacyShield.ToggleRecentBlockedCommand}" Padding="10,4" FontSize="11" />
            </Grid>
            <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.RecentBlockedSummary}" FontSize="11"
                                               Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="1.5*,1*,72,36,134,Auto,Auto,Auto" Margin="0,2">
              <controls:AxiomSelectableTextBlock Text="DOMAIN" Classes="table-header" />
              <controls:AxiomSelectableTextBlock Grid.Column="1" Text="APP" Classes="table-header" />
              <controls:AxiomSelectableTextBlock Grid.Column="2" Text="KIND" Classes="table-header" />
              <controls:AxiomSelectableTextBlock Grid.Column="3" Text="N" Classes="table-header" />
              <controls:AxiomSelectableTextBlock Grid.Column="4" Text="DATE / TIME" Classes="table-header" />
            </Grid>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PrivacyShield.RecentBlockedGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="1.5*,1*,72,36,134,Auto,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding Tooltip}"
                          Tag="{Binding $parent[UserControl].DataContext.PrivacyShield}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy domain"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyBlockedDomainCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                          <MenuItem Header="Check in Blackbox graph"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CheckGraphCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                          <Separator />
                          <MenuItem Header="Allow domain"
                                    IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanAllow}"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AllowBlockedDomainCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                          <MenuItem Header="Block domain"
                                    IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanBlock}"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockBlockedDomainCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" Classes="mono" FontSize="11"
                                                         Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AppDisplay}" FontSize="11"
                                                         Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="10.5"
                                                         Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold"
                                                         Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="4" Text="{Binding LastLocalDateTimeText}" Classes="mono" FontSize="10.5"
                                                         Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                      <Button Grid.Column="5" Content="Graph" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                              ToolTip.Tip="Look up this domain in the local Blackbox graph (read-only)."
                              Command="{Binding $parent[UserControl].DataContext.PrivacyShield.CheckGraphCommand}"
                              CommandParameter="{Binding Latest}" />
                      <Button Grid.Column="6" Content="Allow" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                              IsVisible="{Binding CanAllow}"
                              Command="{Binding $parent[UserControl].DataContext.PrivacyShield.AllowBlockedDomainCommand}"
                              CommandParameter="{Binding Latest}" />
                      <Button Grid.Column="7" Content="Block" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                              IsVisible="{Binding CanBlock}"
                              Command="{Binding $parent[UserControl].DataContext.PrivacyShield.BlockBlockedDomainCommand}"
                              CommandParameter="{Binding Latest}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <controls:AxiomSelectableTextBlock Text="No blocked DNS queries recorded in this live window yet."
                                               IsVisible="{Binding !PrivacyShield.HasRecentBlocked}"
                                               FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Spacing="14">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <controls:AxiomSelectableTextBlock Text="Top blocked domains" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding PrivacyShield.TopBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2"
                          Tag="{Binding $parent[UserControl].DataContext.PrivacyShield}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy domain"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyBlockedDomainCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" Classes="mono" FontSize="11"
                                                         Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Count}" Classes="mono" FontSize="11"
                                                         Foreground="{DynamicResource Axiom.TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:AxiomSelectableTextBlock Text="No top blocked domains yet."
                                                 IsVisible="{Binding !PrivacyShield.HasTopBlocked}"
                                                 FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Blocked by application" Classes="section-title" />
                <Button Grid.Column="1" Content="Clear history" Command="{Binding PrivacyShield.ClearBlockedHistoryCommand}"
                        Padding="10,4" FontSize="11" />
              </Grid>
              <controls:AxiomSelectableTextBlock Text="{Binding PrivacyShield.BlockedHistorySummary}" FontSize="11"
                                                 Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PrivacyShield.BlockedHistoryGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,4" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding AppDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                                             Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                          <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="10.5"
                                                             Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding LastLocalDateTimeText}" Classes="mono" FontSize="10.5"
                                                             Foreground="{DynamicResource Axiom.TextMuted}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <views:TraderShieldSectionView DataContext="{Binding TraderShield}"
                                     IsVisible="{Binding IsAvailable}" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
