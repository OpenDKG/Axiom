<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             xmlns:presentation="using:Axiom.Presentation"
             x:Class="Axiom.UI.Avalonia.Views.PrivacyShieldView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,18,24,24">
    <Border Grid.Row="0" Classes="card" Padding="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:AxiomSelectableTextBlock Text="Privacy Shield" Classes="section-title" />
            <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
              <controls:AxiomSelectableTextBlock Text="{Binding StatusBadge}" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <controls:AxiomSelectableTextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="11.5" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding DetailText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Classes="primary" Padding="12,6" />
          <Button Content="Disable" Command="{Binding DisableCommand}" Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <controls:AxiomSelectableTextBlock Grid.Row="1" Text="{Binding BypassText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11"
               TextWrapping="Wrap" Margin="2,10,0,0" />

    <Grid Grid.Row="2" ColumnDefinitions="1.15*,12,*" Margin="0,10,0,0">
      <Border Grid.Column="0" Classes="card" Padding="16">
        <StackPanel Spacing="10">
            <controls:AxiomSelectableTextBlock Text="Filter settings" Classes="section-title" />
            <CheckBox Content="Enable Privacy Shield resolver" IsChecked="{Binding Enabled}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="Profile" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StarterRulesText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <WrapPanel Orientation="Horizontal">
              <CheckBox Content="Telemetry" IsChecked="{Binding Telemetry}" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,0,14,0" />
              <CheckBox Content="Ads" IsChecked="{Binding Ads}" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,0,14,0" />
              <CheckBox Content="Tracking" IsChecked="{Binding Tracking}" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,0,14,0" />
              <CheckBox Content="Analytics" IsChecked="{Binding Analytics}" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,0,14,0" />
              <CheckBox Content="Malware" IsChecked="{Binding Malware}" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,0,14,0" />
              <CheckBox Content="Phishing" IsChecked="{Binding Phishing}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            </WrapPanel>
            <controls:AxiomSelectableTextBlock Text="Resolver choice" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <ComboBox ItemsSource="{Binding ResolverOptions}" SelectedItem="{Binding SelectedResolverOption}"
                      HorizontalAlignment="Stretch" />
            <controls:AxiomSelectableTextBlock Text="{Binding SelectedResolverOption.Description}"
                       FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,10,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <controls:AxiomSelectableTextBlock Text="Resolver port" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBox Text="{Binding PortText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <controls:AxiomSelectableTextBlock Text="Upstream DNS / DoH (comma-separated, or leave empty for automatic DoH)" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBox Text="{Binding UpstreamText}" PlaceholderText="1.1.1.1, 9.9.9.9 (encrypted DoH · ISP blind)" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Encrypt upstream DNS via DoH (HTTPS; the port comes from the DoH URL — hides queries from your ISP)" IsChecked="{Binding EncryptDnsViaDoh}" Foreground="{DynamicResource Axiom.TextPrimary}" />

            <controls:AxiomSelectableTextBlock Text="Blocklist sources" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}" />
                      <controls:AxiomSelectableTextBlock Text="{Binding License}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                      <controls:AxiomSelectableTextBlock Text="{Binding ErrorText}" FontSize="10.5" Foreground="{DynamicResource Axiom.Critical}" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}"
                               VerticalAlignment="Center" Width="200" TextTrimming="CharacterEllipsis"
                               TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Content="Update sources now" Command="{Binding UpdateSourcesCommand}" Padding="12,6" HorizontalAlignment="Left" />
              <CheckBox Content="Auto-update every 24h" IsChecked="{Binding AutoUpdateSources}" VerticalAlignment="Center" />
            </StackPanel>

            <controls:AxiomSelectableTextBlock Text="Custom allowlist (one domain per line)" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,6,0,0" />
            <TextBox Text="{Binding AllowedDomainsText}" AcceptsReturn="True" MinHeight="64" MaxHeight="120" />
            <controls:AxiomSelectableTextBlock Text="Custom blocklist (one domain per line)" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding BlockedDomainsText}" AcceptsReturn="True" MinHeight="64" MaxHeight="140" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Import list…" Command="{Binding ImportBlocklistCommand}" Padding="12,6" />
              <Button Content="Clear lists" Command="{Binding ClearDomainsCommand}" Padding="12,6" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding LastErrorText}" FontSize="11" Foreground="{DynamicResource Axiom.Critical}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,12,Auto,12,Auto">
        <Border Grid.Row="0" Classes="card" Padding="16">
          <StackPanel Spacing="6">
            <controls:AxiomSelectableTextBlock Text="Resolver statistics" Classes="section-title" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatsText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatsHintText}" IsVisible="{Binding HasStatsHint}" FontSize="11"
                                               Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" MaxWidth="420" />
            <Border IsVisible="{Binding HasDohBypass}" Background="{DynamicResource Axiom.SurfaceAlt}"
                    BorderBrush="{DynamicResource Axiom.Warning}" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="3">
                <controls:AxiomSelectableTextBlock Text="Browser secure DNS (DoH) bypass" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Axiom.Warning}" />
                <controls:AxiomSelectableTextBlock Text="{Binding DohBypassText}" FontSize="11"
                                                   Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <controls:AxiomSelectableTextBlock Text="{Binding DohBypassText}" IsVisible="{Binding !HasDohBypass}" FontSize="11"
                                               Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" MaxWidth="420" />
            <controls:AxiomSelectableTextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" MaxWidth="420" />
            <controls:AxiomSelectableTextBlock Text="{Binding LastUpdatedText}" FontSize="10.5" Foreground="{DynamicResource Axiom.Accent}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="{x:Static presentation:PlatformText.AdapterDnsTitle}" Classes="section-title" />
            <controls:AxiomSelectableTextBlock Text="{Binding ManualSetupText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <Border IsVisible="{Binding HasDnsOutageRisk}" Background="{DynamicResource Axiom.SurfaceAlt}"
                    BorderBrush="{DynamicResource Axiom.Warning}" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <controls:AxiomSelectableTextBlock Text="{Binding DnsOutageWarningText}" FontSize="11"
                         Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap" />
            </Border>
            <CheckBox Content="Auto-point active adapter DNS to 127.0.0.1 while resolver runs (click Apply &amp; Save above)"
                      IsChecked="{Binding AutoPointAdapterDns}" FontSize="11.5" />
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                      HorizontalAlignment="Stretch" MaxWidth="420" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Point adapter at resolver" Command="{Binding EnableSystemDnsCommand}" Padding="12,6" />
              <Button Content="Restore saved DNS" Command="{Binding RestoreSystemDnsCommand}" Padding="12,6" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding DnsHelperStatusText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Classes="card" Padding="16">
          <StackPanel Spacing="8" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Recently blocked" Classes="section-title" />
                <Button Grid.Column="1" Content="{Binding RecentBlockedToggleText}" Command="{Binding ToggleRecentBlockedCommand}" Padding="10,4" FontSize="11" />
              </Grid>
              <controls:AxiomSelectableTextBlock Text="{Binding RecentBlockedSummary}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="1.6*,1.1*,72,38,62,Auto,Auto,Auto" Margin="0,2">
                <controls:AxiomSelectableTextBlock Text="DOMAIN" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="APP" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="2" Text="KIND" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="3" Text="N" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="4" Text="TIME" Classes="table-header" />
              </Grid>
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentBlockedGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="1.6*,1.1*,72,38,62,Auto,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding Tooltip}"
                            Tag="{Binding $parent[ItemsControl].DataContext}">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Copy domain"
                                      Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyBlockedDomainCommand}"
                                      CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                            <MenuItem Header="Check in Blackbox graph"
                                      Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CheckGraphCommand}"
                                      CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                            <Separator />
                            <MenuItem Header="Allow domain"
                                      IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanAllow}"
                                      Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AllowBlockedDomainCommand}"
                                      CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                            <MenuItem Header="Block domain"
                                      IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanBlock}"
                                      Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockBlockedDomainCommand}"
                                      CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AppDisplay}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                        <controls:AxiomSelectableTextBlock Grid.Column="4" Text="{Binding LastUtc, StringFormat={}{0:HH:mm:ss}}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                        <Button Grid.Column="5" Content="Graph" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                ToolTip.Tip="Look up this domain in the local Blackbox graph (read-only)."
                                Command="{Binding $parent[ItemsControl].DataContext.CheckGraphCommand}"
                                CommandParameter="{Binding Latest}" />
                        <Button Grid.Column="6" Content="Allow" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                IsVisible="{Binding CanAllow}"
                                Command="{Binding $parent[ItemsControl].DataContext.AllowBlockedDomainCommand}"
                                CommandParameter="{Binding Latest}" />
                        <Button Grid.Column="7" Content="Block" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                IsVisible="{Binding CanBlock}"
                                Command="{Binding $parent[ItemsControl].DataContext.BlockBlockedDomainCommand}"
                                CommandParameter="{Binding Latest}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <controls:AxiomSelectableTextBlock Text="Top blocked domains" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding TopBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2"
                          Tag="{Binding $parent[ItemsControl].DataContext}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy domain"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyBlockedDomainCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Count}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource Axiom.Border}" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Blocked query history" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                <Button Grid.Column="1" Content="Clear history" Command="{Binding ClearBlockedHistoryCommand}" Padding="10,4" />
              </Grid>
              <controls:AxiomSelectableTextBlock Text="{Binding BlockedHistorySummary}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <ScrollViewer x:Name="BlockedHistoryScroll" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding BlockedHistoryGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Expander HorizontalAlignment="Stretch" Margin="0,2" ToolTip.Tip="{Binding Tooltip}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
                            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding AppDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="10.5"
                                       Foreground="{DynamicResource Axiom.TextMuted}" />
                            <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding LastUtc, StringFormat={}{0:MM-dd HH:mm}}" Classes="mono" FontSize="10.5"
                                       Foreground="{DynamicResource Axiom.TextMuted}" />
                          </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Domains}" Margin="18,4,0,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ColumnDefinitions="1.4*,72,38,62,Auto,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding Tooltip}"
                                    Tag="{Binding $parent[UserControl].DataContext}">
                                <Grid.ContextMenu>
                                  <ContextMenu>
                                    <MenuItem Header="Copy domain"
                                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyBlockedDomainCommand}"
                                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                    <MenuItem Header="Check in Blackbox graph"
                                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CheckGraphCommand}"
                                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                                    <Separator />
                                    <MenuItem Header="Allow domain"
                                              IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanAllow}"
                                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AllowBlockedDomainCommand}"
                                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                                    <MenuItem Header="Block domain"
                                              IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanBlock}"
                                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockBlockedDomainCommand}"
                                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext.Latest}" />
                                  </ContextMenu>
                                </Grid.ContextMenu>
                                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding CategoryText}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                                <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding LastUtc, StringFormat={}{0:MM-dd HH:mm}}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="Graph" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                        ToolTip.Tip="Look up this domain in the local Blackbox graph (read-only)."
                                        Command="{Binding $parent[UserControl].DataContext.CheckGraphCommand}"
                                        CommandParameter="{Binding Latest}" />
                                <Button Grid.Column="5" Content="Allow" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                        IsVisible="{Binding CanAllow}"
                                        Command="{Binding $parent[UserControl].DataContext.AllowBlockedDomainCommand}"
                                        CommandParameter="{Binding Latest}" />
                                <Button Grid.Column="6" Content="Block" Padding="8,2" Margin="4,0,0,0" FontSize="10.5"
                                        IsVisible="{Binding CanBlock}"
                                        Command="{Binding $parent[UserControl].DataContext.BlockBlockedDomainCommand}"
                                        CommandParameter="{Binding Latest}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ScrollViewer>
</UserControl>
