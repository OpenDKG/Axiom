<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.PrivacyShieldView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24" ClipToBounds="True">
    <Border Grid.Row="0" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
            CornerRadius="8" Padding="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Privacy Shield" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <Border Background="#123236" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding StatusBadge}" Foreground="#5EEAD4" FontSize="9" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding StatusText}" Foreground="#D6DEE7" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailText}" Foreground="#8A98A8" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="12,6" Background="#1F6FEB" Foreground="#E6EDF3" />
          <Button Content="Disable" Command="{Binding DisableCommand}" Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="{Binding BypassText}" Foreground="#8A98A8" FontSize="10"
               TextWrapping="Wrap" Margin="2,10,0,0" />

    <Grid Grid.Row="2" ColumnDefinitions="1.15*,10,*" Margin="0,10,0,0">
      <Border Grid.Column="0" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
              CornerRadius="8" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <TextBlock Text="Filter settings" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <CheckBox Content="Enable Privacy Shield resolver" IsChecked="{Binding Enabled}" Foreground="#D6DEE7" />
            <TextBlock Text="Profile" FontSize="10" Foreground="#8A98A8" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
            <TextBlock Text="{Binding StarterRulesText}" FontSize="10" Foreground="#8A98A8" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="Telemetry" IsChecked="{Binding Telemetry}" Foreground="#D6DEE7" />
              <CheckBox Content="Ads" IsChecked="{Binding Ads}" Foreground="#D6DEE7" />
              <CheckBox Content="Tracking" IsChecked="{Binding Tracking}" Foreground="#D6DEE7" />
              <CheckBox Content="Analytics" IsChecked="{Binding Analytics}" Foreground="#D6DEE7" />
              <CheckBox Content="Malware" IsChecked="{Binding Malware}" Foreground="#D6DEE7" />
            </StackPanel>
            <Grid ColumnDefinitions="*,10,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Resolver port" FontSize="10" Foreground="#8A98A8" />
                <TextBox Text="{Binding PortText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Upstream DNS (blank = system)" FontSize="10" Foreground="#8A98A8" />
                <TextBox Text="{Binding UpstreamText}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Blocklist sources" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E6EDF3" />
                      <TextBlock Text="{Binding License}" FontSize="9" Foreground="#8A98A8" />
                      <TextBlock Text="{Binding ErrorText}" FontSize="9" Foreground="#EF4444" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="9" Foreground="#8A98A8"
                               VerticalAlignment="Center" Width="200" TextTrimming="CharacterEllipsis"
                               TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Update sources now" Command="{Binding UpdateSourcesCommand}" Padding="12,6" HorizontalAlignment="Left" />

            <TextBlock Text="Custom allowlist (one domain per line)" FontSize="10" Foreground="#8A98A8" Margin="0,6,0,0" />
            <TextBox Text="{Binding AllowedDomainsText}" AcceptsReturn="True" MinHeight="60" MaxHeight="120" />
            <TextBlock Text="Custom blocklist (one domain per line)" FontSize="10" Foreground="#8A98A8" />
            <TextBox Text="{Binding BlockedDomainsText}" AcceptsReturn="True" MinHeight="60" MaxHeight="140" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Import list…" Command="{Binding ImportBlocklistCommand}" Padding="12,6" />
              <Button Content="Clear lists" Command="{Binding ClearDomainsCommand}" Padding="12,6" />
            </StackPanel>
            <TextBlock Text="{Binding LastErrorText}" FontSize="10" Foreground="#EF4444" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,10,*">
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Text="Resolver statistics" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="#D6DEE7" />
            <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" MaxWidth="380" />
            <TextBlock Text="{Binding LastUpdatedText}" FontSize="9" Foreground="#5EEAD4" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,16,0">
              <TextBlock Text="Recently blocked" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" />
              <ItemsControl ItemsSource="{Binding RecentBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="#D6DEE7" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" FontSize="9" Foreground="#8A98A8" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Top blocked domains" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding TopBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="#D6DEE7" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="9" Foreground="#8A98A8" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#2E3A47" Margin="0,6" />
              <TextBlock Text="Adapter DNS (explicit UAC helper)" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" />
              <TextBlock Text="{Binding ManualSetupText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                        HorizontalAlignment="Stretch" MaxWidth="380" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Point adapter at resolver" Command="{Binding EnableSystemDnsCommand}" Padding="12,6" />
                <Button Content="Restore saved DNS" Command="{Binding RestoreSystemDnsCommand}" Padding="12,6" />
              </StackPanel>
              <TextBlock Text="{Binding DnsHelperStatusText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />

              <Border Height="1" Background="#2E3A47" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Blocked query history" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" />
                <Button Grid.Column="1" Content="Clear history" Command="{Binding ClearBlockedHistoryCommand}" Padding="10,4" />
              </Grid>
              <ItemsControl ItemsSource="{Binding BlockedHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="#9BA9B8" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, StringFormat={}{0:MM-dd HH:mm}}" FontSize="9" Foreground="#8A98A8" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
