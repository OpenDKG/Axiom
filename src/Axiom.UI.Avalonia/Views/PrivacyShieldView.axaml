<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.PrivacyShieldView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,18,24,24">
    <Border Grid.Row="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
            CornerRadius="8" Padding="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:AxiomSelectableTextBlock Text="Privacy Shield" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
              <controls:AxiomSelectableTextBlock Text="{Binding StatusBadge}" Foreground="{DynamicResource Axiom.Accent}" FontSize="9" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <controls:AxiomSelectableTextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="11" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding DetailText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="12,6" Background="{DynamicResource Axiom.Accent}" Foreground="{DynamicResource Axiom.AccentContrast}" />
          <Button Content="Disable" Command="{Binding DisableCommand}" Padding="12,6" />
        </StackPanel>
      </Grid>
    </Border>

    <controls:AxiomSelectableTextBlock Grid.Row="1" Text="{Binding BypassText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10"
               TextWrapping="Wrap" Margin="2,10,0,0" />

    <Grid Grid.Row="2" ColumnDefinitions="1.15*,10,*" Margin="0,10,0,0">
      <Border Grid.Column="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
              CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="Filter settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="Enable Privacy Shield resolver" IsChecked="{Binding Enabled}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="Profile" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StarterRulesText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="Telemetry" IsChecked="{Binding Telemetry}" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <CheckBox Content="Ads" IsChecked="{Binding Ads}" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <CheckBox Content="Tracking" IsChecked="{Binding Tracking}" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <CheckBox Content="Analytics" IsChecked="{Binding Analytics}" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <CheckBox Content="Malware" IsChecked="{Binding Malware}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,10,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <controls:AxiomSelectableTextBlock Text="Resolver port" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBox Text="{Binding PortText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <controls:AxiomSelectableTextBlock Text="Upstream DNS (blank = system)" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBox Text="{Binding UpstreamText}" />
              </StackPanel>
            </Grid>

            <controls:AxiomSelectableTextBlock Text="Blocklist sources" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" />
                      <controls:AxiomSelectableTextBlock Text="{Binding License}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                      <controls:AxiomSelectableTextBlock Text="{Binding ErrorText}" FontSize="9" Foreground="{DynamicResource Axiom.Critical}" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}"
                               VerticalAlignment="Center" Width="200" TextTrimming="CharacterEllipsis"
                               TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Update sources now" Command="{Binding UpdateSourcesCommand}" Padding="12,6" HorizontalAlignment="Left" />

            <controls:AxiomSelectableTextBlock Text="Custom allowlist (one domain per line)" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,6,0,0" />
            <TextBox Text="{Binding AllowedDomainsText}" AcceptsReturn="True" MinHeight="60" MaxHeight="120" />
            <controls:AxiomSelectableTextBlock Text="Custom blocklist (one domain per line)" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding BlockedDomainsText}" AcceptsReturn="True" MinHeight="60" MaxHeight="140" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Import list…" Command="{Binding ImportBlocklistCommand}" Padding="12,6" />
              <Button Content="Clear lists" Command="{Binding ClearDomainsCommand}" Padding="12,6" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding LastErrorText}" FontSize="10" Foreground="{DynamicResource Axiom.Critical}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,10,Auto">
        <Border Grid.Row="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="6">
            <controls:AxiomSelectableTextBlock Text="Resolver statistics" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatsText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="{Binding DetailText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" MaxWidth="380" />
            <controls:AxiomSelectableTextBlock Text="{Binding LastUpdatedText}" FontSize="9" Foreground="{DynamicResource Axiom.Accent}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="8" HorizontalAlignment="Stretch">
              <controls:AxiomSelectableTextBlock Text="Recently blocked" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <Grid ColumnDefinitions="1.6*,1.1*,70,58,Auto,Auto" Margin="0,1">
                <controls:AxiomSelectableTextBlock Text="DOMAIN" FontSize="8.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="APP" FontSize="8.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                <controls:AxiomSelectableTextBlock Grid.Column="2" Text="KIND" FontSize="8.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                <controls:AxiomSelectableTextBlock Grid.Column="3" Text="TIME" FontSize="8.5" Foreground="{DynamicResource Axiom.TextMuted}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="1.6*,1.1*,70,58,Auto,Auto" Margin="0,1" ToolTip.Tip="{Binding Tooltip}">
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AppDisplay}" FontSize="9.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                      <Button Grid.Column="4" Content="Allow" Padding="6,2" Margin="4,0,0,0" FontSize="9"
                              IsVisible="{Binding CanAllow}"
                              Command="{Binding $parent[ItemsControl].DataContext.AllowBlockedDomainCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="5" Content="Block" Padding="6,2" Margin="4,0,0,0" FontSize="9"
                              IsVisible="{Binding CanBlock}"
                              Command="{Binding $parent[ItemsControl].DataContext.BlockBlockedDomainCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:AxiomSelectableTextBlock Text="Top blocked domains" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding TopBlocked}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Count}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource Axiom.Border}" Margin="0,6" />
              <controls:AxiomSelectableTextBlock Text="Adapter DNS (explicit UAC helper)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="{Binding ManualSetupText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                        HorizontalAlignment="Stretch" MaxWidth="380" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Point adapter at resolver" Command="{Binding EnableSystemDnsCommand}" Padding="12,6" />
                <Button Content="Restore saved DNS" Command="{Binding RestoreSystemDnsCommand}" Padding="12,6" />
              </StackPanel>
              <controls:AxiomSelectableTextBlock Text="{Binding DnsHelperStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />

              <Border Height="1" Background="{DynamicResource Axiom.Border}" Margin="0,6" />
              <Grid ColumnDefinitions="*,Auto">
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Blocked query history" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                <Button Grid.Column="1" Content="Clear history" Command="{Binding ClearBlockedHistoryCommand}" Padding="10,4" />
              </Grid>
              <ItemsControl ItemsSource="{Binding BlockedHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="1.6*,1.1*,70,58,Auto,Auto" Margin="0,1" ToolTip.Tip="{Binding Tooltip}">
                      <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AppDisplay}" FontSize="9.5" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding TimestampUtc, StringFormat={}{0:MM-dd HH:mm}}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                      <Button Grid.Column="4" Content="Allow" Padding="6,2" Margin="4,0,0,0" FontSize="9"
                              IsVisible="{Binding CanAllow}"
                              Command="{Binding $parent[ItemsControl].DataContext.AllowBlockedDomainCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="5" Content="Block" Padding="6,2" Margin="4,0,0,0" FontSize="9"
                              IsVisible="{Binding CanBlock}"
                              Command="{Binding $parent[ItemsControl].DataContext.BlockBlockedDomainCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ScrollViewer>
</UserControl>
