<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Axiom.UI.Avalonia.Views.AiAnalystView">
  <UserControl.Styles>
    <Style Selector="Ellipse.finding-risk">
      <Setter Property="Fill" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector="Ellipse.finding-risk.serious">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector="Ellipse.finding-risk.flagged">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector="Ellipse.finding-risk.low">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Success}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="FindingAssessmentTemplate">
      <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="5" Padding="8,3"
              HorizontalAlignment="Left" ToolTip.Tip="{Binding Status}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Classes="finding-risk" Classes.serious="{Binding Assessment.IsSerious}"
                   Classes.flagged="{Binding Assessment.IsFlagged}" Classes.low="{Binding Assessment.IsLowRisk}"
                   Width="8" Height="8" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Assessment.Label}" Foreground="{DynamicResource Axiom.TextPrimary}"
                     FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">
    <Border Grid.Row="0" Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <CheckBox Grid.Column="0" Content="Enable AI analyst" IsChecked="{Binding Enabled}" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11.5"
                     TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
          <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding CredentialsText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11"
                     VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="1.1*,12,1*,12,1*">
          <StackPanel Grid.Column="0" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="Provider" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="Endpoint" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding Endpoint}" IsReadOnly="{Binding IsOpenCodeProvider}"
                     ToolTip.Tip="OpenChamber / OpenCode uses its built-in local CLI endpoint; no HTTP server is needed."
                     PlaceholderText="https://… or opencode://local" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="Model" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding Model}" PlaceholderText="model name" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="1*,12,1*,12,1*">
          <StackPanel Grid.Column="0" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="API key (optional)" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding ApiKeyInput}" PasswordChar="●" PlaceholderText="stored with DPAPI" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="Verifier model (optional)" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBox Text="{Binding VerifierModel}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="Max connections / tokens" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <Grid ColumnDefinitions="*,8,*">
              <NumericUpDown Grid.Column="0" Value="{Binding MaxConnections}" Minimum="1" Maximum="50" />
              <NumericUpDown Grid.Column="2" Value="{Binding MaxTokens}" Minimum="256" Maximum="4000" />
            </Grid>
          </StackPanel>
        </Grid>

        <Border Background="{DynamicResource Axiom.SurfaceAlt}" BorderBrush="{DynamicResource Axiom.Border}"
                BorderThickness="1" CornerRadius="8" Padding="10">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <controls:AxiomSelectableTextBlock Text="Configure Axiom from an agent that is already signed in"
                         FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <Button Grid.Column="1" Content="Copy setup prompt" Padding="10,4"
                      Command="{Binding CopyAgentSetupPromptCommand}" />
            </Grid>
            <TextBox Text="{Binding AgentSetupPrompt}" IsReadOnly="True" TextWrapping="Wrap"
                     AcceptsReturn="True" MinHeight="52" />
            <controls:AxiomSelectableTextBlock
                       Text="OpenChamber / OpenCode reuses the agent's own local login; no separate API key is needed."
                       FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox Content="Redact local paths" IsChecked="{Binding RedactPaths}" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <CheckBox Content="Automatic analysis" IsChecked="{Binding AutomaticAnalysis}" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <controls:AxiomSelectableTextBlock Text="Interval (minutes)" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding AnalysisIntervalMinutes}" Minimum="5" Maximum="60" Width="116" />
          <controls:AxiomSelectableTextBlock Text="Max requests/hour" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding MaxRequestsPerHour}" Minimum="1" Maximum="60" Width="116" />
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
          <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" Padding="12,6" />
          <Button Content="Analyze now" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding CanAnalyze}"
                  Classes="primary" Margin="0,0,8,0" Padding="14,6" />
          <Button Content="Clear history" Command="{Binding ClearHistoryCommand}" Padding="12,6" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="160" Height="4" VerticalAlignment="Center" />
          <controls:AxiomSelectableTextBlock Text="{Binding BusyText}" FontSize="11"
                     Foreground="{DynamicResource Axiom.TextSecondary}" VerticalAlignment="Center" />
          <Button Content="Cancel" Command="{Binding CancelAnalysisCommand}" IsEnabled="{Binding CanCancel}"
                  Padding="10,3" />
        </StackPanel>
        <controls:AxiomSelectableTextBlock Text="{Binding SettingsStatus}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
      </StackPanel>
    </Border>

    <controls:AxiomSelectableTextBlock Grid.Row="1" Text="{Binding PrivacyText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11"
               TextWrapping="Wrap" Margin="2,10,0,0" />

    <Grid Grid.Row="2" ColumnDefinitions="320,12,*" Margin="0,10,0,0">
      <Border Grid.Column="0" Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <controls:AxiomSelectableTextBlock Grid.Row="0" Text="Saved findings" Classes="section-title" Margin="4,2,4,8" />
          <Grid Grid.Row="1">
            <ListBox Classes="data-list" ItemsSource="{Binding History}"
                     SelectedItem="{Binding SelectedFinding}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="0,3"
                              Background="Transparent"
                              Tag="{Binding $parent[ListBox].DataContext}">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy selected result"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyResultCommand}" />
                        <MenuItem Header="Copy all findings"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyAllResultsCommand}" />
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FindingAssessmentTemplate}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AnalysisTimestampUtc, StringFormat={}{0:HH:mm:ss}}" Classes="mono" FontSize="10.5"
                               Foreground="{DynamicResource Axiom.TextMuted}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <controls:AxiomSelectableTextBlock IsVisible="{Binding !HasHistory}"
                       Text="No saved findings yet. Run an analysis to create one."
                       Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11.5"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <controls:AxiomSelectableTextBlock Text="Analysis result" Classes="section-title" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Copy result" Command="{Binding CopyResultCommand}" IsEnabled="{Binding CanCopyResult}" Padding="10,4" />
              <Button Content="Copy all" Command="{Binding CopyAllResultsCommand}" IsEnabled="{Binding HasHistory}" Padding="10,4" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
          <StackPanel Spacing="8" IsVisible="{Binding SelectedFinding, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
            <controls:AxiomSelectableTextBlock Text="{Binding SelectedFinding.Summary}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal">
              <ContentControl Content="{Binding SelectedFinding}" ContentTemplate="{StaticResource FindingAssessmentTemplate}" Margin="0,0,6,0" />
              <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0">
                <controls:AxiomSelectableTextBlock Text="{Binding SelectedFinding.Severity, StringFormat=Severity: {0}}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="10" />
              </Border>
              <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="5" Padding="8,3">
                <controls:AxiomSelectableTextBlock Text="{Binding SelectedFinding.Confidence, StringFormat=Confidence: {0}}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="10" />
              </Border>
            </WrapPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding SelectedFinding.Model, StringFormat=Model: {0}}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            <controls:AxiomSelectableTextBlock Text="{Binding SelectedFinding.AnalysisTimestampUtc, StringFormat=Analyzed: {0}}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />

            <controls:AxiomSelectableTextBlock Text="Observations" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding SelectedFinding.Observations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><controls:AxiomSelectableTextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:AxiomSelectableTextBlock Text="Alternative explanations" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding SelectedFinding.AlternativeExplanations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><controls:AxiomSelectableTextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:AxiomSelectableTextBlock Text="Missing evidence" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding SelectedFinding.MissingEvidence}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><controls:AxiomSelectableTextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:AxiomSelectableTextBlock Text="Recommended actions (text only; nothing is applied)" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding SelectedFinding.RecommendedActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><controls:AxiomSelectableTextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <controls:AxiomSelectableTextBlock IsVisible="{Binding SelectedFinding, Converter={x:Static converters:ObjectConverters.IsNull}}"
                     Text="No finding selected. Run an analysis or choose a saved finding."
                     Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
