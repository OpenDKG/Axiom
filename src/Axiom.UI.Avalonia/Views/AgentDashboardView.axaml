<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.AgentDashboardView">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).security">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).security.threat">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector=":is(TextBlock).security.flagged">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Warning}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20,26,26" Spacing="16">
      <Grid ColumnDefinitions="*,14,*,14,*,14,*">
        <Border Grid.Column="0" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Accent}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="SESSIONS" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.SessionCount}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="recorded agent sessions" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Download}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="TOOL CALLS" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ToolCallCount}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="observed by the guard" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Critical}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="BLOCKED FINDINGS" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.BlockedFindingCount}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="explicit block decisions in the audit" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Warning}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="FLAGGED" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.FlaggedFindingCount}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="signals without a block" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <controls:AxiomSelectableTextBlock Text="Blocked actions by agent" Classes="section-title" />
            <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.BlockSummaryText}"
                       FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
          <controls:BlockedActionsChart Bars="{Binding AgentActivity.BlockSummary.ByHarness}"
                     TextBrush="{DynamicResource Axiom.TextSecondary}"
                     MutedBrush="{DynamicResource Axiom.TextMuted}"
                     BarBrush="{DynamicResource Axiom.Critical}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Agent activity" Classes="section-title" />
              <controls:AxiomSelectableTextBlock Text="Recorded sessions, API calls, tool calls and installs from the local Blackbox audit."
                         FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
              <controls:AxiomSelectableTextBlock Text="Local audit · secrets masked" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextSecondary}" />
            </Border>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding AgentActivity.ActivityFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedActivityFilter, Mode=TwoWay}" Width="136"
                      ToolTip.Tip="Filter by recorded sessions, API calls, tool calls, installs, file access or threats." />
            <ComboBox ItemsSource="{Binding AgentActivity.AgentFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedAgentFilter, Mode=TwoWay}" Width="136"
                      ToolTip.Tip="Filter by agent." />
            <ComboBox ItemsSource="{Binding AgentActivity.SeverityFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedSeverityFilter, Mode=TwoWay}" Width="144"
                      ToolTip.Tip="Filter by severity." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ActivityStatusText}" FontSize="11"
                         Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ActivityBreakdownText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.SummaryText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.LastBlockedText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ProtectedPathViolationsText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.UnresolvedText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ActivityFreshnessText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                         IsVisible="{Binding !AgentActivity.HasStaleAgentActivity}" />
              <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ActivityFreshnessText}" FontSize="10.5"
                         Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap"
                         IsVisible="{Binding AgentActivity.HasStaleAgentActivity}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Load more" Padding="10,5" Margin="8,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding AgentActivity.LoadMoreActivityCommand}"
                    IsVisible="{Binding AgentActivity.CanLoadMoreActivity}"
                    ToolTip.Tip="Load the next 100 recorded events, up to the Blackbox dashboard limit." />
          </Grid>

          <Grid ColumnDefinitions="*,12,360">
            <StackPanel Grid.Column="0" Spacing="4">
              <Grid ColumnDefinitions="64,90,110,*,70,76" Margin="8,0,8,2">
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="TIME" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="AGENT" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="2" Text="EVENT" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="3" Text="DETAILS" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="4" Text="SECURITY" Classes="table-header" />
                <controls:AxiomSelectableTextBlock Grid.Column="5" Text="SEVERITY" Classes="table-header" />
              </Grid>
              <ListBox Classes="data-list" ItemsSource="{Binding AgentActivity.Activity}"
                       SelectedItem="{Binding AgentActivity.SelectedActivity, Mode=TwoWay}" Height="196"
                       Background="Transparent" BorderThickness="0"
                       controls:DataListSelection.SelectOnPointerPress="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="64,90,110,*,70,76" Margin="0,1"
                          Background="Transparent"
                          Tag="{Binding $parent[ListBox].DataContext}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy event"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AgentActivity.CopyActivityEventCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                          <MenuItem Header="Copy details"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AgentActivity.CopyActivityDetailsCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                          <MenuItem Header="Copy raw event JSON"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AgentActivity.CopyActivityJsonCommand}"
                                    CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="mono" FontSize="11"
                                 Foreground="{DynamicResource Axiom.TextMuted}" />
                      <TextBlock Grid.Column="1" Text="{Binding Agent}" FontSize="11"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding EventLabel}" FontSize="11"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding ActionSummary}" FontSize="11.5"
                                 Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4" Text="{Binding SecurityOutcome}" FontSize="10.5"
                                 FontWeight="SemiBold" ToolTip.Tip="{Binding SecurityOutcomeDetail}"
                                 Classes="security" Classes.threat="{Binding IsSecurityThreat}" />
                      <TextBlock Grid.Column="5" Text="{Binding Severity}" FontSize="10.5"
                                 Foreground="{DynamicResource Axiom.TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <Border Grid.Column="2" Background="{DynamicResource Axiom.SurfaceAlt}" BorderBrush="{DynamicResource Axiom.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Height="220">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy event" Command="{Binding AgentActivity.CopyActivityEventCommand}" />
                  <MenuItem Header="Copy details" Command="{Binding AgentActivity.CopyActivityDetailsCommand}" />
                  <MenuItem Header="Copy raw event JSON" Command="{Binding AgentActivity.CopyActivityJsonCommand}" />
                </ContextMenu>
              </Border.ContextMenu>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                  <StackPanel Spacing="6" IsVisible="{Binding AgentActivity.HasSelectedActivity}">
                    <controls:AxiomSelectableTextBlock Text="Activity details" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Axiom.TextPrimary}" />
                    <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.SelectedActivityTitle}" FontSize="11"
                               Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentActivity.SelectedActivityDetails}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="92,*" Margin="0,3,0,0">
                            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10.5"
                                       Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Top" />
                            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                       Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Content="Copy event" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                              Command="{Binding AgentActivity.CopyActivityEventCommand}" />
                      <Button Content="Copy details" Padding="8,3" FontSize="11"
                              Command="{Binding AgentActivity.CopyActivityDetailsCommand}" />
                    </WrapPanel>
                  </StackPanel>
                  <controls:AxiomSelectableTextBlock Text="Select a recorded event to see its details."
                             FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                             IsVisible="{Binding !AgentActivity.HasSelectedActivity}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <Border Background="{DynamicResource Axiom.SurfaceAlt}" BorderBrush="{DynamicResource Axiom.Border}"
                  BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <controls:AxiomSelectableTextBlock Text="Security findings" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextPrimary}" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="blocked is not the same as flagged"
                           FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
              </Grid>
              <controls:AxiomSelectableTextBlock
                         Text="Only a finding with an explicit decision of block counts as blocked. Select or right-click a row to inspect or copy."
                         FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,12,320">
                <StackPanel Grid.Column="0" Spacing="4">
                  <Grid ColumnDefinitions="64,90,94,70,*,84" Margin="8,0,8,2">
                    <controls:AxiomSelectableTextBlock Grid.Column="0" Text="TIME" Classes="table-header" />
                    <controls:AxiomSelectableTextBlock Grid.Column="1" Text="AGENT" Classes="table-header" />
                    <controls:AxiomSelectableTextBlock Grid.Column="2" Text="CATEGORY" Classes="table-header" />
                    <controls:AxiomSelectableTextBlock Grid.Column="3" Text="SEVERITY" Classes="table-header" />
                    <controls:AxiomSelectableTextBlock Grid.Column="4" Text="IDENTIFIER" Classes="table-header" />
                    <controls:AxiomSelectableTextBlock Grid.Column="5" Text="SECURITY" Classes="table-header" />
                  </Grid>
                  <ListBox Classes="data-list" ItemsSource="{Binding AgentActivity.Findings}"
                           SelectedItem="{Binding AgentActivity.SelectedFinding, Mode=TwoWay}" Height="134"
                           Background="Transparent" BorderThickness="0"
                           controls:DataListSelection.SelectOnPointerPress="True"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="64,90,94,70,*,84" Margin="0,1"
                              Background="Transparent"
                              Tag="{Binding $parent[ListBox].DataContext}">
                          <Grid.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Copy finding"
                                        Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.AgentActivity.CopyFindingCommand}"
                                        CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                            </ContextMenu>
                          </Grid.ContextMenu>
                          <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="mono" FontSize="11"
                                     Foreground="{DynamicResource Axiom.TextMuted}" />
                          <TextBlock Grid.Column="1" Text="{Binding Agent}" FontSize="11"
                                     Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="11"
                                     Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding Severity}" FontSize="11"
                                     Foreground="{DynamicResource Axiom.TextMuted}" />
                          <TextBlock Grid.Column="4" Text="{Binding Identifier}" Classes="mono" FontSize="11"
                                     Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="5" Text="{Binding SecurityOutcome}" FontSize="10.5"
                                     FontWeight="SemiBold" Classes="security"
                                     Classes.threat="{Binding IsBlocked}" Classes.flagged="{Binding IsFlagged}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>

                <Border Grid.Column="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Height="156">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="5">
                      <StackPanel Spacing="5" IsVisible="{Binding AgentActivity.HasSelectedFinding}">
                        <controls:AxiomSelectableTextBlock Text="Finding details" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Axiom.TextPrimary}" />
                        <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.SelectedFinding.Title}" FontSize="11"
                                   Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                          <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Identifier" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Identifier}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Category" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Category}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Severity" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Severity}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Agent" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Agent}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Tool" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Tool}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Session" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Session}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="6" Grid.Column="0" Text="Source" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.Source}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          <controls:AxiomSelectableTextBlock Grid.Row="7" Grid.Column="0" Text="Security" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" />
                          <controls:AxiomSelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AgentActivity.SelectedFinding.SecurityOutcome}" FontSize="10.5" FontWeight="SemiBold" Classes="security"
                                     Classes.threat="{Binding AgentActivity.SelectedFinding.IsBlocked}"
                                     Classes.flagged="{Binding AgentActivity.SelectedFinding.IsFlagged}" />
                        </Grid>
                        <Button Content="Copy finding" Padding="8,3" FontSize="11" HorizontalAlignment="Left"
                                Command="{Binding AgentActivity.CopyFindingCommand}" />
                      </StackPanel>
                      <controls:AxiomSelectableTextBlock Text="Select a finding to see its details."
                                 FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                                 IsVisible="{Binding !AgentActivity.HasSelectedFinding}" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>