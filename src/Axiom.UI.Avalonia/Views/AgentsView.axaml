<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.AgentsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">

      <Grid ColumnDefinitions="*,14,*">
        <Border Grid.Column="0" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Security.DkgBrandLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="Decentralized Knowledge Graph (DKG): optional local knowledge infrastructure and provenance. This status reflects a local node probe."
                       FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Security.BlackboxBrandLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="Guardian Agent Blackbox by Umanitek: optional local agent-safety module. Connection alone does not prove every agent is protected."
                       FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{Binding Security.AgentStatusTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
              <TextBlock Text="{Binding Security.AgentStatusText}" FontSize="11" Foreground="#9BA9B8" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Security.AgentHookInstallHint}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Configure" Command="{Binding ConfigureCommand}" Padding="12,6" Background="#1F6FEB" Foreground="#E6EDF3" />
                <Button Content="Test Protection" Command="{Binding TestProtectionCommand}" Padding="12,6" />
                <Button Content="Refresh" Command="{Binding RefreshAllCommand}" Padding="12,6" />
                <Button Content="Open Dashboard" Command="{Binding OpenDashboardCommand}" Padding="12,6" />
              </StackPanel>
              <TextBlock Text="{Binding Security.AgentStatusBadge}" FontSize="10" Foreground="#5EEAD4" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Security.LastCheckedText}" FontSize="10" Foreground="#8A98A8" />
          <TextBlock Text="{Binding Security.InstallStatusText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Blackbox health" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <Button Grid.Column="1" Content="View DKG log" Command="{Binding ViewDkgLogCommand}" Padding="10,4" />
          </Grid>
          <TextBlock Text="{Binding HealthStatusText}" FontSize="10" Foreground="#9BA9B8" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BlackboxHealthText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DkgHealthText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AxiomDkgHealthText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GraphHealthText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="{Binding ProtectionTestText}" FontSize="10" Foreground="#5EEAD4" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Verified graph sync" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
              <TextBlock Text="{Binding VerifiedSyncStateDetail}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <TextBlock Text="{Binding VerifiedSyncState}" FontSize="10" Foreground="#5EEAD4" VerticalAlignment="Center" />
              <Button Content="Sync now" Command="{Binding SyncVerifiedGraphCommand}" Padding="10,4" />
            </StackPanel>
          </Grid>
          <ProgressBar Value="{Binding VerifiedSyncPercent}" Maximum="100" Height="6" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding VerifiedSyncCountsText}" FontSize="10" Foreground="#9BA9B8" />
            <TextBlock Grid.Column="1" Text="{Binding VerifiedSyncProgressText}" FontSize="10" Foreground="#9BA9B8" />
          </Grid>
          <TextBlock Text="{Binding VerifiedSyncLookupText}" FontSize="10" Foreground="#8A98A8" />
          <TextBlock Text="{Binding VerifiedGraphListStatus}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AutoSyncStatusText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Hook evidence" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
          <TextBlock Text="Runtime evidence reported by the guard. Installed hooks alone are not proof of blocking."
                     FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          <ListBox Classes="data-list" ItemsSource="{Binding HookEvidence}" SelectedItem="{Binding SelectedHookEvidence}"
                   MaxHeight="180" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="150,90,*,110" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="9" Foreground="#8A98A8" />
                  <TextBlock Grid.Column="1" Text="{Binding Framework}" FontSize="9" Foreground="#9BA9B8" />
                  <TextBlock Grid.Column="2" Text="{Binding EventType}" FontSize="10" Foreground="#E6EDF3" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding GuardStatus}" FontSize="9" Foreground="#8A98A8" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Copy hook evidence" Command="{Binding CopyHookEvidenceCommand}" HorizontalAlignment="Left" Padding="10,4" />
        </StackPanel>
      </Border>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Local Blackbox activity" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Grid.Column="1" Text="{Binding ActivityBreakdownText}" FontSize="10" Foreground="#8A98A8" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding ActivityFilters}" SelectedItem="{Binding SelectedActivityFilter}" Width="130" />
            <ComboBox ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding SelectedAgentFilter}" Width="130" />
            <ComboBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SelectedSeverityFilter}" Width="130" />
            <Button Content="Load more" Command="{Binding LoadMoreActivityCommand}" IsEnabled="{Binding CanLoadMoreActivity}" Padding="10,4" />
          </StackPanel>
          <TextBlock Text="{Binding ActivityStatusText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="1.4*,10,*">
            <ListBox Grid.Column="0" Classes="data-list" ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivity}"
                     MaxHeight="260" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="130,100,*,80" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding DateTimeText}" FontSize="9" Foreground="#8A98A8" />
                    <TextBlock Grid.Column="1" Text="{Binding Agent}" FontSize="9" Foreground="#9BA9B8" />
                    <TextBlock Grid.Column="2" Text="{Binding ActionSummary}" FontSize="10" Foreground="#E6EDF3" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Severity}" FontSize="9" Foreground="#8A98A8" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="#0E1116" CornerRadius="6" Padding="10">
              <StackPanel Spacing="6" IsVisible="{Binding HasSelectedActivity}">
                <TextBlock Text="{Binding SelectedActivityTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding SelectedActivityDetails}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="130,*" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="9" Foreground="#8A98A8" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10" Foreground="#9BA9B8" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Copy event" Command="{Binding CopyActivityEventCommand}" Padding="8,3" Margin="0,0,6,0" />
                  <Button Content="Copy details" Command="{Binding CopyActivityDetailsCommand}" Padding="8,3" Margin="0,0,6,0" />
                  <Button Content="Copy JSON" Command="{Binding CopyActivityJsonCommand}" Padding="8,3" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Findings" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3" />
          <ListBox Classes="data-list" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"
                   MaxHeight="180" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="130,90,*,90" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="9" Foreground="#8A98A8" />
                  <TextBlock Grid.Column="1" Text="{Binding Agent}" FontSize="9" Foreground="#9BA9B8" />
                  <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="10" Foreground="#E6EDF3" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Severity}" FontSize="9" Foreground="#8A98A8" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Copy finding" Command="{Binding CopyFindingCommand}" HorizontalAlignment="Left" Padding="8,3" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
