<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             xmlns:views="using:Axiom.UI.Avalonia.Views"
             x:Class="Axiom.UI.Avalonia.Views.AgentsView">
  <UserControl.Styles>
    <Style Selector="Ellipse.tone-ok">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Ellipse.tone-warn">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector="Ellipse.tone-fail">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector="Ellipse.tone-idle">
      <Setter Property="Fill" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-ok">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-warn">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-fail">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-idle">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector="Border.enforcement-ok">
      <Setter Property="BorderBrush" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Border.enforcement-warn">
      <Setter Property="BorderBrush" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector="Border.enforcement-fail">
      <Setter Property="BorderBrush" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector="Border.sq-on">
      <Setter Property="Background" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Border.sq-off">
      <Setter Property="Background" Value="{DynamicResource Axiom.Border}" />
    </Style>
    <Style Selector="Border.sq-empty">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Axiom.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">

      <Border Classes="card" Padding="14"
              Classes.enforcement-ok="{Binding Enforcement.IsProtected}"
              Classes.enforcement-warn="{Binding Enforcement.IsDegraded}"
              Classes.enforcement-fail="{Binding Enforcement.IsUnprotected}">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="ENFORCEMENT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Axiom.TextMuted}" />
            <Border Grid.Column="1" Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="6" Padding="8,3">
              <controls:AxiomSelectableTextBlock Text="{Binding Enforcement.VerificationLabel}" FontSize="9"
                                                 FontWeight="SemiBold"
                                                 Classes.tone-ok="{Binding Enforcement.IsProtected}"
                                                 Classes.tone-warn="{Binding Enforcement.IsDegraded}"
                                                 Classes.tone-fail="{Binding Enforcement.IsUnprotected}" />
            </Border>
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding Enforcement.Summary}" FontSize="11" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding Enforcement.DetectorDetail}" FontSize="10"
                                             Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding Enforcement.BrokerDetail}" FontSize="10"
                                             Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding Enforcement.PolicyDetail}" FontSize="10"
                                             Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid x:Name="ModuleCardsGrid" ColumnDefinitions="*,14,*">
        <Border x:Name="DkgModuleCard" Grid.Column="0" Classes="card" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Grid.Column="0" Background="{DynamicResource Axiom.LogoBackground}" CornerRadius="8" Padding="6,4" VerticalAlignment="Center">
                <Image Source="avares://Axiom.UI.Avalonia/Assets/origintrail-logo.png"
                       Height="56" Stretch="Uniform" />
              </Border>
              <controls:AxiomSelectableTextBlock Grid.Column="1" Text="origintrail.io" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                        Classes.sq-on="{Binding Security.DkgConnected}"
                        Classes.sq-off="{Binding !Security.DkgConnected}"
                        ToolTip.Tip="{Binding Security.DkgHealthLabel}" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Security.DkgBrandLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
              </Grid>
              <controls:AxiomSelectableTextBlock Text="Decentralized Knowledge Graph (DKG): optional local knowledge infrastructure and provenance. This status reflects a local node probe."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="BlackboxModuleCard" Grid.Column="2" Classes="card" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Grid.Column="0" Background="{DynamicResource Axiom.LogoBackground}" CornerRadius="8" Padding="6,4" VerticalAlignment="Center">
                <Image Source="avares://Axiom.UI.Avalonia/Assets/blackbox-logo.png"
                       Height="34" Stretch="Uniform" />
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource Axiom.LogoBackground}" CornerRadius="8" Padding="6,4"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <Image Source="avares://Axiom.UI.Avalonia/Assets/umanitek-logo.png"
                       Height="44" Stretch="Uniform"
                       ToolTip.Tip="Umanitek" />
              </Border>
            </Grid>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                        Classes.sq-on="{Binding Security.BlackboxConnected}"
                        Classes.sq-off="{Binding !Security.BlackboxConnected}"
                        ToolTip.Tip="{Binding Security.BlackboxHealthLabel}" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Security.BlackboxBrandLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
              </Grid>
              <controls:AxiomSelectableTextBlock Text="Guardian Agent Blackbox by Umanitek: optional local agent-safety module. Connection alone does not prove every agent is protected."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <controls:AxiomSelectableTextBlock Text="Threat sharing" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <controls:AxiomSelectableTextBlock Text="{Binding ThreatSharingStatusText}" FontSize="9" Foreground="{DynamicResource Axiom.Accent}" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Send now" Command="{Binding SubmitThreatShareCommand}" IsEnabled="{Binding CanSubmitThreatShare}" Padding="12,6" />
              <Button Content="{Binding ThreatSharingButtonText}"
                      Command="{Binding ToggleThreatSharingCommand}" IsEnabled="{Binding CanToggleThreatSharing}"
                      Padding="12,6" />
            </StackPanel>
          </Grid>
          <controls:AxiomSelectableTextBlock
                     Text="Axiom only proposes evidence-bound AI Analyst indicators: a malicious-role value must match a remote endpoint Axiom observed. Public blocklist matches stay local and are never reported — they would echo the same list from every install. Ads, tracking and telemetry lists are never proposed. Prompts, commands, file paths, credentials and session ids are never sent."
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                     <controls:AxiomSelectableTextBlock
                     Text="A Complete installation turns sharing on with your consent at install time. Only signed, redacted indicators leave the machine - never prompts, commands, paths, credentials, model content or session ids. It strengthens the verified graph for everyone (help me help you), and you can turn it off here at any time."
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Axiom.SurfaceAlt}"
                  BorderBrush="{DynamicResource Axiom.Border}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,7">
            <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
              <Border Grid.Column="0" Background="{DynamicResource Axiom.Success}" CornerRadius="2" />
              <controls:AxiomSelectableTextBlock Grid.Column="1"
                         Text="Reports join the shared Blackbox graph as community sightings: independent nodes can corroborate the same indicator, which lets Blackbox flag it across the network and gives the curators evidence to promote it into the verified blocking tier. Axiom's own firewall and DNS filtering still decide only from local lists and rules."
                         FontSize="10" Foreground="{DynamicResource Axiom.Success}" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <controls:AxiomSelectableTextBlock Text="{Binding ThreatShareQueueText}" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          <controls:AxiomSelectableTextBlock Text="{Binding ThreatShareReporterText}" FontSize="9"
                     Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ThreatShareCandidates}" IsVisible="{Binding HasThreatShareCandidates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,2">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <controls:AxiomSelectableTextBlock Text="{Binding Candidate.Value}" FontSize="11"
                                 Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Text="{Binding Candidate.NoveltyLabel}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:AxiomSelectableTextBlock Text="{Binding Candidate.PublicPayloadPreview}" FontSize="9"
                               Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <controls:AxiomSelectableTextBlock Text="{Binding Candidate.Detail}" FontSize="9"
                               Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                    <controls:AxiomSelectableTextBlock Text="{Binding StateDetail}" IsVisible="{Binding HasStateDetail}"
                               FontSize="9" Foreground="{DynamicResource Axiom.Warning}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Padding="9,3" FontSize="10"
                          IsEnabled="{Binding $parent[UserControl].DataContext.CanShareThreatShareItem}"
                          Command="{Binding $parent[UserControl].DataContext.ShareThreatShareItemCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="Dismiss" Padding="9,3" FontSize="10"
                          Command="{Binding $parent[UserControl].DataContext.DismissThreatShareCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="4" IsVisible="{Binding HasSubmittedThreatShares}" Margin="0,4,0,0">
            <controls:AxiomSelectableTextBlock Text="Recently shared (retraction sends a withdrawal statement; CC0 replicas may persist)"
                       FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SubmittedThreatShares}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,1">
                    <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Candidate.Id}" FontSize="10"
                               Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Retract" Padding="9,3" FontSize="10"
                            Command="{Binding $parent[UserControl].DataContext.RetractThreatShareCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <controls:AxiomSelectableTextBlock Text="{Binding ThreatShareActionText}" FontSize="10"
                     Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentStatusTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentStatusText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
              <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentHookInstallHint}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Configure" Command="{Binding ConfigureCommand}" Classes="primary" Padding="12,6" />
                <Button Content="Test Protection" Command="{Binding TestProtectionCommand}" Padding="12,6" />
                <Button Content="Refresh" Command="{Binding RefreshAllCommand}" Padding="12,6" />
                <Button Content="Open Dashboard" Command="{Binding OpenDashboardCommand}" Padding="12,6" />
              </StackPanel>
              <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentStatusBadge}" FontSize="10" Foreground="{DynamicResource Axiom.Accent}" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding Security.LastCheckedText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
          <controls:AxiomSelectableTextBlock Text="{Binding Security.InstallStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="0">
        <ItemsControl ItemsSource="{Binding Security.Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="16,12" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                      IsVisible="{Binding IsAgentModule}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                          Background="{DynamicResource Axiom.SurfaceAlt}" Margin="0,0,12,0">
                    <controls:AxiomSelectableTextBlock Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Axiom.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Axiom.TextPrimary}" />
                    <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="{Binding ActionLabel}" Padding="8,3" FontSize="11"
                            IsVisible="{Binding CanAct}"
                            Command="{Binding $parent[ItemsControl].DataContext.Security.ActOnModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Button Content="Uninstall" Padding="8,3" FontSize="11"
                            IsVisible="{Binding CanUninstall}"
                            Command="{Binding $parent[ItemsControl].DataContext.Security.UninstallModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Button Content="Audit" Padding="6,2" FontSize="10"
                            IsVisible="{Binding CanSetMode}"
                            Command="{Binding $parent[ItemsControl].DataContext.Security.SetBlackboxModeCommand}"
                            CommandParameter="audit" />
                    <Button Content="Block" Padding="6,2" FontSize="10"
                            IsVisible="{Binding CanSetMode}"
                            Command="{Binding $parent[ItemsControl].DataContext.Security.SetBlackboxModeCommand}"
                            CommandParameter="block" />
                    <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2">
                      <controls:AxiomSelectableTextBlock Text="{Binding Status}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>


      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Verified graph sync" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="{Binding VerifiedSyncStateDetail}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <controls:AxiomSelectableTextBlock Text="{Binding VerifiedSyncState}" FontSize="10" Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
              <Button Content="Sync now" Command="{Binding SyncVerifiedGraphCommand}" Padding="10,4" />
            </StackPanel>
          </Grid>
          <ProgressBar Value="{Binding VerifiedSyncPercent}" Maximum="100" Height="6" />
          <Grid ColumnDefinitions="*,Auto">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding VerifiedSyncCountsText}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" />
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding VerifiedSyncProgressText}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding VerifiedSyncLookupText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
          <controls:AxiomSelectableTextBlock Text="{Binding VerifiedGraphListStatus}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <CheckBox Content="Auto-sync verified graph every 15 minutes"
                    IsChecked="{Binding IsAutoSyncEnabled}"
                    Foreground="{DynamicResource Axiom.TextPrimary}" />
          <controls:AxiomSelectableTextBlock Text="{Binding AutoSyncStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="8">
        <controls:ThreatGraphControl Height="320"
                                     Threats="{Binding VerifiedGraphThreats}"
                                     Total="{Binding VerifiedGraphTotal}"
                                     CategoryTotals="{Binding VerifiedGraphCategoryTotals}"
                                     StateText="{Binding VerifiedSyncState}"
                                     TextBrush="{DynamicResource Axiom.TextPrimary}"
                                     MutedBrush="{DynamicResource Axiom.TextMuted}"
                                     SurfaceBrush="{DynamicResource Axiom.Surface}"
                                     BorderBrush="{DynamicResource Axiom.Border}"
                                     AccentBrush="{DynamicResource Axiom.Accent}"
                                     HubFillBrush="{DynamicResource Axiom.AccentSoft}" />
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="6">
          <controls:AxiomSelectableTextBlock Text="Verified graph threats" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <controls:AxiomSelectableTextBlock Text="{Binding VerifiedGraphListStatus}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,12,320">
            <ListBox Grid.Column="0" Classes="data-list" ItemsSource="{Binding VerifiedGraphThreats}"
                     SelectedItem="{Binding SelectedThreat}" MaxHeight="200"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,110,80,90" Margin="0,2" Background="Transparent">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="10" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                    <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="6" Padding="10">
              <StackPanel Spacing="6">
                <controls:AxiomSelectableTextBlock Text="{Binding SelectedThreatTitle}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                <controls:AxiomSelectableTextBlock Text="{Binding SelectedThreatDetail}" FontSize="10"
                           Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>