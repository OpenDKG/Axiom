<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.SupportView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">
      <controls:AxiomSelectableTextBlock Text="Getting started" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
      <ItemsControl ItemsSource="{Binding UsageSteps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <StackPanel Spacing="3">
                <controls:AxiomSelectableTextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <controls:AxiomSelectableTextBlock Text="Report and support" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
      <controls:AxiomSelectableTextBlock Text="{Binding SetupNote}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Content="Report an issue" Command="{Binding OpenGitHubIssuesCommand}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="Open repository" Command="{Binding OpenGitHubRepositoryCommand}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="GitHub Sponsors" Command="{Binding OpenDonationPageCommand}" CommandParameter="github"
                IsEnabled="{Binding HasGitHubSponsors}" Margin="0,0,8,8" Padding="12,6" />
      </WrapPanel>

      <controls:AxiomSelectableTextBlock Text="{Binding CryptoEmptyText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding CryptoOptions}" IsVisible="{Binding HasCrypto}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <controls:AxiomSelectableTextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                  <controls:AxiomSelectableTextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                  <controls:AxiomSelectableTextBlock Text="{Binding NetworkWarning}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Copy address" Padding="10,5"
                        Command="{Binding $parent[ItemsControl].DataContext.CopyCryptoAddressCommand}"
                        CommandParameter="{Binding}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <controls:AxiomSelectableTextBlock Text="{Binding ActionStatus}" FontSize="10" Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
