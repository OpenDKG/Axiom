<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.SupportView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">
      <TextBlock Text="Getting started" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
      <ItemsControl ItemsSource="{Binding UsageSteps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,8">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6EDF3" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#9BA9B8" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Report and support" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,6,0,0" />
      <TextBlock Text="{Binding SetupNote}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Content="Report an issue" Command="{Binding OpenGitHubIssuesCommand}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="Open repository" Command="{Binding OpenGitHubRepositoryCommand}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="Buy Me a Coffee" Command="{Binding OpenDonationPageCommand}" CommandParameter="coffee"
                IsEnabled="{Binding HasBuyMeACoffee}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="PayPal.Me" Command="{Binding OpenDonationPageCommand}" CommandParameter="paypal"
                IsEnabled="{Binding HasPayPal}" Margin="0,0,8,8" Padding="12,6" />
        <Button Content="GitHub Sponsors" Command="{Binding OpenDonationPageCommand}" CommandParameter="github"
                IsEnabled="{Binding HasGitHubSponsors}" Margin="0,0,8,8" Padding="12,6" />
      </WrapPanel>

      <TextBlock Text="{Binding CryptoEmptyText}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding CryptoOptions}" IsVisible="{Binding HasCrypto}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3" />
                  <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding NetworkWarning}" FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Copy address" Padding="10,5"
                        Command="{Binding $parent[ItemsControl].DataContext.CopyCryptoAddressCommand}"
                        CommandParameter="{Binding}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding ActionStatus}" FontSize="10" Foreground="#5EEAD4" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
