<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.MiniHomeView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14,12,14,12" RowSpacing="10">

    <!-- Quick one-click protection toggles -->
    <Grid Grid.Row="0" ColumnDefinitions="*,8,*,8,Auto">
      <Button Grid.Column="0" Content="{Binding ShieldButtonText}" Command="{Binding ToggleShieldCommand}"
              Classes.primary="{Binding Firewall.ShieldEnabled}"
              Padding="10,7" FontSize="11.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <Button Grid.Column="2" Content="{Binding PrivacyButtonText}" Command="{Binding TogglePrivacyCommand}"
              IsEnabled="{Binding CanTogglePrivacy}"
              Classes.primary="{Binding PrivacyShield.Enabled}"
              Padding="10,7" FontSize="11.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <Button Grid.Column="4" Content="Expand" Command="{Binding ExpandCommand}"
              Padding="10,7" FontSize="11" ToolTip.Tip="Open full dashboard" />
    </Grid>

    <!-- Scrollable compact blocked summary cards: Network, Agents, Privacy -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">

        <!-- Pending outbound approvals (if any) -->
        <Border Classes="card" Padding="12" IsVisible="{Binding Firewall.HasPending}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="WAITING PERMISSION" Classes="kpi-label" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Firewall.PendingCount, StringFormat={}{0} app(s)}"
                         FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.Accent}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Firewall.Pending}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8,6" Margin="0,2" CornerRadius="5" Background="{DynamicResource Axiom.SurfaceAlt}"
                          BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBlock Grid.Column="0" Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Block" Classes="danger" Padding="8,3" FontSize="10.5"
                              Command="{Binding $parent[ItemsControl].DataContext.Firewall.BlockPendingCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Content="Allow" Classes="primary" Padding="8,3" FontSize="10.5"
                              Command="{Binding $parent[ItemsControl].DataContext.Firewall.AllowPendingCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 1. Network Blocked -->
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="NETWORK BLOCKED" Classes="kpi-label" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding NetworkBlockedCountText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="Open" Command="{Binding OpenFirewallCommand}" Padding="8,2" FontSize="10" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BlockedNetwork}" IsVisible="{Binding HasBlockedNetwork}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="6,5" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <controls:AxiomSelectableTextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="10"
                                                           Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Axiom.Critical}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No blocked network applications." IsVisible="{Binding !HasBlockedNetwork}"
                       FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
          </StackPanel>
        </Border>

        <!-- 2. AI Agents Blocked -->
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="AGENTS BLOCKED" Classes="kpi-label" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding AgentsBlockedCountText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.Warning}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="Open" Command="{Binding OpenAgentsCommand}" Padding="8,2" FontSize="10" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BlockedAgents}" IsVisible="{Binding HasBlockedAgents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="6,5" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <controls:AxiomSelectableTextBlock Text="{Binding Agent}" FontSize="12" FontWeight="SemiBold"
                                                             Foreground="{DynamicResource Axiom.TextPrimary}" />
                          <controls:AxiomSelectableTextBlock Text="{Binding SecurityOutcome}" FontSize="9.5" FontWeight="Bold"
                                                             Foreground="{DynamicResource Axiom.Critical}" VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:AxiomSelectableTextBlock Text="{Binding ActionSummary}" FontSize="10"
                                                           Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="10"
                                                         Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No blocked AI agent actions." IsVisible="{Binding !HasBlockedAgents}"
                       FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
          </StackPanel>
        </Border>

        <!-- 3. Privacy / Trackers Blocked -->
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="PRIVACY BLOCKED" Classes="kpi-label" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding PrivacyBlockedCountText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.Success}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="Open" Command="{Binding OpenPrivacyCommand}" Padding="8,2" FontSize="10" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BlockedPrivacy}" IsVisible="{Binding HasBlockedPrivacy}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="6,5" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <controls:AxiomSelectableTextBlock Text="{Binding Domain}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <controls:AxiomSelectableTextBlock Text="{Binding AppDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No blocked trackers or ads in the live window." IsVisible="{Binding !HasBlockedPrivacy}"
                       FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Bottom bar: Axiom logo, Donate, GitHub, Settings -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-icon.png" Width="26" Height="26" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="Axiom" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <TextBlock Text="{Binding VersionText}" FontSize="9.5" Foreground="{DynamicResource Axiom.TextMuted}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Command="{Binding OpenSupportCommand}" Padding="8,4" FontSize="11">
            <TextBlock Text="♥ Donate" Foreground="{DynamicResource Axiom.Accent}" FontSize="11" FontWeight="SemiBold" />
          </Button>
          <Button Content="GitHub" Command="{Binding OpenGitHubCommand}" Padding="8,4" FontSize="11" />
          <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Padding="8,4" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
