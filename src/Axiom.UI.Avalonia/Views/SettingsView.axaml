<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:Axiom.Presentation"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.SettingsView">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).tone-ok">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-fail">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="*,14,*" Margin="24,18,24,24">
      <StackPanel Grid.Column="0" Spacing="14">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="{Binding CurrentThemeText, StringFormat=Current theme: {0}}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Axiom Glass Dark" Command="{Binding UseGlassDarkThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsGlassDarkTheme}" />
              <Button Content="Axiom Glass Light" Command="{Binding UseGlassLightThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsGlassLightTheme}" />
              <Button Content="Dark" Command="{Binding UseDarkThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsDarkTheme}" />
              <Button Content="Light" Command="{Binding UseLightThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsLightTheme}" />
              <Button Content="Dark Midnight" Command="{Binding UseDarkMidnightThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsDarkMidnightTheme}" />
              <Button Content="Light Warm" Command="{Binding UseLightWarmThemeCommand}" Padding="14,6" Margin="0,0,8,8" Classes.primary="{Binding IsLightWarmTheme}" />
            </WrapPanel>
            <controls:AxiomSelectableTextBlock Text="Visual effects" FontSize="12"
                                               Foreground="{DynamicResource Axiom.TextSecondary}" Margin="0,4,0,0" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Auto" Command="{Binding UseAutoEffectsCommand}" Padding="12,5" Margin="0,0,8,0" Classes.primary="{Binding IsAutoEffects}" />
              <Button Content="Full" Command="{Binding UseFullEffectsCommand}" Padding="12,5" Margin="0,0,8,0" Classes.primary="{Binding IsFullEffects}" />
              <Button Content="Reduced" Command="{Binding UseReducedEffectsCommand}" Padding="12,5" Margin="0,0,8,0" Classes.primary="{Binding IsReducedEffects}" />
              <Button Content="Off" Command="{Binding UseNoEffectsCommand}" Padding="12,5" Classes.primary="{Binding IsNoEffects}" />
            </WrapPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding CurrentVisualEffectsText}" FontSize="10"
                                               Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <Button Content="Restore network settings" Command="{Binding RestoreNetworkSettingsCommand}"
                    IsVisible="{Binding HasNetworkRecovery}" Padding="12,6" HorizontalAlignment="Left" Margin="0,2,0,0"
                    ToolTip.Tip="Restores the DNS servers saved before the last protection change and removes only Axiom-owned firewall rules." />
            <controls:AxiomSelectableTextBlock Text="{Binding NetworkRecoveryStatusText}" IsVisible="{Binding HasNetworkRecovery}"
                                               FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <CheckBox Content="{x:Static presentation:PlatformText.HideConsoleWindowsLabel}" IsChecked="{Binding HideBackgroundWindows}"
                      Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="Show notifications" IsChecked="{Binding NotificationsEnabled}"
                      Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="Show tray icon" IsChecked="{Binding TrayNotificationsEnabled}"
                      Foreground="{DynamicResource Axiom.TextPrimary}" />
            <Button Content="Test alert (preview only; ignores off switch)" Command="{Binding TestNotificationCommand}"
                    HorizontalAlignment="Left" Padding="10,4" Margin="0,2,0,0" />
            <controls:AxiomSelectableTextBlock Text="When Show notifications is off, Axiom suppresses both pop-up alert cards and unread badge indicators. The tray icon and close-to-tray behaviour are separate."
                                               FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="Startup" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="{x:Static presentation:PlatformText.StartWithOs}" IsChecked="{Binding StartWithWindows}"
                      IsEnabled="{Binding IsAutostartSupported}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StartupStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <Button Content="Repair startup entry" Command="{Binding RepairStartupCommand}"
                    IsEnabled="{Binding CanRepairStartup}" Padding="12,6" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="{x:Static presentation:PlatformText.StartupScopeNote}"
                       FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <controls:AxiomSelectableTextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <CheckBox Content="Check for updates" IsChecked="{Binding CheckForUpdates}"
                      Foreground="{DynamicResource Axiom.TextPrimary}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Check for updates now" Command="{Binding CheckForUpdatesNowCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdates}" Padding="12,6" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding UpdateCheckStatusText}" FontSize="10.5"
                                               Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Text="Checks OpenDKG/Axiom for newer stable releases on startup and every 6 hours."
                       FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Top">
        <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <controls:AxiomSelectableTextBlock Text="Build information" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
            <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Milestone" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MilestoneText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Protocol" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProtocolText}" FontSize="11"
                                               Classes.tone-ok="{Binding IsServiceConnected}"
                                               Classes.tone-fail="{Binding !IsServiceConnected}"
                                               TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Data mode" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataModeText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Collector" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CollectorText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="4" Grid.Column="0" Text="Polling" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PollText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <controls:AxiomSelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Storage" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StorageText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="6" Grid.Column="0" Text="OS" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OsText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="7" Grid.Column="0" Text="Process" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,0,14,0" />
            <controls:AxiomSelectableTextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProcessText}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="Local only · no telemetry · no remote access" FontSize="10" Foreground="{DynamicResource Axiom.Accent}" Margin="0,6,0,0" />
        </StackPanel>
        </Border>

        <Border Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <controls:AxiomSelectableTextBlock Grid.Column="0" Text="About Axiom" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
            </Grid>
            <controls:AxiomSelectableTextBlock Text="{Binding AboutTagline}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />

            <controls:AxiomSelectableTextBlock Text="Project Leadership" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="116,*" ColumnSpacing="10">
              <Button Grid.Column="0" Content="{Binding AboutFounder.GitHubHandle}" Command="{Binding OpenProfileCommand}"
                      CommandParameter="{Binding AboutFounder.ProfileUrl}"
                      Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Foreground="{DynamicResource Axiom.Accent}" FontSize="11.5" />
              <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding AboutFounder.Role}" FontSize="10.5"
                                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" />
            </Grid>
            <controls:AxiomSelectableTextBlock Text="Co-Founders &amp; Core Maintainers" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Axiom.TextPrimary}" Margin="0,8,0,2" />
            <ItemsControl ItemsSource="{Binding AboutCoreTeam}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="116,*" ColumnSpacing="10" Margin="0,0,0,4">
                    <Button Grid.Column="0" Content="{Binding GitHubHandle}"
                            Command="{Binding $parent[UserControl].DataContext.OpenProfileCommand}"
                            CommandParameter="{Binding ProfileUrl}"
                            Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Foreground="{DynamicResource Axiom.Accent}" FontSize="11.5" />
                    <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Role}" FontSize="10.5"
                                                       Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:AxiomSelectableTextBlock Text="{Binding AboutCoreTeamStatement}" FontSize="10"
                                               Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <Border Height="1" Background="{DynamicResource Axiom.Border}" Margin="0,6,0,2" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="View license" Command="{Binding ViewLicenseCommand}" Padding="12,6" Margin="0,0,8,8" />
              <Button Content="Notices" Command="{Binding ViewThirdPartyNoticesCommand}" Padding="12,6" Margin="0,0,8,8" />
              <Button Content="Authors" Command="{Binding ViewContributorsCommand}" Padding="12,6" Margin="0,0,8,8" />
              <Button Content="Source code" Command="{Binding OpenSourceCommand}" Padding="12,6" Margin="0,0,8,8" />
              <Button Content="OpenDKG" Command="{Binding OpenAffiliationCommand}" Padding="12,6" Margin="0,0,8,8" />
            </WrapPanel>
            <controls:AxiomSelectableTextBlock Text="{Binding AboutLegalLine}" FontSize="10"
                                               Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Text="{Binding AboutAffiliation}" FontSize="10"
                                               Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
