<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="*,14,*" Margin="24,18,24,24">
      <StackPanel Grid.Column="0" Spacing="14">
        <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <TextBlock Text="{Binding CurrentThemeText, StringFormat=Current theme: {0}}" FontSize="11" Foreground="#9BA9B8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Dark" Command="{Binding UseDarkThemeCommand}" Padding="14,6" />
              <Button Content="Light" Command="{Binding UseLightThemeCommand}" Padding="14,6" />
            </StackPanel>
            <CheckBox Content="Show tray notifications" IsChecked="{Binding TrayNotificationsEnabled}"
                      Foreground="#D6DEE7" Margin="0,6,0,0" />
            <TextBlock Text="Notifications are optional and stay local." FontSize="10" Foreground="#8A98A8" />
          </StackPanel>
        </Border>

        <Border Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Startup" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                      IsEnabled="{Binding IsAutostartSupported}" Foreground="#D6DEE7" />
            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Foreground="#D6DEE7" />
            <TextBlock Text="{Binding StartupStatusText}" FontSize="10" Foreground="#8A98A8" />
            <Button Content="Repair startup entry" Command="{Binding RepairStartupCommand}"
                    IsEnabled="{Binding CanRepairStartup}" Padding="12,6" HorizontalAlignment="Left" />
            <TextBlock Text="Only the per-user Axiom startup value is written. No machine-wide entry is created."
                       FontSize="10" Foreground="#8A98A8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1"
              CornerRadius="8" Padding="16" VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Text="Build information" FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Milestone" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MilestoneText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Protocol" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProtocolText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Data mode" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataModeText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Collector" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CollectorText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Polling" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PollText}" FontSize="11" Foreground="#D6DEE7" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Storage" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StorageText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="OS" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OsText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Process" FontSize="11" Foreground="#8A98A8" Margin="0,0,14,0" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProcessText}" FontSize="11" Foreground="#D6DEE7" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="Local only · no telemetry · no remote access" FontSize="10" Foreground="#5EEAD4" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
