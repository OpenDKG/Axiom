<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.SecurityView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">

      <Border Classes="card" Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <controls:AxiomSelectableTextBlock Text="{Binding SecurityStatusTitle}" Classes="section-title" />
            <controls:AxiomSelectableTextBlock Text="{Binding SecurityStatusText}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="5" Padding="8,3" VerticalAlignment="Top">
            <controls:AxiomSelectableTextBlock Text="{Binding SecurityStatusBadge}" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" FontWeight="Bold" />
          </Border>
        </Grid>
      </Border>

      <Border Classes="card" Padding="0">
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="16,12" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                      IsVisible="{Binding IsSecurityModule}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Axiom.SurfaceAlt}" Margin="0,0,12,0">
                    <controls:AxiomSelectableTextBlock Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Axiom.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                    <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Button Content="{Binding ActionLabel}" Padding="10,4" FontSize="11.5"
                            IsVisible="{Binding CanAct}"
                            Command="{Binding $parent[ItemsControl].DataContext.ActOnModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Button Content="Uninstall" Padding="10,4" FontSize="11.5"
                            IsVisible="{Binding CanUninstall}"
                            Command="{Binding $parent[ItemsControl].DataContext.UninstallModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                      <controls:AxiomSelectableTextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Local file scan" Classes="section-title" />
              <controls:AxiomSelectableTextBlock Text="SHA-256 only; files are never uploaded, deleted or quarantined."
                         FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding FileScanStatus}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
          </Grid>
          <Border IsVisible="{Binding HasCommunityMatches}"
                  Background="{DynamicResource Axiom.DangerBackground}"
                  BorderBrush="{DynamicResource Axiom.Critical}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12">
            <controls:AxiomSelectableTextBlock Text="{Binding CommunityMatchesText}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="#FFFFFF" TextWrapping="Wrap" />
          </Border>
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FileScanResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8,6" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                          Tag="{Binding $parent[ItemsControl].DataContext}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Check hash reputation"
                                  IsEnabled="{Binding $parent[ContextMenu].PlacementTarget.DataContext.HasHash}"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CheckHashCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Block executable"
                                  IsVisible="{Binding $parent[ContextMenu].PlacementTarget.DataContext.CanBlockFromCommunity}"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockCommunityMatchCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <Separator />
                        <MenuItem Header="Copy SHA-256 hash"
                                  IsEnabled="{Binding $parent[ContextMenu].PlacementTarget.DataContext.HasHash}"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyScanHashCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Copy file path"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyScanPathCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="*,180,86,76,150,136">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <controls:AxiomSelectableTextBlock Text="{Binding Path}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                        <controls:AxiomSelectableTextBlock Text="{Binding CommunityText}" IsVisible="{Binding IsCommunityMatch}"
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.Critical}" TextWrapping="Wrap" />
                      </StackPanel>
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding HashText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                      <controls:AxiomSelectableTextBlock Grid.Column="4" Text="{Binding VerdictText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Check" Padding="8,3" FontSize="11"
                                IsEnabled="{Binding HasHash}"
                                Command="{Binding $parent[ItemsControl].DataContext.CheckHashCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="Block" Classes="danger" Padding="8,3" FontSize="11"
                                IsVisible="{Binding CanBlockFromCommunity}"
                                ToolTip.Tip="Create an outbound Axiom firewall block rule for this executable"
                                Command="{Binding $parent[ItemsControl].DataContext.BlockCommunityMatchCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Community feed" Classes="section-title" />
              <controls:AxiomSelectableTextBlock Text="{Binding CommunityStatusText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Test feed" Command="{Binding TestCommunityCommand}" Padding="10,4" />
              <Button Content="Refresh feed" Command="{Binding RefreshCommunityCommand}" Padding="10,4" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="200,*,110,110" Margin="0,6,0,2">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="SHA-256" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="NAME" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="2" Text="VERDICT" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="3" Text="SOURCE" Classes="table-header" />
          </Grid>
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CommunityEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="200,*,110,110" Margin="0,3"
                        Tag="{Binding $parent[ItemsControl].DataContext}">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy SHA-256 hash"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyCommunityHashCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding Sha256}" Classes="mono" FontSize="10.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding Verdict}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
                    <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <controls:AxiomSelectableTextBlock Text="Reputation and community lookups are opt-in; the local file scan never uploads files. Agent installers and protection live on the Agents page."
                     FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
