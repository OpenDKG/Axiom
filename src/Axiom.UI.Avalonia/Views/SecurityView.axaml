<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.SecurityView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{Binding SecurityStatusTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <TextBlock Text="{Binding SecurityStatusText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
            <TextBlock Text="{Binding SecurityStatusBadge}" Foreground="{DynamicResource Axiom.Accent}" FontSize="9" FontWeight="Bold" />
          </Border>
        </Grid>
      </Border>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="0">
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="16,12" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                      IsVisible="{Binding IsSecurityModule}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Axiom.SurfaceAlt}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Axiom.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Button Content="{Binding ActionLabel}" Padding="8,3" FontSize="11"
                            IsVisible="{Binding CanAct}"
                            Command="{Binding $parent[ItemsControl].DataContext.ActOnModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Button Content="Uninstall" Padding="8,3" FontSize="11"
                            IsVisible="{Binding CanUninstall}"
                            Command="{Binding $parent[ItemsControl].DataContext.UninstallModuleCommand}"
                            CommandParameter="{Binding Name}" />
                    <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2">
                      <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{DynamicResource Axiom.TextPrimary}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Local file scan" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Text="SHA-256 only; files are never uploaded, deleted or quarantined."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding FileScanStatus}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
          </Grid>
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FileScanResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8,6" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,170,80,70,150,70">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding HashText}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding VerdictText}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="5" Content="Check" Padding="6,2" FontSize="10"
                              IsEnabled="{Binding HasHash}"
                              Command="{Binding $parent[ItemsControl].DataContext.CheckHashCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Community feed" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Text="{Binding CommunityStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Test feed" Command="{Binding TestCommunityCommand}" Padding="10,4" />
              <Button Content="Refresh feed" Command="{Binding RefreshCommunityCommand}" Padding="10,4" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="190,*,100,100" Margin="0,8,0,2">
            <TextBlock Grid.Column="0" Text="SHA-256" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBlock Grid.Column="1" Text="NAME" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBlock Grid.Column="2" Text="VERDICT" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            <TextBlock Grid.Column="3" Text="SOURCE" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
          </Grid>
          <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CommunityEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="190,*,100,100" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Sha256}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Verdict}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" />
                    <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Reputation and community lookups are opt-in; the local file scan never uploads files. Agent installers and protection live on the Agents page."
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
