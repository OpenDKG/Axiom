<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.AgentHealthView">
  <UserControl.Styles>
    <Style Selector="Ellipse.tone-ok">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Ellipse.tone-warn">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector="Ellipse.tone-fail">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector="Ellipse.tone-idle">
      <Setter Property="Fill" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-ok">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-warn">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-fail">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-idle">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector="Border.sq-on">
      <Setter Property="Background" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Border.sq-off">
      <Setter Property="Background" Value="{DynamicResource Axiom.Border}" />
    </Style>
    <Style Selector="Border.sq-empty">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Axiom.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Protected workspaces" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="Hermes, OpenClaw, OpenCode, OpenChamber, Codex, Claude Code, Antigravity, ZCode and DeepSeek Harness. Installed hooks are not proof of runtime blocking."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-ok" />
                  <controls:AxiomSelectableTextBlock Text="Hooked / verified" FontSize="9" Classes="tone-ok" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-warn" />
                  <controls:AxiomSelectableTextBlock Text="Needs test" FontSize="9" Classes="tone-warn" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-fail" />
                  <controls:AxiomSelectableTextBlock Text="Failed / offline" FontSize="9" Classes="tone-fail" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-idle" />
                  <controls:AxiomSelectableTextBlock Text="Not detected" FontSize="9" Classes="tone-idle" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Install/repair agent hooks…"
                    Command="{Binding Security.InstallAgentHooksCommand}" Padding="12,6"
                    VerticalAlignment="Top" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentsStatusText}" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Security.ProtectedAgents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,7" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                        Tag="{Binding $parent[ItemsControl].DataContext}">
                  <Grid ColumnDefinitions="84,*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4"
                            Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <controls:AxiomSelectableTextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Axiom.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0" Spacing="2">
                      <controls:AxiomSelectableTextBlock Text="{Binding TargetText}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                      <StackPanel Spacing="2">
                        <Button Content="Test hook" Padding="7,3" FontSize="10"
                                IsEnabled="{Binding CanTest}"
                                Command="{Binding $parent[ItemsControl].DataContext.Security.TestAgentCommand}"
                                CommandParameter="{Binding}" />
                        <controls:AxiomSelectableTextBlock Text="{Binding TestResult}" FontSize="8"
                                   Foreground="{DynamicResource Axiom.TextMuted}" MaxWidth="220"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2"
                              VerticalAlignment="Top" ToolTip.Tip="{Binding ToneHint}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                   Classes.tone-ok="{Binding ToneOk}"
                                   Classes.tone-warn="{Binding ToneWarn}"
                                   Classes.tone-fail="{Binding ToneFail}"
                                   Classes.tone-idle="{Binding ToneIdle}" />
                          <controls:AxiomSelectableTextBlock Text="{Binding DisplayStatus}" FontSize="9"
                                     Classes.tone-ok="{Binding ToneOk}"
                                     Classes.tone-warn="{Binding ToneWarn}"
                                     Classes.tone-fail="{Binding ToneFail}"
                                     Classes.tone-idle="{Binding ToneIdle}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copy agent details"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.Security.CopyAgentDetailsCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <controls:AxiomSelectableTextBlock Text="Blackbox health" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <Button Grid.Column="1" Content="View DKG log" Command="{Binding AgentActivity.ViewDkgLogCommand}" Padding="10,4" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.HealthStatusText}" FontSize="10" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
            <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AgentActivity.BlackboxHealthText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AgentActivity.DkgHealthText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AgentActivity.AxiomDkgHealthText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AgentActivity.GraphHealthText}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.ProtectionTestText}" FontSize="10" Foreground="{DynamicResource Axiom.Accent}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Module health" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="One square per 5 s loopback check, last 30 kept. Green = connected, muted = not running, outlined = waiting for a sample."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2" VerticalAlignment="Top">
              <controls:AxiomSelectableTextBlock Text="{Binding Security.ModuleActivitySummary}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
            </Border>
          </Grid>
          <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" RowSpacing="6">
            <controls:AxiomSelectableTextBlock Grid.Row="0" Grid.Column="0" Text="DKG" FontSize="10"
                       Foreground="{DynamicResource Axiom.TextSecondary}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
              <ItemsControl ItemsSource="{Binding Security.ModuleHealthSlots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="7" Height="12" CornerRadius="1" Margin="1,0"
                            Classes.sq-on="{Binding DkgOn}"
                            Classes.sq-off="{Binding DkgOff}"
                            Classes.sq-empty="{Binding IsPlaceholder}"
                            ToolTip.Tip="{Binding IsPlaceholder, StringFormat=Waiting for sample}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <controls:AxiomSelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Blackbox" FontSize="10"
                       Foreground="{DynamicResource Axiom.TextSecondary}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
              <ItemsControl ItemsSource="{Binding Security.ModuleHealthSlots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="7" Height="12" CornerRadius="1" Margin="1,0"
                            Classes.sq-on="{Binding BlackboxOn}"
                            Classes.sq-off="{Binding BlackboxOff}"
                            Classes.sq-empty="{Binding IsPlaceholder}"
                            ToolTip.Tip="{Binding IsPlaceholder, StringFormat=Waiting for sample}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding AgentActivity.HealthStatusText}" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>