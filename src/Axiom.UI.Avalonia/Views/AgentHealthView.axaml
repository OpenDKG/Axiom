<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.AgentHealthView">
  <UserControl.Styles>
    <Style Selector="Ellipse.tone-ok">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector="Ellipse.tone-warn">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector="Ellipse.tone-fail">
      <Setter Property="Fill" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector="Ellipse.tone-idle">
      <Setter Property="Fill" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-ok">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-warn">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Warning}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-fail">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector=":is(TextBlock).tone-idle">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.TextMuted}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="14">
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="Protected workspaces" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <controls:AxiomSelectableTextBlock Text="Hermes, OpenClaw, OpenCode, OpenChamber, Codex, Claude Code, Antigravity, ZCode and DeepSeek Harness. Installed hooks are not proof of runtime blocking."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-ok" />
                  <controls:AxiomSelectableTextBlock Text="Hooked / verified" FontSize="9" Classes="tone-ok" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-warn" />
                  <controls:AxiomSelectableTextBlock Text="Needs test" FontSize="9" Classes="tone-warn" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-fail" />
                  <controls:AxiomSelectableTextBlock Text="Failed / offline" FontSize="9" Classes="tone-fail" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="tone-idle" />
                  <controls:AxiomSelectableTextBlock Text="Not detected" FontSize="9" Classes="tone-idle" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Install/repair agent hooksâ€¦"
                    Command="{Binding Security.InstallAgentHooksCommand}" Padding="12,6"
                    VerticalAlignment="Top" />
          </Grid>
          <controls:AxiomSelectableTextBlock Text="{Binding Security.AgentsStatusText}" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Security.ProtectedAgents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,7" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1"
                        Tag="{Binding $parent[ItemsControl].DataContext}">
                  <Grid ColumnDefinitions="84,*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4"
                            Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <controls:AxiomSelectableTextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Axiom.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0" Spacing="2">
                      <controls:AxiomSelectableTextBlock Text="{Binding TargetText}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <controls:AxiomSelectableTextBlock Text="{Binding Detail}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                      <StackPanel Spacing="2">
                        <Button Content="Test hook" Padding="7,3" FontSize="10"
                                IsEnabled="{Binding CanTest}"
                                Command="{Binding $parent[ItemsControl].DataContext.Security.TestAgentCommand}"
                                CommandParameter="{Binding}" />
                        <controls:AxiomSelectableTextBlock Text="{Binding TestResult}" FontSize="8"
                                   Foreground="{DynamicResource Axiom.TextMuted}" MaxWidth="220"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2"
                              VerticalAlignment="Top" ToolTip.Tip="{Binding ToneHint}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                   Classes.tone-ok="{Binding ToneOk}"
                                   Classes.tone-warn="{Binding ToneWarn}"
                                   Classes.tone-fail="{Binding ToneFail}"
                                   Classes.tone-idle="{Binding ToneIdle}" />
                          <controls:AxiomSelectableTextBlock Text="{Binding DisplayStatus}" FontSize="9"
                                     Classes.tone-ok="{Binding ToneOk}"
                                     Classes.tone-warn="{Binding ToneWarn}"
                                     Classes.tone-fail="{Binding ToneFail}"
                                     Classes.tone-idle="{Binding ToneIdle}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copy agent details"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.Security.CopyAgentDetailsCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>