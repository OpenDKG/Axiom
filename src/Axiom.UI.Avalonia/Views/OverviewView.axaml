<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.OverviewView">
  <UserControl.Styles>
    <Style Selector=":is(TextBlock).security">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
    </Style>
    <Style Selector=":is(TextBlock).security.threat">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
    </Style>
    <Style Selector=":is(TextBlock).security.flagged">
      <Setter Property="Foreground" Value="{DynamicResource Axiom.Warning}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,20,26,26" Spacing="16">
      <Grid ColumnDefinitions="*,14,*,14,*,14,*">
        <Border Grid.Column="0" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Accent}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="ACTIVE SOCKETS" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding ConnectionsText}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="{Binding SourceBadgeText}" Foreground="{DynamicResource Axiom.Accent}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Download}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="PROCESSES" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding ProcessesText}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="with at least one socket" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.AccentStrong}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="LOOPBACK" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding LoopbackText}" Classes="kpi-value" FontSize="24" />
            <controls:AxiomSelectableTextBlock Text="local-only endpoints" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Classes="card" Padding="14,8">
          <StackPanel Spacing="3">
            <Border Width="24" Height="2" CornerRadius="1.5" Background="{DynamicResource Axiom.Success}" HorizontalAlignment="Left" />
            <controls:AxiomSelectableTextBlock Text="THROUGHPUT" Classes="kpi-label" />
            <controls:AxiomSelectableTextBlock Text="{Binding DownloadText}" Classes="kpi-value" FontSize="23" />
            <controls:AxiomSelectableTextBlock Text="{Binding UploadText, StringFormat=Upload: {0}}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="System-wide throughput" Classes="section-title" />
              <controls:AxiomSelectableTextBlock Text="{Binding BucketLabel}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="96" />
          </Grid>
          <Grid>
            <controls:TrafficChartControl Height="180" UploadSeries="{Binding UploadSeries}" DownloadSeries="{Binding DownloadSeries}"
                                          GridLineBrush="{DynamicResource Axiom.GridLine}"
                                          UploadBrush="{DynamicResource Axiom.Upload}"
                                          DownloadBrush="{DynamicResource Axiom.Download}"
                                          MutedBrush="{DynamicResource Axiom.TextMuted}" />
            <Border IsVisible="{Binding ShowNoDataOverlay}"
                    Background="{DynamicResource Axiom.Surface}"
                    BorderBrush="{DynamicResource Axiom.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
              <controls:AxiomSelectableTextBlock Text="{Binding NoDataText}"
                         Foreground="{DynamicResource Axiom.TextMuted}"
                         FontSize="11.5"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         MaxWidth="460" />
            </Border>
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,*">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding DownloadText, StringFormat=Down: {0}}" Foreground="{DynamicResource Axiom.Download}" FontSize="11" FontWeight="Medium" Margin="0,0,16,0" />
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding UploadText, StringFormat=Up: {0}}" Foreground="{DynamicResource Axiom.Accent}" FontSize="11" FontWeight="Medium" Margin="0,0,16,0" />
            <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding RangeNote}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" MaxWidth="520" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="1.6*,14,*">
        <Border Grid.Column="0" Classes="card" Padding="16">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <controls:AxiomSelectableTextBlock Grid.Column="0" Text="New connection events" Classes="section-title" />
              <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding NewConnectionsText}" FontSize="11"
                         Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
            </Grid>
            <ListBox Classes="data-list" ItemsSource="{Binding NewConnectionEvents}"
                     SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                     MaxHeight="196" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="72,*" Margin="0,2"
                        Tag="{Binding $parent[ListBox].DataContext}">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Inspect event details"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.InspectMarkerEventCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Copy event details"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyMarkerEventCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Copy executable path"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyMarkerPathCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Copy remote endpoint"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyMarkerRemoteCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <Separator />
                        <MenuItem Header="Block outbound"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockMarkerOutboundCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Block inbound"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockMarkerInboundCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <Separator />
                        <MenuItem Header="End task"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndMarkerTaskCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="mono" FontSize="11"
                               Foreground="{DynamicResource Axiom.TextMuted}" />
                    <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11.5"
                               Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <controls:AxiomSelectableTextBlock Text="{Binding NewConnectionEventsEmptyText}" FontSize="11"
                       Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                       IsVisible="{Binding !HasNewConnectionEvents}" />
            <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="6" Padding="10,8">
              <controls:AxiomSelectableTextBlock Text="{Binding SelectedEventDetails}" FontSize="11"
                         Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <controls:AxiomSelectableTextBlock Text="Top applications" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding TopApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="6,4" CornerRadius="6" Background="Transparent"
                          Tag="{Binding $parent[UserControl].DataContext}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy executable path"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyTopAppPathCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <Separator />
                        <MenuItem Header="Block outbound"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockTopAppOutboundCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <MenuItem Header="Block inbound"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockTopAppInboundCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                        <Separator />
                        <MenuItem Header="End task"
                                  Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTopAppTaskCommand}"
                                  CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Width="{Binding BarWidth}" Height="3" CornerRadius="1.5"
                                Background="{DynamicResource Axiom.Accent}" HorizontalAlignment="Left" />
                      </StackPanel>
                      <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding SocketsText}" FontSize="11"
                                 Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="Live sockets" Classes="section-title" />
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding SourceText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Block outbound" Padding="10,4"
                    Command="{Binding BlockOutboundCommand}" CommandParameter="{Binding SelectedSocket}" />
            <Button Content="Block inbound" Padding="10,4"
                    Command="{Binding BlockInboundCommand}" CommandParameter="{Binding SelectedSocket}" />
            <Button Content="End task" Classes="danger" Padding="10,4"
                    Command="{Binding EndTaskCommand}" CommandParameter="{Binding SelectedSocket}" />
            <Button Content="Copy path" Padding="10,4"
                    Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedSocket}" />
            <Button Content="Copy remote" Padding="10,4"
                    Command="{Binding CopyRemoteCommand}" CommandParameter="{Binding SelectedSocket}" />
          </StackPanel>
          <Grid ColumnDefinitions="200,84,240,*" Margin="8,4,8,2">
            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="APPLICATION" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="PROTOCOL" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="2" Text="REMOTE ENDPOINT" Classes="table-header" />
            <controls:AxiomSelectableTextBlock Grid.Column="3" Text="STATE" Classes="table-header" />
          </Grid>
          <ListBox Classes="data-list" ItemsSource="{Binding Connections}" Height="390" Background="Transparent" BorderThickness="0"
                   SelectedItem="{Binding SelectedSocket}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="200,84,240,*" Margin="0,2"
                      ToolTip.Tip="{Binding RowTooltip}"
                      Tag="{Binding $parent[ListBox].DataContext}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copy row details"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <MenuItem Header="Copy executable path"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <MenuItem Header="Copy remote endpoint"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <Separator />
                      <MenuItem Header="Block outbound"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockOutboundCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <MenuItem Header="Block inbound"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockInboundCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <Separator />
                      <MenuItem Header="End task"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTaskCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding AppDisplayName}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                  <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding ProtocolText}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                  <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding RemoteEndpoint}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                  <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding State}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <controls:AxiomSelectableTextBlock Text="{Binding ActionStatusText}" FontSize="11"
                     Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>