<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.OverviewView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,24" Spacing="14">
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,12,*,12,*,12,*">
        <Border Grid.Column="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="ACTIVE SOCKETS" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
            <TextBlock Text="{Binding ConnectionsText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourceBadgeText}" Foreground="{DynamicResource Axiom.Accent}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="PROCESSES" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
            <TextBlock Text="{Binding ProcessesText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="with at least one socket" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="LOOPBACK" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
            <TextBlock Text="{Binding LoopbackText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="local-only endpoints" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="4">
            <TextBlock Text="THROUGHPUT" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
            <TextBlock Text="{Binding DownloadText}" Foreground="{DynamicResource Axiom.TextPrimary}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UploadText, StringFormat=Upload: {0}}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="System-wide throughput" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Text="{Binding BucketLabel}" FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="92" />
          </Grid>
          <controls:TrafficChartControl Height="150" UploadSeries="{Binding UploadSeries}" DownloadSeries="{Binding DownloadSeries}" />
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Grid.Column="0" Text="{Binding DownloadText, StringFormat=Down: {0}}" Foreground="{DynamicResource Axiom.Download}" FontSize="10" Margin="0,0,14,0" />
            <TextBlock Grid.Column="1" Text="{Binding UploadText, StringFormat=Up: {0}}" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" Margin="0,0,14,0" />
            <TextBlock Grid.Column="2" Text="{Binding RangeNote}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" MaxWidth="520" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}"
              BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Agent activity" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Text="Recorded sessions, API calls, tool calls and installs from the local Blackbox audit."
                         FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Local audit - secrets masked" FontSize="10"
                       Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding AgentActivity.ActivityFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedActivityFilter, Mode=TwoWay}" Width="130"
                      ToolTip.Tip="Filter by recorded sessions, API calls, tool calls, installs, file access or threats." />
            <ComboBox ItemsSource="{Binding AgentActivity.AgentFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedAgentFilter, Mode=TwoWay}" Width="130"
                      ToolTip.Tip="Filter by agent." />
            <ComboBox ItemsSource="{Binding AgentActivity.SeverityFilters}"
                      SelectedItem="{Binding AgentActivity.SelectedSeverityFilter, Mode=TwoWay}" Width="140"
                      ToolTip.Tip="Filter by severity." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding AgentActivity.ActivityStatusText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AgentActivity.ActivityBreakdownText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AgentActivity.SummaryText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AgentActivity.LastBlockedText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AgentActivity.ProtectedPathViolationsText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AgentActivity.UnresolvedText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Load more" Padding="9,4" FontSize="11" Margin="8,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding AgentActivity.LoadMoreActivityCommand}"
                    IsVisible="{Binding AgentActivity.CanLoadMoreActivity}"
                    ToolTip.Tip="Load the next 100 recorded events, up to the Blackbox dashboard limit." />
          </Grid>

          <Grid ColumnDefinitions="*,12,360">
            <StackPanel Grid.Column="0" Spacing="2">
              <Grid ColumnDefinitions="58,84,104,*,64,72" Margin="6,0,6,3">
                <TextBlock Grid.Column="0" Text="TIME" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBlock Grid.Column="1" Text="AGENT" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBlock Grid.Column="2" Text="EVENT" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBlock Grid.Column="3" Text="DETAILS" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBlock Grid.Column="4" Text="SECURITY" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
                <TextBlock Grid.Column="5" Text="SEVERITY" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
              </Grid>
              <ListBox Classes="data-list" ItemsSource="{Binding AgentActivity.Activity}"
                       SelectedItem="{Binding AgentActivity.SelectedActivity, Mode=TwoWay}" MaxHeight="190"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="58,84,104,*,64,72" Margin="0,2"
                          Tag="{Binding $parent[ListBox].DataContext}">
                      <Grid.Styles>
                        <Style Selector="TextBlock.security">
                          <Setter Property="Foreground" Value="{DynamicResource Axiom.Success}" />
                        </Style>
                        <Style Selector="TextBlock.security.threat">
                          <Setter Property="Foreground" Value="{DynamicResource Axiom.Critical}" />
                        </Style>
                      </Grid.Styles>
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy event"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyActivityEventCommand}" />
                          <MenuItem Header="Copy details"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyActivityDetailsCommand}" />
                          <MenuItem Header="Copy raw event JSON"
                                    Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyActivityJsonCommand}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextMuted}" />
                      <TextBlock Grid.Column="1" Text="{Binding Agent}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding EventLabel}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding ActionSummary}" FontSize="10"
                                 Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4" Text="{Binding SecurityOutcome}" FontSize="9"
                                 FontWeight="SemiBold" ToolTip.Tip="{Binding SecurityOutcomeDetail}"
                                 Classes="security" Classes.threat="{Binding IsSecurityThreat}" />
                      <TextBlock Grid.Column="5" Text="{Binding Severity}" FontSize="9"
                                 Foreground="{DynamicResource Axiom.TextMuted}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <Border Grid.Column="2" Background="{DynamicResource Axiom.SurfaceAlt}" BorderBrush="{DynamicResource Axiom.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="212">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy event" Command="{Binding AgentActivity.CopyActivityEventCommand}" />
                  <MenuItem Header="Copy details" Command="{Binding AgentActivity.CopyActivityDetailsCommand}" />
                  <MenuItem Header="Copy raw event JSON" Command="{Binding AgentActivity.CopyActivityJsonCommand}" />
                </ContextMenu>
              </Border.ContextMenu>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                  <StackPanel Spacing="6" IsVisible="{Binding AgentActivity.HasSelectedActivity}">
                    <TextBlock Text="Activity details" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Axiom.TextPrimary}" />
                    <TextBlock Text="{Binding AgentActivity.SelectedActivityTitle}" FontSize="10"
                               Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentActivity.SelectedActivityDetails}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="90,*" Margin="0,3,0,0">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="9"
                                       Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="9.5"
                                       Foreground="{DynamicResource Axiom.TextPrimary}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <Button Content="Copy event" Padding="8,3" FontSize="10" Margin="0,0,6,0"
                              Command="{Binding AgentActivity.CopyActivityEventCommand}" />
                      <Button Content="Copy details" Padding="8,3" FontSize="10"
                              Command="{Binding AgentActivity.CopyActivityDetailsCommand}" />
                    </WrapPanel>
                  </StackPanel>
                  <TextBlock Text="Select a recorded event to see its details."
                             FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                             IsVisible="{Binding !AgentActivity.HasSelectedActivity}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="1.6*,12,*">
        <Border Grid.Column="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="New connection events" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Grid.Column="1" Text="{Binding NewConnectionsText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" />
            </Grid>
            <ListBox Classes="data-list" ItemsSource="{Binding NewConnectionEvents}"
                     SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                     MaxHeight="190" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="70,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="9"
                               Foreground="{DynamicResource Axiom.TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10"
                               Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding NewConnectionEventsEmptyText}" FontSize="10"
                       Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                       IsVisible="{Binding !HasNewConnectionEvents}" />
            <TextBlock Text="{Binding SelectedEventDetails}" FontSize="10"
                       Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="Top applications" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Axiom.TextPrimary}" />
            <ItemsControl ItemsSource="{Binding TopApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Axiom.TextPrimary}"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Width="{Binding BarWidth}" Height="3" CornerRadius="1.5"
                              Background="{DynamicResource Axiom.Accent}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SocketsText}" FontSize="9"
                               Foreground="{DynamicResource Axiom.TextMuted}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Live sockets" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
          <ListBox Classes="data-list" ItemsSource="{Binding Connections}" Height="390" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="180,80,220,*" Margin="0,3"
                      Tag="{Binding $parent[ListBox].DataContext}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Copy row details"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <MenuItem Header="Copy executable path"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                      <MenuItem Header="Copy remote endpoint"
                                Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                                CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <TextBlock Grid.Column="0" Text="{Binding AppDisplayName}" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding ProtocolText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                  <TextBlock Grid.Column="2" Text="{Binding RemoteEndpoint}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
