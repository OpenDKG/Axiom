<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.ConnectionsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">
    <Border Grid.Row="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search app, path, PID, local or remote…" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding ProtocolFilter}" Width="96" />
        <CheckBox Grid.Column="2" Content="Only new" IsChecked="{Binding OnlyNew}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="3" Content="Loopback" IsChecked="{Binding OnlyLoopback}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding VisibleRowsText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11"
               TextWrapping="Wrap" Margin="2,8,0,8" />

    <Border Grid.Row="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="1.4*,60,60,1.1*,1.1*,40,80,70,1*" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="APPLICATION" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="1" Text="PID" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="2" Text="PROTO" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="3" Text="LOCAL" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="4" Text="REMOTE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="5" Text="DIR" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="6" Text="STATE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="7" Text="QUALITY" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="8" Text="RULE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
        </Grid>
        <ListBox Grid.Row="1" Classes="data-list" ItemsSource="{Binding VisibleConnections}"
                 SelectedItem="{Binding SelectedConnection}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.4*,60,60,1.1*,1.1*,40,80,70,1*" Margin="0,3"
                    Tag="{Binding $parent[ListBox].DataContext}">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy row details"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy executable path"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="Copy local endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyLocalCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy remote endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Grid.Column="0" Text="{Binding AppDisplayName}" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ProcessId}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="2" Text="{Binding ProtocolText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="3" Text="{Binding LocalEndpoint}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding RemoteEndpoint}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Text="{Binding DirectionText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="6" Text="{Binding State}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="7" Text="{Binding QualityText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="8" Text="{Binding RuleStatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="No socket matches these filters." Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
