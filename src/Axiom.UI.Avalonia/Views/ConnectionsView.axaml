<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.ConnectionsView">
  <Grid RowDefinitions="Auto,*" Margin="24,18,24,24">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,14">
      <TextBlock Text="Connections" FontSize="22" FontWeight="SemiBold" Foreground="#E6EDF3" />
      <TextBlock Text="{Binding StatusText}" Foreground="#9BA9B8" />
    </StackPanel>
    <Border Grid.Row="1" Background="#161B22" BorderBrush="#2E3A47" BorderThickness="1" CornerRadius="8" Padding="16">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="220,90,240,*" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="APPLICATION" Foreground="#8A98A8" FontSize="11" />
          <TextBlock Grid.Column="1" Text="PROTOCOL" Foreground="#8A98A8" FontSize="11" />
          <TextBlock Grid.Column="2" Text="REMOTE" Foreground="#8A98A8" FontSize="11" />
          <TextBlock Grid.Column="3" Text="STATE" Foreground="#8A98A8" FontSize="11" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="220,90,240,*" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding AppDisplayName}" Foreground="#E6EDF3" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ProtocolText}" Foreground="#9BA9B8" />
                <TextBlock Grid.Column="2" Text="{Binding RemoteEndpoint}" Foreground="#9BA9B8" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="#9BA9B8" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
