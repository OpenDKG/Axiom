<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.UI.Avalonia.Views.ConnectionsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">
    <Border Grid.Row="0" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search app, path, PID, local or remoteâ€¦" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding ProtocolFilter}" Width="96" />
        <CheckBox Grid.Column="2" Content="Only new" IsChecked="{Binding OnlyNew}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="3" Content="Loopback" IsChecked="{Binding OnlyLoopback}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="4" Content="Group by app" IsChecked="{Binding IsGroupedByApp}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{Binding VisibleRowsText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11"
               TextWrapping="Wrap" Margin="2,8,0,8" />

    <Border Grid.Row="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="Block outbound" Padding="10,4"
                  Command="{Binding BlockOutboundCommand}" CommandParameter="{Binding SelectedConnection}" />
          <Button Content="Block inbound" Padding="10,4"
                  Command="{Binding BlockInboundCommand}" CommandParameter="{Binding SelectedConnection}" />
          <Button Content="End task" Padding="10,4"
                  Command="{Binding EndTaskCommand}" CommandParameter="{Binding SelectedConnection}" />
          <Button Content="Copy path" Padding="10,4"
                  Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedConnection}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="1.4*,60,60,1.1*,1.1*,40,80,70,1*" Margin="0,0,0,8"
              IsVisible="{Binding !IsGroupedByApp}">
          <TextBlock Grid.Column="0" Text="APPLICATION" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="1" Text="PID" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="2" Text="PROTO" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="3" Text="LOCAL" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="4" Text="REMOTE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="5" Text="DIR" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="6" Text="STATE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="7" Text="QUALITY" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
          <TextBlock Grid.Column="8" Text="RULE" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="10" />
        </Grid>
        <ListBox Grid.Row="2" Classes="data-list" ItemsSource="{Binding VisibleConnections}"
                 SelectedItem="{Binding SelectedConnection}" Background="Transparent" BorderThickness="0"
                 IsVisible="{Binding !IsGroupedByApp}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.4*,60,60,1.1*,1.1*,40,80,70,1*" Margin="0,3"
                    Tag="{Binding $parent[ListBox].DataContext}">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy row details"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy executable path"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="Copy local endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyLocalCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy remote endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="Block outbound"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockOutboundCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Block inbound"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockInboundCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="End task"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTaskCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Grid.Column="0" Text="{Binding AppDisplayName}" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ProcessId}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="2" Text="{Binding ProtocolText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="3" Text="{Binding LocalEndpoint}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding RemoteEndpoint}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Text="{Binding DirectionText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="6" Text="{Binding State}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="7" Text="{Binding QualityText}" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <TextBlock Grid.Column="8" Text="{Binding RuleStatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="No socket matches these filters." Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsGroupedByApp}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1" Padding="4,4"
                        HorizontalAlignment="Stretch">
                  <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Foreground="{DynamicResource Axiom.TextPrimary}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Axiom.TextPrimary}" />
                          <TextBlock Text="{Binding PathText}" FontSize="9"
                                     Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
                          <TextBlock Text="{Binding CountText}" FontSize="9" HorizontalAlignment="Right"
                                     Foreground="{DynamicResource Axiom.TextSecondary}" />
                          <TextBlock Text="{Binding ProtocolText}" FontSize="9" HorizontalAlignment="Right"
                                     Foreground="{DynamicResource Axiom.TextMuted}" />
                        </StackPanel>
                      </Grid>
                    </Expander.Header>
                    <ListBox Classes="data-list" ItemsSource="{Binding Rows}" MaxHeight="240"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="60,60,1.2*,1.2*,40,80,70" Margin="0,2"
                                Tag="{Binding $parent[ListBox].DataContext}">
                            <Grid.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Copy row details"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <MenuItem Header="Copy executable path"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <Separator />
                                <MenuItem Header="Block outbound"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockOutboundCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <MenuItem Header="Block inbound"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockInboundCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <Separator />
                                <MenuItem Header="End task"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTaskCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Grid.Column="0" Text="{Binding ProcessId}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProtocolText}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="{Binding LocalEndpoint}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding RemoteEndpoint}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding DirectionText}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <TextBlock Grid.Column="5" Text="{Binding State}" FontSize="9" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <TextBlock Grid.Column="6" Text="{Binding QualityText}" FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
