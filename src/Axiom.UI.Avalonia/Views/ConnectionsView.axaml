<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Axiom.UI.Avalonia.Controls"
             x:Class="Axiom.UI.Avalonia.Views.ConnectionsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">
    <Border Grid.Row="0" Classes="card" Padding="14,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search application, path, PID or endpoint…" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding ProtocolFilter}" Width="100" />
        <CheckBox Grid.Column="2" Content="Only new" IsChecked="{Binding OnlyNew}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="3" Content="Loopback" IsChecked="{Binding OnlyLoopback}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="4" Content="Group by app" IsChecked="{Binding IsGroupedByApp}" Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
        <controls:AxiomSelectableTextBlock Grid.Column="5" Text="{Binding VisibleRowsText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <controls:AxiomSelectableTextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="11.5"
               TextWrapping="Wrap" Margin="2,10,0,10" />

    <Border Grid.Row="2" Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <Button Content="Block outbound" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding BlockOutboundCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Block inbound" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding BlockInboundCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="End process (PID)" Classes="danger" Padding="10,4" Margin="0,0,8,4"
                    ToolTip.Tip="End only the specific PID associated with this socket."
                    Command="{Binding EndTaskCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Copy row" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding CopyRowCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Copy path" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Copy local" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding CopyLocalCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Copy remote" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding CopyRemoteCommand}" CommandParameter="{Binding SelectedConnection}" />
            <Button Content="Copy status" Padding="10,4" Margin="0,0,8,4"
                    Command="{Binding CopyStatusCommand}" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"
                      IsVisible="{Binding IsGroupedByApp}">
            <controls:AxiomSelectableTextBlock Text="Sort" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}"
                                               VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding GroupSortOptions}" SelectedItem="{Binding GroupSort}" Width="132"
                      ToolTip.Tip="Sort applications by measured TCP traffic" />
            <Button Content="{Binding GroupSortDirectionText}" Command="{Binding ToggleGroupSortDirectionCommand}"
                    Padding="10,4" ToolTip.Tip="Switch between highest and lowest first" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="1.4*,62,62,1.15*,1.15*,44,86,76,1*" Margin="8,0,8,6"
              IsVisible="{Binding !IsGroupedByApp}">
          <controls:AxiomSelectableTextBlock Grid.Column="0" Text="APPLICATION" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="1" Text="PID" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="2" Text="PROTO" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="3" Text="LOCAL" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="4" Text="REMOTE" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="5" Text="DIR" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="6" Text="STATE" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="7" Text="QUALITY" Classes="table-header" />
          <controls:AxiomSelectableTextBlock Grid.Column="8" Text="RULE" Classes="table-header" />
        </Grid>
        <ListBox Grid.Row="2" Classes="data-list" ItemsSource="{Binding VisibleConnections}"
                 SelectedItem="{Binding SelectedConnection}" Background="Transparent" BorderThickness="0"
                 IsVisible="{Binding !IsGroupedByApp}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.4*,62,62,1.15*,1.15*,44,86,76,1*" Margin="0,2"
                    Background="Transparent"
                    ToolTip.Tip="{Binding RowTooltip}"
                    Tag="{Binding $parent[ListBox].DataContext}">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy row details"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy executable path"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="Copy local endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyLocalCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Copy remote endpoint"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="Block outbound"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockOutboundCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <MenuItem Header="Block inbound"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockInboundCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                    <Separator />
                    <MenuItem Header="End process (PID)"
                              Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTaskCommand}"
                              CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding AppDisplayName}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding ProcessId}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding ProtocolText}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding LocalEndpoint}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <controls:AxiomSelectableTextBlock Grid.Column="4" Text="{Binding RemoteEndpoint}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <controls:AxiomSelectableTextBlock Grid.Column="5" Text="{Binding DirectionText}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <controls:AxiomSelectableTextBlock Grid.Column="6" Text="{Binding State}" FontSize="11.5" Foreground="{DynamicResource Axiom.TextSecondary}" />
                <controls:AxiomSelectableTextBlock Grid.Column="7" Text="{Binding QualityText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
                <controls:AxiomSelectableTextBlock Grid.Column="8" Text="{Binding RuleStatusText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <controls:AxiomSelectableTextBlock Grid.Row="2" Text="No socket matches these filters." Foreground="{DynamicResource Axiom.TextMuted}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsGroupedByApp}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1" Padding="6,6"
                        HorizontalAlignment="Stretch">
                  <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            Foreground="{DynamicResource Axiom.TextPrimary}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <controls:AxiomSelectableTextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Axiom.TextPrimary}" />
                          <controls:AxiomSelectableTextBlock Text="{Binding PathText}" Classes="mono" FontSize="10.5"
                                     Foreground="{DynamicResource Axiom.TextMuted}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:AxiomSelectableTextBlock Text="{Binding CountText}" FontSize="11"
                                       Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <controls:AxiomSelectableTextBlock Text="{Binding ProtocolText}" FontSize="11"
                                       Foreground="{DynamicResource Axiom.TextMuted}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2" ToolTip.Tip="{Binding TrafficTooltip}">
                          <controls:AxiomSelectableTextBlock Text="{Binding TrafficText}" FontSize="12" FontWeight="SemiBold"
                                     HorizontalAlignment="Right" Foreground="{DynamicResource Axiom.Accent}" />
                          <controls:AxiomSelectableTextBlock Text="{Binding RateText}" IsVisible="{Binding HasRateText}" FontSize="10.5"
                                     HorizontalAlignment="Right" Foreground="{DynamicResource Axiom.TextSecondary}" />
                        </StackPanel>
                      </Grid>
                    </Expander.Header>
                    <ListBox Classes="data-list" ItemsSource="{Binding Rows}"
                             controls:DataListSelection.SharedSelectedItem="{Binding $parent[UserControl].DataContext.SelectedConnection, Mode=TwoWay}"
                             MaxHeight="240"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="62,62,1.2*,1.2*,44,86,76" Margin="0,2"
                                Background="Transparent"
                                ToolTip.Tip="{Binding RowTooltip}"
                                Tag="{Binding $parent[UserControl].DataContext}">
                            <Grid.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Copy row details"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRowCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <MenuItem Header="Copy executable path"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyPathCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <Separator />
                                <MenuItem Header="Copy local endpoint"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyLocalCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <MenuItem Header="Copy remote endpoint"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.CopyRemoteCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <Separator />
                                <MenuItem Header="Block outbound"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockOutboundCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <MenuItem Header="Block inbound"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.BlockInboundCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                                <Separator />
                                <MenuItem Header="End process (PID)"
                                          Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.EndTaskCommand}"
                                          CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}" />
                              </ContextMenu>
                            </Grid.ContextMenu>
                            <controls:AxiomSelectableTextBlock Grid.Column="0" Text="{Binding ProcessId}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <controls:AxiomSelectableTextBlock Grid.Column="1" Text="{Binding ProtocolText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <controls:AxiomSelectableTextBlock Grid.Column="2" Text="{Binding LocalEndpoint}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <controls:AxiomSelectableTextBlock Grid.Column="3" Text="{Binding RemoteEndpoint}" Classes="mono" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <controls:AxiomSelectableTextBlock Grid.Column="4" Text="{Binding DirectionText}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <controls:AxiomSelectableTextBlock Grid.Column="5" Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
                            <controls:AxiomSelectableTextBlock Grid.Column="6" Text="{Binding QualityText}" FontSize="11" Foreground="{DynamicResource Axiom.TextMuted}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
