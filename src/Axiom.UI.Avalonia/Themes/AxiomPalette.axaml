      <SolidColorBrush x:Key="Axiom.NavHover" Color="#BF171E2B" />
      <SolidColorBrush x:Key="Axiom.NavSelected" Color="#D9162B40" />
      <SolidColorBrush x:Key="Axiom.GridLine" Color="#1E2636" />
      <SolidColorBrush x:Key="Axiom.LogoBackground" Color="#090C14" />
