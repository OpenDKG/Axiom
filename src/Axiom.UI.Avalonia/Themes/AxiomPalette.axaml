      <SolidColorBrush x:Key="Axiom.GlassTint" Color="#E6FFFFFF" />
      <SolidColorBrush x:Key="Axiom.GlassHighlight" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="Axiom.GlassBorder" Color="#CBD5E1" />
