      <RadialGradientBrush x:Key="Axiom.AmbientGlow" Center="16%,4%" GradientOrigin="16%,4%"
                           RadiusX="0.60" RadiusY="0.52">
        <GradientStop Color="#3338BDF8" Offset="0" />
        <GradientStop Color="#0038BDF8" Offset="1" />
      </RadialGradientBrush>
      <LinearGradientBrush x:Key="Axiom.AmbientWash" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1438BDF8" Offset="0" />
        <GradientStop Color="#00090C12" Offset="0.5" />
        <GradientStop Color="#14818CF8" Offset="1" />
