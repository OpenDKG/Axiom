    <ResourceDictionary x:Key="{x:Static themes:AxiomThemeVariants.GlassDark}">
      <LinearGradientBrush x:Key="Axiom.Window" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0D1119" Offset="0" />
        <GradientStop Color="#07090E" Offset="1" />
