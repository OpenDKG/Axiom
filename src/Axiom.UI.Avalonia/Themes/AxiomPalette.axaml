<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:Axiom.UI.Avalonia">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Axiom.Window" Color="#0B0D11" />
      <SolidColorBrush x:Key="Axiom.Nav" Color="#080A0E" />
      <SolidColorBrush x:Key="Axiom.Surface" Color="#12151C" />
      <SolidColorBrush x:Key="Axiom.SurfaceAlt" Color="#181C25" />
      <SolidColorBrush x:Key="Axiom.Border" Color="#232936" />
      <SolidColorBrush x:Key="Axiom.BorderStrong" Color="#3B4458" />
      <SolidColorBrush x:Key="Axiom.TextPrimary" Color="#F3F5F8" />
      <SolidColorBrush x:Key="Axiom.TextSecondary" Color="#9EA7B8" />
      <SolidColorBrush x:Key="Axiom.TextMuted" Color="#6E7889" />
      <SolidColorBrush x:Key="Axiom.Accent" Color="#38BDF8" />
      <SolidColorBrush x:Key="Axiom.AccentSoft" Color="#0F293A" />
      <SolidColorBrush x:Key="Axiom.AccentStrong" Color="#60A5FA" />
      <SolidColorBrush x:Key="Axiom.AccentContrast" Color="#05131D" />
      <SolidColorBrush x:Key="Axiom.Upload" Color="#38BDF8" />
      <SolidColorBrush x:Key="Axiom.Download" Color="#818CF8" />
      <SolidColorBrush x:Key="Axiom.Success" Color="#34D399" />
      <SolidColorBrush x:Key="Axiom.Warning" Color="#FBBF24" />
      <SolidColorBrush x:Key="Axiom.Critical" Color="#F87171" />
      <SolidColorBrush x:Key="Axiom.NavHover" Color="#151A23" />
      <SolidColorBrush x:Key="Axiom.NavSelected" Color="#162536" />
      <SolidColorBrush x:Key="Axiom.GridLine" Color="#1B202B" />
      <SolidColorBrush x:Key="Axiom.LogoBackground" Color="#090B10" />
      <SolidColorBrush x:Key="Axiom.DangerBackground" Color="#991B1B" />
      <SolidColorBrush x:Key="Axiom.GlassTint" Color="#CC12151C" />
      <SolidColorBrush x:Key="Axiom.GlassHighlight" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="Axiom.GlassBorder" Color="#2B3344" />
      <SolidColorBrush x:Key="Axiom.CardBorder" Color="#232936" />
      <SolidColorBrush x:Key="Axiom.AmbientGlow" Color="#00000000" />
      <SolidColorBrush x:Key="Axiom.AmbientWash" Color="#00000000" />
