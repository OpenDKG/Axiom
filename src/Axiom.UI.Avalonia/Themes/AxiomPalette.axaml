      <SolidColorBrush x:Key="Axiom.SurfaceAlt" Color="#D91A212E" />
      <SolidColorBrush x:Key="Axiom.Border" Color="#293244" />
      <SolidColorBrush x:Key="Axiom.BorderStrong" Color="#475569" />
