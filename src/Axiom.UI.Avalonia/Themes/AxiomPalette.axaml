      <LinearGradientBrush x:Key="Axiom.Nav" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#B80B0E15" Offset="0" />
        <GradientStop Color="#A807090E" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="Axiom.Surface" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#E0141923" Offset="0" />
        <GradientStop Color="#D410141D" Offset="1" />
