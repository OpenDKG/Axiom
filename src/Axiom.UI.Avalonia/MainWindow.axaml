<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Axiom.UI.Avalonia"
        xmlns:views="using:Axiom.UI.Avalonia.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Axiom.UI.Avalonia.MainWindow"
        Title="Axiom — Free Open-Source Network &amp; AI Agent Security"
        Width="1460" Height="900" MinWidth="900" MinHeight="600"
        Background="{DynamicResource Axiom.Window}" Foreground="{DynamicResource Axiom.TextPrimary}"
        UseLayoutRounding="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Axiom.TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Axiom.SurfaceAlt}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Axiom.Border}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#9F1D14" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="local:OverviewPageViewModel">
      <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="local:ConnectionsPageViewModel">
      <views:ConnectionsView />
    </DataTemplate>
    <DataTemplate DataType="local:AppsPageViewModel">
      <views:AppsView />
    </DataTemplate>
    <DataTemplate DataType="local:EventsPageViewModel">
      <views:EventsView />
    </DataTemplate>
    <DataTemplate DataType="local:FirewallPageViewModel">
      <views:FirewallView />
    </DataTemplate>
    <DataTemplate DataType="local:PrivacyShieldPageViewModel">
      <views:PrivacyShieldView />
    </DataTemplate>
    <DataTemplate DataType="local:SecurityPageViewModel">
      <views:SecurityView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentsPageViewModel">
      <views:AgentsView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentStatsPageViewModel">
      <views:AgentStatsView />
    </DataTemplate>
    <DataTemplate DataType="local:AiAnalystPageViewModel">
      <views:AiAnalystView />
    </DataTemplate>
    <DataTemplate DataType="local:SupportPageViewModel">
      <views:SupportView />
    </DataTemplate>
    <DataTemplate DataType="local:SettingsPageViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="236,*" RowDefinitions="38,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Axiom.Nav}" BorderBrush="{DynamicResource Axiom.Border}"
            BorderThickness="0,0,0,1" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Margin="14,0,4,0">
        <StackPanel x:Name="TitleContent" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-icon.png" Width="20" Height="20" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="AXIOM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <TextBlock Text="Free Open-Source Network &amp; AI Agent Security" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextMuted}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
          <Button x:Name="AlertsButton" Classes="caption" Click="OnAlertsClicked" ToolTip.Tip="Notifications"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <Grid Width="46" Height="38">
              <TextBlock x:Name="BellGlyph" Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                         Foreground="{DynamicResource Axiom.TextPrimary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- Segoe MDL2 Assets exists only on Windows; other platforms show this vector bell. -->
              <PathIcon x:Name="BellIcon" IsVisible="False" Width="15" Height="15"
                        Foreground="{DynamicResource Axiom.TextPrimary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21H14Z" />
              <Border IsVisible="{Binding HasUnreadAlerts}" Background="#C42B1C" CornerRadius="7"
                      MinWidth="14" Height="14" Padding="3,0" Margin="0,5,7,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding UnreadAlertCount}" FontSize="8" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Classes="caption" Content="&#xE921;" ToolTip.Tip="Minimize"
                  chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                  Click="OnMinimizeClicked" />
          <Button x:Name="MaximizeButton" Classes="caption" Content="&#xE922;" ToolTip.Tip="Maximize"
                  chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                  Click="OnMaximizeClicked" />
          <Button x:Name="CloseButton" Classes="caption close" Content="&#xE8BB;" ToolTip.Tip="Close"
                  chrome:WindowDecorationProperties.ElementRole="CloseButton"
                  Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Popup x:Name="AlertsPopup"
           PlacementTarget="{Binding #AlertsButton}"
           Placement="BottomEdgeAlignedRight"
           IsLightDismissEnabled="True"
           HorizontalOffset="0" VerticalOffset="4">
      <Border Width="430" MaxHeight="470" Background="{DynamicResource Axiom.Surface}"
              BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1"
              CornerRadius="8" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="6,1"
                      IsVisible="{Binding HasUnreadAlerts}">
                <TextBlock Text="{Binding UnreadAlertCount}" FontSize="9"
                           Foreground="{DynamicResource Axiom.Accent}" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Mark all read" Command="{Binding MarkAllAlertsReadCommand}" Padding="8,3" FontSize="10" />
              <Button Content="Clear" Command="{Binding ClearAlertsCommand}" Padding="8,3" FontSize="10" />
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,8,0,0" MaxHeight="350" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="9"
                                   Foreground="{DynamicResource Axiom.TextMuted}" Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Message}" FontSize="10"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
                      <Button Content="{Binding ActionText}" Click="OnAlertItemClicked"
                              Padding="8,3" FontSize="10" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="No alerts yet." IsVisible="{Binding !HasAlerts}" Margin="0,10,0,0"
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="Kept locally for this run. Clicking an alert opens its page and highlights the event."
                     FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Popup>

    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Axiom.Nav}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="20,14,20,12" Spacing="8">
          <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-lockup.png" Height="54" Stretch="Uniform"
                 HorizontalAlignment="Left" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="LIVE · READ-ONLY" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource Axiom.TextMuted}" FontSize="11" />
        </StackPanel>

        <ListBox Grid.Row="1" Classes="nav-list" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5"
                        Background="{DynamicResource Axiom.Accent}" Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                           Foreground="{DynamicResource Axiom.TextPrimary}" Padding="0,4" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="16,0,16,10" Spacing="8">
          <Border Height="1" Background="{DynamicResource Axiom.Border}" />
          <Grid ColumnDefinitions="Auto,*">
            <Image Grid.Column="0" Source="avares://Axiom.UI.Avalonia/Assets/axiom-icon.png"
                   Width="40" Height="40" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Axiom" FontWeight="SemiBold" FontSize="13"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <TextBlock Text="{Binding VersionText}" FontSize="10"
                         Foreground="{DynamicResource Axiom.TextMuted}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Free Open-Source Network &amp; AI Agent Security" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="GitHub" Command="{Binding OpenGitHubCommand}" Padding="10,4" FontSize="11" />
            <Button Command="{Binding OpenSupportCommand}" Padding="9,4" FontSize="11">
              <TextBlock Text="♥ Donate" Foreground="{DynamicResource Axiom.Accent}" FontSize="12" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="64,*,30">
      <Border Grid.Row="0" Background="{DynamicResource Axiom.Window}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
        <Grid Margin="24,0,20,0" ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedPage.Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Axiom.TextPrimary}" />
            <TextBlock Text="{Binding SelectedPage.Subtitle}" FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ComboBox Width="150" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      ToolTip.Tip="Choose a theme." />
            <TextBlock Text="Local only · no telemetry" Foreground="{DynamicResource Axiom.TextMuted}"
                       FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />

      <Border Grid.Row="2" Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,1,0,0">
        <Grid Margin="24,0,20,0" ColumnDefinitions="*,Auto">
          <WrapPanel VerticalAlignment="Center" ItemHeight="13"
                     ClipToBounds="False">
            <TextBlock Text="{Binding StatusMonitoringText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusStorageText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusFirewallText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusSourceText}" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusModeText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="9" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Axiom.SurfaceAlt}" CornerRadius="4" Padding="7,2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Axiom.Warning}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusFirewallBadgeText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="9" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusIpcText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
