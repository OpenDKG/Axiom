<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Axiom.UI.Avalonia"
        xmlns:views="using:Axiom.UI.Avalonia.Views"
        xmlns:controls="using:Axiom.UI.Avalonia.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Axiom.UI.Avalonia.MainWindow"
        Title="Axiom — Free Open-Source Network &amp; AI Agent Security"
        Width="1460" Height="900" MinWidth="900" MinHeight="600"
        Background="Transparent" TransparencyBackgroundFallback="Transparent"
        Foreground="{DynamicResource Axiom.TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Inter, Noto Sans"
        UseLayoutRounding="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Axiom.TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Axiom.SurfaceAlt}" />
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Axiom.Border}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.caption.close:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#9F1D14" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.caption.close:pressed">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="local:MiniHomePageViewModel">
      <views:MiniHomeView />
    </DataTemplate>
    <DataTemplate DataType="local:SimpleHomePageViewModel">
      <views:SimpleHomeView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentDashboardPageViewModel">
      <views:AgentDashboardView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentHealthPageViewModel">
      <views:AgentHealthView />
    </DataTemplate>
    <DataTemplate DataType="local:OverviewPageViewModel">
      <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="local:PrivacyOverviewPageViewModel">
      <views:PrivacyOverviewView />
    </DataTemplate>
    <DataTemplate DataType="local:ConnectionsPageViewModel">
      <views:ConnectionsView />
    </DataTemplate>
    <DataTemplate DataType="local:AppsPageViewModel">
      <views:AppsView />
    </DataTemplate>
    <DataTemplate DataType="local:EventsPageViewModel">
      <views:EventsView />
    </DataTemplate>
    <DataTemplate DataType="local:FirewallPageViewModel">
      <views:FirewallView />
    </DataTemplate>
    <DataTemplate DataType="local:PrivacyShieldPageViewModel">
      <views:PrivacyShieldView />
    </DataTemplate>
    <DataTemplate DataType="local:SecurityPageViewModel">
      <views:SecurityView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentsPageViewModel">
      <views:AgentsView />
    </DataTemplate>
    <DataTemplate DataType="local:AgentStatsPageViewModel">
      <views:AgentStatsView />
    </DataTemplate>
    <DataTemplate DataType="local:AiAnalystPageViewModel">
      <views:AiAnalystView />
    </DataTemplate>
    <DataTemplate DataType="local:SupportPageViewModel">
      <views:SupportView />
    </DataTemplate>
    <DataTemplate DataType="local:SettingsPageViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="RootLayout" ColumnDefinitions="252,*" RowDefinitions="44,*"
        Classes.glass="{Binding IsGlassTheme}"
        Classes.glasslight="{Binding IsGlassLight}">
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Axiom.Window}" />
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Axiom.AmbientGlow}" />
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Axiom.AmbientWash}" />
    <Border Classes="glass-chrome" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Axiom.Nav}" BorderBrush="{DynamicResource Axiom.Border}"
            BorderThickness="0,0,0,1" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Margin="18,0,4,0">
        <StackPanel x:Name="TitleContent" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-icon.png" Width="22" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="AXIOM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Axiom.TextPrimary}" />
          <TextBlock Text="Free Open-Source Network &amp; AI Agent Security" FontSize="10.5"
                     IsVisible="{Binding !IsMiniMode}"
                     Foreground="{DynamicResource Axiom.TextMuted}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource Axiom.SurfaceAlt}"
                  BorderBrush="{DynamicResource Axiom.Border}"
                  BorderThickness="1" CornerRadius="6" Padding="2"
                  Margin="0,0,8,0" VerticalAlignment="Center"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="Switch between Mini (compact), Simple (everyday), and Advanced (full technical) views">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="MiniModeButton" Content="Mini"
                      Command="{Binding SwitchToMiniModeCommand}"
                      Classes.primary="{Binding IsMiniMode}"
                      Padding="8,3" FontSize="11" CornerRadius="4" BorderThickness="0" />
              <Button x:Name="SimpleModeButton" Content="Simple"
                      Command="{Binding SwitchToSimpleModeCommand}"
                      Classes.primary="{Binding IsSimpleMode}"
                      Padding="8,3" FontSize="11" CornerRadius="4" BorderThickness="0" />
              <Button x:Name="AdvancedModeButton" Content="Advanced"
                      Command="{Binding SwitchToAdvancedModeCommand}"
                      Classes.primary="{Binding IsAdvancedMode}"
                      Padding="8,3" FontSize="11" CornerRadius="4" BorderThickness="0" />
            </StackPanel>
          </Border>
          <Button x:Name="AlertsButton" Classes="caption" Click="OnAlertsClicked" ToolTip.Tip="Notifications"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <Grid Width="46" Height="44">
              <TextBlock x:Name="BellGlyph" Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                         Foreground="{DynamicResource Axiom.TextPrimary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- Segoe MDL2 Assets exists only on Windows; other platforms show this vector bell. -->
              <PathIcon x:Name="BellIcon" IsVisible="False" Width="15" Height="15"
                        Foreground="{DynamicResource Axiom.TextPrimary}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21H14Z" />
              <Border IsVisible="{Binding HasUnreadAlerts}" Background="#C42B1C" CornerRadius="7"
                      MinWidth="14" Height="14" Padding="3,0" Margin="0,5,7,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding UnreadAlertCount}" FontSize="8" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
          <Button x:Name="UpdateButton" Classes="caption" Click="OnUpdateClicked"
                  IsVisible="{Binding UpdateAvailable}"
                  ToolTip.Tip="{Binding UpdateTooltip}"
                  AutomationProperties.Name="Available update"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <Grid Width="46" Height="44">
              <TextBlock x:Name="UpdateGlyph" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                         Foreground="{DynamicResource Axiom.Accent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- Segoe MDL2 Assets exists only on Windows; other platforms show this vector arrow. -->
              <PathIcon x:Name="UpdateIcon" IsVisible="False" Width="14" Height="14"
                        Foreground="{DynamicResource Axiom.Accent}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" />
              <Border Background="{DynamicResource Axiom.Accent}" CornerRadius="4"
                      Width="8" Height="8" Margin="0,7,9,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Classes="caption" Content="&#xE921;" ToolTip.Tip="Minimize"
                  chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                  Click="OnMinimizeClicked" />
          <Button x:Name="MaximizeButton" Classes="caption" Content="&#xE922;" ToolTip.Tip="Maximize"
                  chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                  Click="OnMaximizeClicked" />
          <Button x:Name="CloseButton" Classes="caption close" Content="&#xE8BB;" ToolTip.Tip="Close"
                  chrome:WindowDecorationProperties.ElementRole="CloseButton"
                  Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Popup x:Name="UpdatePopup"
           PlacementTarget="{Binding #UpdateButton}"
           Placement="BottomEdgeAlignedRight"
           IsLightDismissEnabled="True"
           HorizontalOffset="0" VerticalOffset="4">
      <Border Classes="card" Background="{DynamicResource Axiom.PopupSurface}" Width="340" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Update available" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Axiom.TextPrimary}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="6,2">
              <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.Accent}" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding UpdateReleaseDateText, StringFormat=Released {0}}"
                     IsVisible="{Binding HasUpdateReleaseDate}"
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" />
          <TextBlock Text="{Binding UpdateSummaryText}"
                     IsVisible="{Binding HasUpdateSummary}"
                     FontSize="11" Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="Download" Classes="primary" Command="{Binding OpenUpdateCommand}"
                    Click="OnUpdateDownloadClicked" Padding="12,5" FontSize="11" />
            <Button Content="Dismiss" Command="{Binding DismissUpdateCommand}"
                    Click="OnUpdateDismissClicked" Padding="12,5" FontSize="11" />
          </StackPanel>
          <TextBlock Text="Notification only. Axiom never downloads or installs updates automatically."
                     FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="AlertsPopup"
           PlacementTarget="{Binding #AlertsButton}"
           Placement="BottomEdgeAlignedRight"
           IsLightDismissEnabled="True"
           HorizontalOffset="0" VerticalOffset="4">
      <Border Classes="card" Background="{DynamicResource Axiom.PopupSurface}" Width="430" MaxHeight="470" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Axiom.TextPrimary}" />
              <Border Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="4" Padding="6,1"
                      IsVisible="{Binding HasUnreadAlerts}">
                <TextBlock Text="{Binding UnreadAlertCount}" FontSize="9"
                           Foreground="{DynamicResource Axiom.Accent}" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Mark all read" Command="{Binding MarkAllAlertsReadCommand}" Padding="8,3" FontSize="10" />
              <Button Content="Clear" Command="{Binding ClearAlertsCommand}" Padding="8,3" FontSize="10" />
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,8,0,0" MaxHeight="350" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Axiom.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="9"
                                   Foreground="{DynamicResource Axiom.TextMuted}" Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Message}" FontSize="10"
                                 Foreground="{DynamicResource Axiom.TextSecondary}" TextWrapping="Wrap" />
                      <Button Content="{Binding ActionText}" Click="OnAlertItemClicked"
                              Padding="8,3" FontSize="10" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="No alerts yet." IsVisible="{Binding !HasAlerts}" Margin="0,10,0,0"
                     FontSize="10" Foreground="{DynamicResource Axiom.TextMuted}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="Kept locally for this run. Clicking an alert opens its page and highlights the event."
                     FontSize="9" Foreground="{DynamicResource Axiom.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Popup>

    <Border Classes="glass-chrome" Grid.Row="1" Grid.Column="0" IsVisible="{Binding !IsMiniMode}" Background="{DynamicResource Axiom.Nav}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="20,18,20,14" Spacing="9">
          <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-lockup.png" Height="56" Stretch="Uniform"
                 HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <Border Classes="glass-pill" Background="{DynamicResource Axiom.AccentSoft}" CornerRadius="6" Padding="8,3"
                  HorizontalAlignment="Center">
            <TextBlock Text="LOCAL-FIRST · NO TELEMETRY" Foreground="{DynamicResource Axiom.Accent}"
                       FontSize="9" FontWeight="SemiBold" />
          </Border>
        </StackPanel>

        <ListBox Grid.Row="1" Classes="nav-list" ItemsSource="{Binding NavigationPages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="10,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding GroupLabel}" IsVisible="{Binding HasGroupLabel}"
                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Axiom.TextMuted}"
                           Margin="10,8,0,3" />
                <Border Classes="nav-item">
                  <Grid ColumnDefinitions="3,10,*">
                    <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                            Background="{DynamicResource Axiom.Accent}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Axiom.TextPrimary}" />
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="16,0,16,10" Spacing="8">
          <Border Height="1" Background="{DynamicResource Axiom.Border}" />
          <Button Command="{Binding OpenWebsiteCommand}" Classes="ghost"
                  HorizontalAlignment="Center" Cursor="Hand"
                  ToolTip.Tip="Open opendkg.org/axiom"
                  AutomationProperties.Name="Open the Axiom website">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Image Source="avares://Axiom.UI.Avalonia/Assets/axiom-icon.png"
                     Width="40" Height="40" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Axiom" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource Axiom.TextPrimary}" />
                <TextBlock Text="{Binding VersionText}" FontSize="10"
                           Foreground="{DynamicResource Axiom.TextMuted}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <TextBlock Text="Free Open-Source Network &amp; AI Agent Security" FontSize="10"
                     Foreground="{DynamicResource Axiom.TextMuted}" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Button Content="GitHub" Command="{Binding OpenGitHubCommand}" Padding="9,4" FontSize="11" />
            <Button Command="{Binding OpenSupportCommand}" Padding="8,4" FontSize="11">
              <TextBlock Text="♥ Donate" Foreground="{DynamicResource Axiom.Accent}" FontSize="12" />
            </Button>
            <Button Content="Contact" Command="{Binding OpenContactCommand}" Padding="8,4" FontSize="11"
                    AutomationProperties.Name="Contact Axiom"
                    ToolTip.Tip="Email contact@opendkg.org" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Classes="glass-chrome" Grid.Row="0" IsVisible="{Binding !IsMiniMode}" MinHeight="74" Background="{DynamicResource Axiom.Header}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,0,0,1">
        <Grid Margin="24,8,20,8" ColumnDefinitions="*,0.95*,Auto" ColumnSpacing="14">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <controls:AxiomSelectableTextBlock x:Name="HeaderPageTitle" Text="{Binding SelectedPage.Title}" Classes="page-title" TextTrimming="CharacterEllipsis" />
            <controls:AxiomSelectableTextBlock x:Name="HeaderPageSubtitle" Text="{Binding SelectedPage.Subtitle}" Classes="page-subtitle" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center"
                MaxWidth="420" IsVisible="{Binding IsAdvancedMode}">
            <Border Grid.Column="0" Width="3" MinHeight="28" CornerRadius="1.5" Background="{DynamicResource Axiom.Accent}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <controls:AxiomSelectableTextBlock Text="SYSTEM STATUS" Classes="kpi-label" />
              <controls:AxiomSelectableTextBlock Text="{Binding Overview.StatusText}" FontSize="10.5"
                                                 Foreground="{DynamicResource Axiom.TextSecondary}"
                                                 TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ComboBox Width="156" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      ToolTip.Tip="Choose a theme. Axiom Glass is the new visual system." />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />

      <Border Classes="glass-chrome" Grid.Row="2" IsVisible="{Binding !IsMiniMode}" MinHeight="34" Background="{DynamicResource Axiom.StatusBar}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="0,1,0,0">
        <Grid Margin="28,0,22,0" ColumnDefinitions="*,Auto">
          <WrapPanel VerticalAlignment="Center" ItemHeight="13"
                     ClipToBounds="False">
            <controls:AxiomSelectableTextBlock Text="{Binding StatusMonitoringText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatusStorageText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" IsVisible="{Binding IsAdvancedMode}" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatusFirewallText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" Margin="0,0,16,0" />
            <controls:AxiomSelectableTextBlock Text="{Binding StatusSourceText}" Foreground="{DynamicResource Axiom.Accent}" FontSize="10" IsVisible="{Binding IsAdvancedMode}" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="4" Padding="7,2" IsVisible="{Binding IsAdvancedMode}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Axiom.Accent}" VerticalAlignment="Center" />
                <controls:AxiomSelectableTextBlock Text="{Binding StatusModeText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="9" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Axiom.Surface}" BorderBrush="{DynamicResource Axiom.Border}" BorderThickness="1" CornerRadius="4" Padding="7,2">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{Binding StatusFirewallBadgeBrush}" VerticalAlignment="Center" />
                <controls:AxiomSelectableTextBlock Text="{Binding StatusFirewallBadgeText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="9" />
              </StackPanel>
            </Border>
            <controls:AxiomSelectableTextBlock Text="{Binding StatusIpcText}" Foreground="{DynamicResource Axiom.TextSecondary}" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsAdvancedMode}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
