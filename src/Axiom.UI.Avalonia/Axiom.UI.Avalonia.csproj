<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Axiom.UI.Avalonia</RootNamespace>
    <AssemblyName>Axiom.UI.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
    <ProjectReference Include="..\Axiom.Presentation\Axiom.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Axiom.UI.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Legal text ships inside the assembly so an offline or single-file installation can show the
    license and notices without reading files next to the executable.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Axiom.Documents.LICENSE.txt" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="Axiom.Documents.NOTICE.txt" />
    <EmbeddedResource Include="..\..\AUTHORS.md" LogicalName="Axiom.Documents.AUTHORS.md" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="Axiom.Documents.THIRD_PARTY_NOTICES.md" />
  </ItemGroup>

</Project>
