<Window x:Class="Axiom.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axiom Setup"
        Width="640"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <Image Source="/Axiom.UI;component/Resources/axiom-lockup.png"
             Width="190" Height="63" Stretch="Uniform" HorizontalAlignment="Left"
             RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,12" />
      <TextBlock Text="Axiom Setup" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Install Axiom for this Windows user. Partial installation needs no administrator rights. Complete installation uses one Windows elevation prompt to register the local service."
                 Style="{StaticResource BodyMuted}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
    </StackPanel>

    <ScrollViewer x:Name="ContentScroll"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,16,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Warning}">
          <StackPanel>
            <TextBlock Text="Development build - use at your own risk"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Warning}" />
            <TextBlock Text="Axiom is under active development and may contain defects, incomplete features or regressions. Firewall changes can interrupt connectivity, DNS changes can break name resolution, and agent hooks can block tools or files. Do not rely on it as your only security control. Where possible, test firewall and DNS changes in a VM, keep backups and keep a recovery path."
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <CheckBox x:Name="AgreeCheck"
                      Style="{StaticResource AppCheckBox}"
                      Content="I understand these risks and accept that I use Axiom at my own risk."
                      IsChecked="False"
                      Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Install location" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="InstallDirText"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <CheckBox x:Name="ShortcutCheck"
                      Style="{StaticResource AppCheckBox}"
                      Content="Create a Start Menu shortcut"
                      IsChecked="True"
                      Margin="0,14,0,0" />
            <CheckBox x:Name="LaunchCheck"
                      Style="{StaticResource AppCheckBox}"
                      Content="Start Axiom after installation"
                      IsChecked="True"
                      Margin="0,8,0,0" />
            <TextBlock Text="Installation type" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
            <RadioButton x:Name="CompleteRadio" GroupName="InstallType" IsChecked="True" Margin="0,8,0,0"
                         Foreground="{DynamicResource Brush.TextPrimary}">
              <StackPanel>
                <TextBlock Text="Complete installation (recommended)" FontWeight="SemiBold" />
                <TextBlock Text="Installs Axiom and asks Windows once for administrator approval to register the local service. Every protection module is then on by default:"
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="•  Axiom Shield: firewall decisions with the safe 'ask' policy&#x0a;•  Privacy Shield: resolver on port 53, Strict profile, encrypted DoH (443), and all eight licence-labelled sources&#x0a;•  Notifications, tray icon, background-console hiding and start with Windows&#x0a;•  Blackbox, DKG and agent hooks for the supported coding agents"
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="The Axiom Windows service automatically points the active network adapter's DNS at 127.0.0.1 while keeping your previous DNS server behind it as a fallback. You can still switch or restore adapters manually anytime on the Privacy Shield page."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" FontStyle="Italic" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PartialRadio" GroupName="InstallType" Margin="0,10,0,0"
                         Foreground="{DynamicResource Brush.TextPrimary}">
              <StackPanel>
                <TextBlock Text="Partial installation" FontWeight="SemiBold" />
                <TextBlock Text="Installs only the desktop app, local history service and monitor. No administrator prompt, Windows service registration, firewall rules, DNS resolver, autostart, Blackbox, DKG or agent hooks. Every module stays opt-in and can be enabled later from Axiom."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </RadioButton>
            <TextBlock Text="Complete installation may write only:"
                       Style="{StaticResource Caption}"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0">
              <TextBlock Text="%USERPROFILE%\.config\opencode\plugins\axiom-blackbox.ts&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-guard-bridge.py&#x0a;%USERPROFILE%\.codex\hooks.json (axiom-codex-hook.py entry only)&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-codex-hook.py&#x0a;%USERPROFILE%\.claude\settings.json (axiom-claude-hook.py PreToolUse entry only)&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-claude-hook.py&#x0a;%USERPROFILE%\.cursor\hooks.json (axiom-cursor-hook.py preToolUse entry only)&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-cursor-hook.py&#x0a;%USERPROFILE%\.copilot\hooks\axiom.json&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-copilot-hook.py&#x0a;%USERPROFILE%\.gemini\settings.json (BeforeTool entry only)&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-gemini-hook.py&#x0a;%USERPROFILE%\.codeium\windsurf\hooks.json (three Cascade pre-hooks only)&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-windsurf-hook.py&#x0a;%USERPROFILE%\Documents\Cline\Hooks\PreToolUse.py&#x0a;%LOCALAPPDATA%\Axiom\modules\blackbox, dkg and dkg-home&#x0a;%USERPROFILE%\.local\bin\blackbox.cmd&#x0a;%USERPROFILE%\.hermes\config.yaml, .hermes\blackbox and .hermes\plugins\blackbox (Blackbox mode/plugin only)&#x0a;%LOCALAPPDATA%\hermes\config.yaml, plugins, blackbox, bin, installs, cache, logs, backups and image/audio caches (official installer)&#x0a;%LOCALAPPDATA%\Axiom\notifications.txt, tray-notifications.txt, hide-background-windows.txt, startup.json and install-profile.json&#x0a;HKCU\Software\Microsoft\Windows\CurrentVersion\Run: Axiom (start with Windows)&#x0a;%ProgramData%\Axiom\protection.json (Axiom Shield consent/decisions)&#x0a;%ProgramData%\Axiom\privacy-shield.json and privacy-shield-rules.json (Privacy Shield settings)&#x0a;Windows service: Axiom Service (LocalSystem)&#x0a;Scheduled task: Agent Blackbox DKG node"
                       Style="{StaticResource Caption}"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0" />
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="What is included" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Core: desktop application, local history service, system monitor, tray, four themes, Support page and the bundled community feed. Complete installation also registers the Windows service, enables Axiom Shield and the Privacy Shield resolver, turns on notifications and start with Windows, and runs the official Blackbox and DKG installers plus agent hooks. VirusTotal is optional and its API key is configured later on the Security page."
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Installation log" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="LogBox"
                     Margin="0,8,0,0"
                     MinHeight="100"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextWrapping="Wrap"
                     Background="{DynamicResource Brush.SurfaceAlt}"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     BorderBrush="{DynamicResource Brush.Border}"
                     Padding="8" />
          </DockPanel>
        </Border>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="InstallButton"
              Style="{StaticResource GhostButton}"
              Content="Install Axiom"
              MinWidth="150"
              Click="OnInstall"
              IsEnabled="False"
              Margin="0,0,8,0" />
      <Button x:Name="CloseButton"
              Style="{StaticResource GhostButton}"
              Content="Cancel"
              MinWidth="100"
              Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
