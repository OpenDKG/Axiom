<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Axiom.Setup</RootNamespace>
    <AssemblyName>Axiom.Setup</AssemblyName>
    <AssemblyTitle>Axiom Setup</AssemblyTitle>
    <ApplicationIcon>..\Axiom.UI\Resources\axiom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Axiom.Setup.Program</StartupObject>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
    <ProjectReference Include="..\Axiom.Presentation\Axiom.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for a single-file self-contained setup under central package management. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\msix\Assets\Square150x150Logo.png"
                      LogicalName="Axiom.Setup.Logo.png" />
  </ItemGroup>

  <!--
    Release publishing compresses the desktop/service payload and community feed into a single
    SmallestSize ZIP resource (AxiomPayloadZip). Normal developer builds have no embedded
    payload; the setup then falls back to payload files next to the setup executable.
  -->
  <ItemGroup Condition="'$(AxiomPayloadZip)' != ''">
    <EmbeddedResource Include="$(AxiomPayloadZip)"
                      LogicalName="Axiom.Setup.Payload.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(AxiomPayloadZip)' == '' and '$(AxiomPayloadDir)' != ''">
    <EmbeddedResource Include="$(AxiomPayloadDir)\Axiom.Desktop.exe"
                      LogicalName="Axiom.Setup.Payload.Axiom.Desktop.exe" />
    <EmbeddedResource Include="$(AxiomPayloadDir)\Axiom.Service.exe"
                      LogicalName="Axiom.Setup.Payload.Axiom.Service.exe" />
    <EmbeddedResource Include="$(AxiomPayloadDir)\community\feed.json"
                      LogicalName="Axiom.Setup.Payload.community.feed.json" />
  </ItemGroup>

</Project>
