<UserControl x:Class="Axiom.UI.Views.LiveConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Axiom.UI.ViewModels"
             PreviewKeyDown="OnPreviewKeyDown">

  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <Border Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="Search app, endpoint, path or PID" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox x:Name="SearchBox"
                   Width="286"
                   Style="{StaticResource FilterTextBox}"
                   AutomationProperties.Name="Search connections by app, endpoint, path or PID"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Protocol" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <ListBox Style="{StaticResource SegmentList}"
                   ItemsSource="{Binding ProtocolOptions}"
                   SelectedItem="{Binding ProtocolFilter}"
                   AutomationProperties.Name="Protocol filter" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,14,0">
          <TextBlock Text="Filters" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <StackPanel Orientation="Horizontal">
            <CheckBox Style="{StaticResource AppCheckBox}"
                      Content="New (first 60 s)"
                      Margin="0,0,14,0"
                      IsChecked="{Binding OnlyNew}" />
            <CheckBox Style="{StaticResource AppCheckBox}"
                      Content="Loopback only"
                      IsChecked="{Binding OnlyLoopback}"
                      Margin="0,0,14,0" />
            <CheckBox Style="{StaticResource AppCheckBox}"
                      Content="Group by application"
                      IsChecked="{Binding IsGroupedByApp}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Column="3"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,6"
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Text="Rows come from the local Windows socket tables; nothing leaves this machine." />

        <Button Grid.Column="4"
                Style="{StaticResource GhostButton}"
                Content="Reset filters"
                VerticalAlignment="Bottom"
                Command="{Binding ResetFiltersCommand}" />
      </Grid>
    </Border>

    <!-- Poll error -->
    <Border Grid.Row="1"
            Margin="0,10,0,0"
            Padding="12,9"
            CornerRadius="8"
            Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Critical}"
            BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ErrorText}"
                 Foreground="{DynamicResource Brush.Critical}"
                 FontSize="11.5"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Table -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12,16,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Observed sockets" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding StatusLine}"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Border Background="{DynamicResource Brush.AccentSoft}"
                      CornerRadius="4"
                      Padding="6,2"
                      Margin="0,0,10,0">
                <TextBlock Text="LIVE · READ-ONLY"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontSize="9"
                           FontWeight="Bold" />
              </Border>
              <TextBlock Text="{Binding VisibleRowsText}"
                         Style="{StaticResource Caption}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource Card}"
                Margin="0,0,0,8"
                Padding="10"
                Visibility="{Binding HasRelated, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding RelatedTitle}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" />
            <ItemsControl ItemsSource="{Binding RelatedConnections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionRow}">
                  <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1.2*" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AppDisplayName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding RemoteEndpoint}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource Caption}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid>
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGroupedByApp}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <DataGrid Style="{StaticResource TableDataGrid}"
                    ItemsSource="{Binding View}"
                    SelectedItem="{Binding SelectedConnection}"
                    AutomationProperties.Name="Observed connections"
                    Margin="0,0,0,6">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="APP" Width="1.15*"
                                  Binding="{Binding AppDisplayName}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PID"
                                  Width="56"
                                  Binding="{Binding ProcessId}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROTO"
                                  Width="56"
                                  Binding="{Binding ProtocolText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LOCAL" Width="1.05*"
                                  Binding="{Binding LocalEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="REMOTE" Width="1.15*"
                                  Binding="{Binding RemoteEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="COUNTRY" Width="80"
                                  Binding="{Binding CountryText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="STATE"
                                  Width="86"
                                  Binding="{Binding State}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="DIR" Width="44"
                                  Binding="{Binding DirectionText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="QUALITY"
                                  Width="68"
                                  Binding="{Binding QualityText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PATH" Width="1.3*"
                                  Binding="{Binding PathText}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="FIRST SEEN" Width="86"
                                  SortMemberPath="FirstObservedUtc"
                                  Binding="{Binding FirstSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="{DynamicResource Brush.Surface}"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
              <TextBlock Text="No sockets match these filters."
                         Style="{StaticResource EmptyStateTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource BodyMuted}"
                         TextAlignment="Center"
                         Margin="0,6,0,0"
                         Text="Reset the filters to see every observed socket. An empty table without filters means the capture returned nothing; the limitations below explain why that can happen." />
            </StackPanel>
          </Border>
          </Grid>

          <Grid Visibility="{Binding IsGroupedByApp, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
              <ItemsControl ItemsSource="{Binding AppGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ConnectionAppGroup}">
                    <Border BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="12,4">
                      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Stretch"
                                Foreground="{DynamicResource Brush.TextPrimary}">
                        <Expander.Header>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                              <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}"
                                         FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}" />
                          </Grid>
                        </Expander.Header>
                        <DataGrid Style="{StaticResource TableDataGrid}"
                                  ItemsSource="{Binding Connections}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MaxHeight="260"
                                  Margin="0,8,0,0"
                                  HeadersVisibility="Column"
                                  AutomationProperties.Name="Connections in application group">
                          <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                              <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                            </Style>
                          </DataGrid.RowStyle>
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Width="56" Binding="{Binding ProcessId}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="PROTO" Width="56" Binding="{Binding ProtocolText}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="LOCAL" Width="1.05*" Binding="{Binding LocalEndpoint}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="REMOTE" Width="1.15*" Binding="{Binding RemoteEndpoint}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="STATE" Width="86" Binding="{Binding State}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="DIR" Width="44" Binding="{Binding DirectionText}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="QUALITY" Width="68" Binding="{Binding QualityText}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="FIRST SEEN" Width="86" Binding="{Binding FirstSeenText}" ElementStyle="{StaticResource TableText}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Expander>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource Brush.Surface}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="No applications match these filters."
                           Style="{StaticResource EmptyStateTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource BodyMuted}"
                           TextAlignment="Center"
                           Margin="0,6,0,0"
                           Text="Reset the filters or switch back to the socket view." />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="2,8,0,0">
      <TextBlock Style="{StaticResource Caption}"
                 TextWrapping="Wrap"
                 Text="{Binding LimitationsText}" />
      <TextBlock Style="{StaticResource Caption}"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap"
                 Text="Country: unknown — no offline GeoIP database is loaded, so no flag or country is inferred from the remote IP." />
    </StackPanel>
  </Grid>
</UserControl>
