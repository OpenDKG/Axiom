<UserControl x:Class="Axiom.UI.Views.PrivacyShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Privacy Shield" Style="{StaticResource EmptyStateTitle}" />
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
              <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource StatusPillText}" />
            </Border>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Apply settings"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding IsSupported}"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource GhostButton}"
                    Content="Disable"
                    Command="{Binding DisableCommand}"
                    IsEnabled="{Binding IsSupported}"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource GhostButton}"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsSupported}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Resolver policy" Style="{StaticResource SectionTitle}" />
          <CheckBox Style="{StaticResource AppCheckBox}"
                    Content="Enable Privacy Shield resolver"
                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                    IsEnabled="{Binding IsSupported}"
                    Margin="0,12,0,0" />
          <TextBlock Text="Disabled by default. Enabling starts a loopback resolver only; it does not change adapter DNS."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Profile" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding IsSupported}"
                      Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Text="Categories" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,8,0,0" />
            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
              <CheckBox Style="{StaticResource AppCheckBox}" Content="Telemetry" IsChecked="{Binding Telemetry, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" Margin="0,0,16,6" />
              <CheckBox Style="{StaticResource AppCheckBox}" Content="Ads" IsChecked="{Binding Ads, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" Margin="0,0,16,6" />
              <CheckBox Style="{StaticResource AppCheckBox}" Content="Tracking" IsChecked="{Binding Tracking, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" Margin="0,0,16,6" />
              <CheckBox Style="{StaticResource AppCheckBox}" Content="Analytics" IsChecked="{Binding Analytics, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" Margin="0,0,16,6" />
              <CheckBox Style="{StaticResource AppCheckBox}" Content="Malware" IsChecked="{Binding Malware, Mode=TwoWay}" IsEnabled="{Binding IsSupported}" Margin="0,0,16,6" />
            </WrapPanel>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Loopback port" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource FilterTextBox}"
                     Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsSupported}"
                     AutomationProperties.Name="Privacy Shield loopback port" />
            <TextBlock Grid.Column="3" Text="53 for normal Windows DNS; another port is test-only." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Upstream DNS" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource FilterTextBox}"
                     Text="{Binding UpstreamText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsSupported}"
                     ToolTip="Optional IP or IP:port. Empty uses the current Windows DNS servers."
                     AutomationProperties.Name="Privacy Shield upstream DNS" />
          </Grid>
          <TextBlock Text="Empty upstream uses the current Windows DNS servers. Loopback upstreams are rejected."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="190,4,0,0" />
          <TextBlock Text="Suggested: 1.1.1.1 (Cloudflare), 9.9.9.9 (Quad9), 94.140.14.14 (AdGuard). Use an IP or IP:port; DoH/DoT are not supported. On a corporate or VPN network use that network's DNS."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="190,3,0,0" />
          <TextBlock Text="Changing this upstream alone does not route Windows DNS through Privacy Shield. System-wide filtering starts only after the adapter selected below points its DNS at 127.0.0.1."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="190,3,0,0" />
          <TextBlock Text="{Binding StarterRulesText}" Style="{StaticResource Caption}" Margin="190,4,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <Expander IsExpanded="False"
                  HorizontalContentAlignment="Stretch"
                  Foreground="{DynamicResource Brush.TextPrimary}">
          <Expander.Header>
            <StackPanel>
              <TextBlock Text="Custom rules" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Allowlist and custom blocklist overrides"
                         Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Margin="0,12,0,0">
          <TextBlock Text="One domain per line. Allow rules win over profile and custom block rules."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />

          <TextBlock Text="Allowlist domains" Style="{StaticResource Caption}" />
          <TextBox AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   Height="100"
                   Margin="0,5,0,0"
                   Background="{DynamicResource Brush.SurfaceAlt}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   BorderBrush="{DynamicResource Brush.Border}"
                   Padding="10,7"
                   Text="{Binding AllowedDomainsText, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsSupported}" />

          <TextBlock Text="Custom blocklist domains" Style="{StaticResource Caption}" Margin="0,12,0,0" />
          <TextBox AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   Height="130"
                   Margin="0,5,0,0"
                   Background="{DynamicResource Brush.SurfaceAlt}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   BorderBrush="{DynamicResource Brush.Border}"
                   Padding="10,7"
                   Text="{Binding BlockedDomainsText, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsSupported}" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Import local list..." Command="{Binding ImportBlocklistCommand}" IsEnabled="{Binding IsSupported}" Margin="0,0,8,0" />
            <Button Style="{StaticResource GhostButton}" Content="Clear form" Command="{Binding ClearDomainsCommand}" IsEnabled="{Binding IsSupported}" />
          </StackPanel>
          <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Expander>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Verified source catalog" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Only catalogued HTTPS sources are downloaded. Each update is parsed, bounded and atomically replaces the previous ruleset only when every selected source succeeds."
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,10" />
          <ItemsControl ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Style="{StaticResource AppCheckBox}"
                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                              IsEnabled="{Binding DataContext.IsSupported, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding License, StringFormat=License: {0}}" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="Save selection and update lists"
                    Command="{Binding UpdateSourcesCommand}"
                    IsEnabled="{Binding IsSupported}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Optional automatic adapter integration" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="This uses a separate UAC elevation prompt to save the current DNS values and point one adapter at the loopback resolver. It is never silent."
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Network adapter" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Adapters}"
                      SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding IsSupported}" />
          </Grid>
          <TextBlock Text="Select the adapter marked 'default route' — normally the one carrying your LAN gateway. Only that adapter is switched to 127.0.0.1; the upstream DNS above is what the resolver forwards to. Adapters not selected keep bypassing Privacy Shield."
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="160,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="Set adapter DNS (UAC)"
                    Command="{Binding EnableSystemDnsCommand}"
                    IsEnabled="{Binding IsSupported}"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource GhostButton}"
                    Content="Restore saved DNS (UAC)"
                    Command="{Binding RestoreSystemDnsCommand}"
                    IsEnabled="{Binding IsSupported}" />
          </StackPanel>
          <TextBlock Text="{Binding DnsHelperStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Local statistics" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding StatsText}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
          <TextBlock Text="Counts reset when the resolver restarts. Blocked-query history is stored locally (up to 1,000 entries) and can be cleared; allowed queries are never stored."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Top blocked domains" Style="{StaticResource Caption}" />
            <ItemsControl ItemsSource="{Binding TopBlocked}" Margin="0,5,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Domain}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Caption}" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Blocked history (last 1,000, local only)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Content="Clear blocked history"
                    Command="{Binding ClearBlockedHistoryCommand}"
                    Padding="8,3"
                    FontSize="11" />
          </Grid>
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
            <ItemsControl ItemsSource="{Binding BlockedHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Domain}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="{Binding BlockedUtc, StringFormat={}{0:MM-dd HH:mm:ss}}" Style="{StaticResource Caption}" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Manual system integration" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding ManualSetupText}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{Binding BypassText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Text="This module does not install a privileged helper, edit the hosts file, change firewall rules, intercept TLS or install certificates."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
