<Window x:Class="Axiom.UI.Views.CommunitySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community feed"
        Width="580"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Community feed" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Style="{StaticResource BodyMuted}"
               Margin="0,6,0,0"
               TextWrapping="Wrap"
               Text="HTTPS JSON feed with an entries array. Each entry needs a 64-character sha256; name, verdict, source and updatedUtc are optional. The feed is evidence, not a verdict." />

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="Feed URL (HTTPS)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
      <TextBox x:Name="UrlBox"
               Style="{StaticResource FilterTextBox}"
               AutomationProperties.Name="Community feed URL" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock Text="Bearer token (optional)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
      <PasswordBox x:Name="TokenBox"
                   Padding="10,7"
                   FontSize="12"
                   Background="{DynamicResource Brush.SurfaceAlt}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   BorderBrush="{DynamicResource Brush.Border}"
                   BorderThickness="1"
                   AutomationProperties.Name="Community feed token" />
    </StackPanel>

    <CheckBox x:Name="EnableCheck"
              Grid.Row="4"
              Style="{StaticResource AppCheckBox}"
              Margin="0,12,0,0"
              Content="Enable community feed" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
      <Button Style="{StaticResource GhostButton}" Content="Save" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
