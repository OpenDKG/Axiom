<Window x:Class="Axiom.UI.Views.AgentHookInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install agent hooks"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13">
  <StackPanel Margin="24">
    <TextBlock Text="Choose installation scope" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="Axiom provisions Axiom-managed hooks for detected harnesses at startup once per build. Use this dialog to repair them now or to keep the current files unchanged."
               Style="{StaticResource BodyMuted}"
               TextWrapping="Wrap"
               Margin="0,7,0,0" />

    <Border Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="Partial installation" FontWeight="SemiBold" />
        <TextBlock Text="Install no agent hooks now. Do not create, replace or delete OpenCode, OpenChamber, Codex, Claude Code, Cursor, Copilot, Gemini, Windsurf, Cline, ZCode or DeepSeek Harness hook files."
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="Complete installation" FontWeight="SemiBold" />
        <TextBlock Text="Install or repair Axiom guard hooks for detected OpenCode/OpenChamber, Codex, Claude Code, Cursor, GitHub Copilot CLI, Gemini CLI, Windsurf Cascade, Cline, ZCode and DeepSeek Harness. Existing Axiom-managed files are backed up first."
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Margin="0,3,0,0" />
        <TextBlock Text="Will write only: %USERPROFILE%\.config\opencode\plugins\axiom-blackbox.ts; %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-guard-bridge.py; %USERPROFILE%\.codex\hooks.json (axiom-codex-hook.py entry only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-codex-hook.py; %USERPROFILE%\.claude\settings.json (axiom-claude-hook.py PreToolUse entry only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-claude-hook.py; %USERPROFILE%\.cursor\hooks.json (axiom-cursor-hook.py preToolUse entry only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-cursor-hook.py; %USERPROFILE%\.copilot\hooks\axiom.json; %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-copilot-hook.py; %USERPROFILE%\.gemini\settings.json (BeforeTool entry only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-gemini-hook.py; %USERPROFILE%\.codeium\windsurf\hooks.json (pre_run_command, pre_write_code and pre_mcp_tool_use entries only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-windsurf-hook.py; %USERPROFILE%\Documents\Cline\Hooks\PreToolUse.py; %USERPROFILE%\.zcode\cli\config.json (Axiom user-hook entries only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-zcode-hook.py; %USERPROFILE%\.dsh\axiom-hooks.json; %USERPROFILE%\.dsh\cordis.patch.yml (Axiom bridge row only); %LOCALAPPDATA%\Axiom\modules\blackbox\agent-blackbox\axiom-deepseek-hook.py."
                   Style="{StaticResource Caption}"
                   FontFamily="Consolas"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,14,0,0">
      <TextBlock Text="MCP server definitions, selected models, favorites, sessions, projects, databases, storage junctions and user-authored hooks are preserved. Only Axiom-owned hook files and the marker-owned hook entry may change. Codex may ask you to approve its hook. An installed hook file does not prove runtime loading or blocking."
                 Style="{StaticResource Caption}"
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Partial installation"
              Style="{StaticResource GhostButton}"
              MinWidth="136"
              Click="OnPartial"
              Margin="0,0,8,0"
              ToolTip="Continue without creating or changing any agent hook files." />
      <Button Content="Complete installation"
              Style="{StaticResource GhostButton}"
              MinWidth="144"
              Click="OnComplete"
              Margin="0,0,8,0"
              ToolTip="Install or repair agent hooks after backing up existing Axiom-managed files." />
      <Button Content="Cancel"
              Style="{StaticResource GhostButton}"
              MinWidth="90"
              IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
