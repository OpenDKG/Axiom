<UserControl x:Class="Axiom.UI.Views.AiAnalystView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="AI Security Analyst" Style="{StaticResource EmptyStateTitle}" />
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
              <TextBlock Text="ANALYST" Style="{StaticResource StatusPillText}" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding AutomaticText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Provider settings" Style="{StaticResource SectionTitle}" />
          <CheckBox Style="{StaticResource AppCheckBox}"
                    Content="Enable AI analyst"
                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                    Margin="0,12,0,0" />
          <TextBlock Text="Disabled by default. Cloud requests leave this device only after you save settings and press Analyze." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Provider" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Endpoint" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FilterTextBox}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Full chat-completions URL, for example a provider API endpoint or a loopback local endpoint." />
            <TextBlock Grid.Row="2" Text="Model" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FilterTextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="3" Text="API key" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <PasswordBox x:Name="ApiKeyBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Padding="10,7"
                         Margin="0,0,0,8"
                         Background="{DynamicResource Brush.SurfaceAlt}"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         BorderBrush="{DynamicResource Brush.Border}"
                         PasswordChanged="ApiKey_Changed"
                         ToolTip="Leave blank to keep the existing DPAPI-protected key." />
            <TextBlock Grid.Row="4" Text="{Binding CredentialsText}" Style="{StaticResource Caption}" Grid.Column="1" TextWrapping="Wrap" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox Style="{StaticResource AppCheckBox}" Content="Redact local paths to file names" IsChecked="{Binding RedactPaths, Mode=TwoWay}" Margin="0,0,20,0" />
            <TextBlock Text="Max connections" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Style="{StaticResource FilterTextBox}" Width="54" Text="{Binding MaxConnections, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Max tokens" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox Style="{StaticResource FilterTextBox}" Width="64" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox Style="{StaticResource AppCheckBox}" Content="Automatic analysis of new destinations" IsChecked="{Binding AutomaticAnalysis, Mode=TwoWay}" Margin="0,0,20,0" />
            <TextBlock Text="Interval minutes" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Style="{StaticResource FilterTextBox}" Width="54" Text="{Binding AnalysisIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Max requests/hour" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox Style="{StaticResource FilterTextBox}" Width="54" Text="{Binding MaxRequestsPerHour, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <TextBlock Text="{Binding AutomaticText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Verifier model (optional)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Style="{StaticResource FilterTextBox}" Text="{Binding VerifierModel, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional second model using the same endpoint and key. Leave empty to skip verification." />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Save provider settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Analyze current activity" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding CanAnalyze}" />
          </StackPanel>
          <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Latest finding" Style="{StaticResource SectionTitle}" />
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Clear history" Command="{Binding ClearHistoryCommand}" />
          </Grid>
          <StackPanel DataContext="{Binding SelectedFinding}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
              <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
              <TextBlock Text="{Binding Confidence, StringFormat=Confidence: {0}}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
              <TextBlock Text="{Binding Model, StringFormat=Model: {0}}" Style="{StaticResource Caption}" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{Binding VerifierModel, StringFormat=Verifier: {0}}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
              <TextBlock Text="{Binding VerifierStatus, StringFormat=Verifier status: {0}}" Style="{StaticResource Caption}" />
            </WrapPanel>
            <TextBlock Text="{Binding VerifierSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="Observations" Style="{StaticResource Caption}" Margin="0,12,0,3" />
            <ItemsControl ItemsSource="{Binding Observations}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Evidence references" Style="{StaticResource Caption}" Margin="0,10,0,3" />
            <ItemsControl ItemsSource="{Binding EvidenceReferences}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Alternative explanations" Style="{StaticResource Caption}" Margin="0,10,0,3" />
            <ItemsControl ItemsSource="{Binding AlternativeExplanations}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Missing evidence" Style="{StaticResource Caption}" Margin="0,10,0,3" />
            <ItemsControl ItemsSource="{Binding MissingEvidence}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Suggested next steps (text only; never applied automatically)" Style="{StaticResource Caption}" Margin="0,10,0,3" />
            <ItemsControl ItemsSource="{Binding RecommendedActions}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Local analysis history" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8" />
          <ListBox ItemsSource="{Binding History}"
                   SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                   MaxHeight="260"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Caption}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} · {1:yyyy-MM-dd HH:mm}">
                        <Binding Path="Status" />
                        <Binding Path="AnalysisTimestampUtc" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}"
                 TextWrapping="Wrap"
                 Margin="2,12,0,0"
                 Text="The analyst is read-only. It cannot apply firewall rules, execute commands, read arbitrary files or modify agent configuration. A model warning is not proof of compromise." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
