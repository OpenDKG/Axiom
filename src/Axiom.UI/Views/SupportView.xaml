<UserControl x:Class="Axiom.UI.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Help &amp; support" FontWeight="SemiBold" FontSize="22"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
            <TextBlock Text="How to use Axiom, report a problem or support the project."
                       Style="{StaticResource BodyMuted}" Margin="0,7,0,0" />
            <TextBlock Text="Axiom is a local-first Windows network monitor and firewall policy manager. It never enables firewall writes, DNS changes or optional modules without an explicit user action."
                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1"
                  Style="{StaticResource StatusPill}"
                  Margin="14,0,0,0"
                  VerticalAlignment="Top">
            <TextBlock Text="OPEN SOURCE" Style="{StaticResource StatusPillText}" />
          </Border>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="How to use Axiom" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Start with visibility, then make one deliberate change at a time."
                     Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,5,0,10" />

          <ItemsControl ItemsSource="{Binding UsageSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="0,9">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Report a bug or suggest a fix" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Use GitHub Issues for bugs, false positives, missing rules, accessibility problems and feature suggestions. Include the Axiom version, Windows version, the exact steps, what you expected and what happened. Do not paste API keys, tokens, wallet secrets or personal file paths."
                     Style="{StaticResource BodyMuted}"
                     TextWrapping="Wrap"
                     Margin="0,7,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Open GitHub Issues"
                    Command="{Binding OpenGitHubIssuesCommand}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Open Axiom GitHub Issues" />
            <Button Style="{StaticResource GhostButton}"
                    Content="Open repository"
                    Command="{Binding OpenGitHubRepositoryCommand}"
                    AutomationProperties.Name="Open Axiom GitHub repository" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="Support development" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Axiom is free and open source. Donations are optional and never unlock firewall features, change security decisions or reduce protection."
                       Style="{StaticResource BodyMuted}"
                       TextWrapping="Wrap"
                       Margin="0,7,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource PrimaryButton}"
                  Content="Open donation options"
                  Click="OnOpenDonationsClicked"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Open Axiom donation options" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Safety notes" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Axiom is under active development and may contain defects. Firewall writes are read-only by default and require an explicit test-VM gate. DNS changes use a separate UAC helper and can break name resolution. Optional modules and agent hooks are third-party integrations; an installed hook is not proof of runtime blocking. Test changes in a VM where possible and keep a recovery path."
                     Style="{StaticResource BodyMuted}"
                     TextWrapping="Wrap"
                     Margin="0,7,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
