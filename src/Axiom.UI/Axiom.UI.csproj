<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Axiom.UI</RootNamespace>
    <AssemblyName>Axiom.UI</AssemblyName>
    <!-- Binding-only view model properties cannot be static; CA1822 is noise for MVVM. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <!--
    Dependency rule (handoff 4): the UI depends on Contracts only.
    It must never reference Infrastructure.Windows, Service or Persistence.
    The Desktop host is the executable composition root.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
    <InternalsVisibleTo Include="Axiom.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\\support-links.json" />
    <EmbeddedResource Include="Resources\\support-links.json"
                      LogicalName="Axiom.UI.Resources.support-links.json" />
    <Resource Include="Resources\\axiom-icon.png" />
    <Resource Include="Resources\\axiom.ico" />
    <Resource Include="Resources\\axiom-lockup.png" />
    <Resource Include="Resources\\origintrail-logo.png" />
    <Resource Include="Resources\\umanitek-logo.png" />
    <Resource Include="Resources\\blackbox-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
