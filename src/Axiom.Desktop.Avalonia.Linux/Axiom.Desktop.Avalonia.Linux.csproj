<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux desktop host (docs/LINUX_ARCHITECTURE.md §11). It references only the portable projects:
    the axiomd systemd daemon owns monitoring, firewall (nftables) and DNS (systemd-resolved); this
    process talks to it over /run/axiom/axiom.sock and installs it once through pkexec/polkit.
    Published with dotnet publish -r linux-x64 (self-contained); the daemon image lives in the
    axiomd/ subdirectory of the publish tree.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Axiom.Desktop.Avalonia.Linux</RootNamespace>
    <AssemblyName>Axiom</AssemblyName>
    <AssemblyTitle>Axiom</AssemblyTitle>
    <UseAppHost>true</UseAppHost>
    <ApplicationId>com.axiom.firewall</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
    <ProjectReference Include="..\Axiom.UI.Avalonia\Axiom.UI.Avalonia.csproj" />
    <ProjectReference Include="..\Axiom.Presentation\Axiom.Presentation.csproj" />
    <ProjectReference Include="..\Axiom.Persistence\Axiom.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Axiom.Desktop.Avalonia.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\community\feed.json"
             Link="community\feed.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\linux\com.axiom.firewall.policy"
             Link="packaging\com.axiom.firewall.policy"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\linux\com.axiom.firewall.desktop"
             Link="packaging\com.axiom.firewall.desktop"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keeps packages.lock.json identical for normal restore and self-contained publish. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Bundled daemon (docs/LINUX_PACKAGING.md §2). A Linux publish of the desktop always carries the
    axiomd publish tree at <PublishDir>/axiomd/, which is what LinuxDaemonLayout.BundledDaemonPath
    and the daemon's install-service command expect. Source: $(AxiomDaemonPublishDir) (default
    build/linux/axiomd, where scripts/linux/package.sh publishes the daemon first); when that
    directory has no axiomd yet, Axiom.Service is restored and published there for the same RID
    and configuration. -p:AxiomBundleDaemon=false skips the step (CI jobs that only need the window).
  -->
  <PropertyGroup>
    <AxiomBundleDaemon Condition="'$(AxiomBundleDaemon)' == ''">true</AxiomBundleDaemon>
    <AxiomDaemonProject>$(MSBuildThisFileDirectory)..\Axiom.Service\Axiom.Service.csproj</AxiomDaemonProject>
    <AxiomDaemonPublishDir Condition="'$(AxiomDaemonPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\linux\axiomd\</AxiomDaemonPublishDir>
  </PropertyGroup>

  <Target Name="PublishBundledDaemon"
          AfterTargets="Publish"
          Condition="'$(AxiomBundleDaemon)' == 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">
    <PropertyGroup>
      <_AxiomDaemonPublishDir>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(AxiomDaemonPublishDir)'))'))</_AxiomDaemonPublishDir>
      <_AxiomDaemonProperties>Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;TargetFramework=net10.0;PublishDir=$(_AxiomDaemonPublishDir);_IsPublishing=true</_AxiomDaemonProperties>
    </PropertyGroup>

    <Message Importance="high" Condition="!Exists('$(_AxiomDaemonPublishDir)axiomd')" Text="Publishing axiomd ($(RuntimeIdentifier)) into $(_AxiomDaemonPublishDir)" />
    <MSBuild Condition="!Exists('$(_AxiomDaemonPublishDir)axiomd')"
             Projects="$(AxiomDaemonProject)" Targets="Restore"
             Properties="$(_AxiomDaemonProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Condition="!Exists('$(_AxiomDaemonPublishDir)axiomd')"
             Projects="$(AxiomDaemonProject)" Targets="Publish"
             Properties="$(_AxiomDaemonProperties)" />

    <ItemGroup>
      <_AxiomDaemonFile Include="$(_AxiomDaemonPublishDir)**" />
    </ItemGroup>
    <Error Condition="!Exists('$(_AxiomDaemonPublishDir)axiomd')"
           Text="The daemon publish tree $(_AxiomDaemonPublishDir) has no axiomd; publish Axiom.Service first or pass -p:AxiomBundleDaemon=false." />
    <Copy SourceFiles="@(_AxiomDaemonFile)"
          DestinationFiles="@(_AxiomDaemonFile->'$(PublishDir)axiomd/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Bundled axiomd: @(_AxiomDaemonFile->Count()) files copied into $(PublishDir)axiomd/" />
  </Target>

</Project>
