<UserControl x:Class="LocalFirewall.UI.Views.LiveConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalFirewall.UI.ViewModels">

  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <Border Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="Search app, endpoint, path or PID" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox Width="286"
                   Style="{StaticResource FilterTextBox}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Protocol" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <ListBox Style="{StaticResource SegmentList}"
                   ItemsSource="{Binding ProtocolOptions}"
                   SelectedItem="{Binding ProtocolFilter}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,14,0">
          <TextBlock Text="Filters" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <StackPanel Orientation="Horizontal">
            <CheckBox Style="{StaticResource AppCheckBox}"
                      Content="New (first 60 s)"
                      Margin="0,0,14,0"
                      IsChecked="{Binding OnlyNew}" />
            <CheckBox Style="{StaticResource AppCheckBox}"
                      Content="Loopback only"
                      IsChecked="{Binding OnlyLoopback}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Column="3"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,6"
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Text="Rows come from the local Windows socket tables; nothing leaves this machine." />

        <Button Grid.Column="4"
                Style="{StaticResource GhostButton}"
                Content="Reset filters"
                VerticalAlignment="Bottom"
                Command="{Binding ResetFiltersCommand}" />
      </Grid>
    </Border>

    <!-- Poll error -->
    <Border Grid.Row="1"
            Margin="0,10,0,0"
            Padding="12,9"
            CornerRadius="8"
            Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Critical}"
            BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding ErrorText}"
                 Foreground="{DynamicResource Brush.Critical}"
                 FontSize="11.5"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Table -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12,16,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Observed sockets" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding StatusLine}"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Border Background="{DynamicResource Brush.AccentSoft}"
                      CornerRadius="4"
                      Padding="6,2"
                      Margin="0,0,10,0">
                <TextBlock Text="LIVE · READ-ONLY"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontSize="9"
                           FontWeight="Bold" />
              </Border>
              <TextBlock Text="{Binding VisibleRowsText}"
                         Style="{StaticResource Caption}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid>
          <DataGrid Style="{StaticResource TableDataGrid}"
                    ItemsSource="{Binding View}"
                    Margin="0,0,0,6">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="APP"
                                  Width="1.25*"
                                  Binding="{Binding AppDisplayName}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PID"
                                  Width="58"
                                  Binding="{Binding ProcessId}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROTO"
                                  Width="58"
                                  Binding="{Binding ProtocolText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LOCAL"
                                  Width="1.15*"
                                  Binding="{Binding LocalEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="REMOTE"
                                  Width="1.3*"
                                  Binding="{Binding RemoteEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="STATE"
                                  Width="92"
                                  Binding="{Binding State}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="DIR"
                                  Width="42"
                                  Binding="{Binding DirectionText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="QUALITY"
                                  Width="74"
                                  Binding="{Binding QualityText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PATH"
                                  Width="1.45*"
                                  Binding="{Binding PathText}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="FIRST SEEN"
                                  Width="78"
                                  SortMemberPath="FirstObservedUtc"
                                  Binding="{Binding FirstSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="{DynamicResource Brush.Surface}"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
              <TextBlock Text="No sockets match these filters."
                         Style="{StaticResource EmptyStateTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource BodyMuted}"
                         TextAlignment="Center"
                         Margin="0,6,0,0"
                         Text="Reset the filters to see every observed socket. An empty table without filters means the capture returned nothing; the limitations below explain why that can happen." />
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="3"
               Style="{StaticResource Caption}"
               Margin="2,8,0,0"
               TextWrapping="Wrap"
               Text="{Binding LimitationsText}" />
  </Grid>
</UserControl>
