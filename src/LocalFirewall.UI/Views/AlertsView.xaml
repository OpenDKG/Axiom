<UserControl x:Class="LocalFirewall.UI.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" MaxWidth="860" HorizontalAlignment="Left">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="38"
                    Height="38"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.AccentSoft}"
                    Margin="0,0,12,0">
              <TextBlock Text="&#xE7BA;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="16"
                         Foreground="{DynamicResource Brush.Accent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="No alert source is active" Style="{StaticResource EmptyStateTitle}" />
              <TextBlock Text="No collector runs, so no alert can be raised in this build."
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <TextBlock Style="{StaticResource BodyMuted}"
                     Margin="0,14,0,0"
                     Text="Blocked-connection evidence and first-seen application alerts need a collector plus WFP subscription or audited events. Both are FND-007, and neither is simulated here." />

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16" />

          <TextBlock Text="Planned in FND-007" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding PlannedCapabilities}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="5"
                           Height="5"
                           Fill="{DynamicResource Brush.Accent}"
                           VerticalAlignment="Top"
                           Margin="0,7,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyMuted}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
