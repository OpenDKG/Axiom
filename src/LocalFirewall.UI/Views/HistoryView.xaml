<UserControl x:Class="LocalFirewall.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <Border Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="Range" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <ListBox Style="{StaticResource SegmentList}"
                   ItemsSource="{Binding Ranges}"
                   SelectedItem="{Binding SelectedRange}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Search app, path, remote or PID" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox Width="300"
                   Style="{StaticResource FilterTextBox}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,6"
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Text="Times are stored in UTC and shown in local time. Byte counts are not stored yet (FND-004)." />

        <Button Grid.Column="3"
                Style="{StaticResource GhostButton}"
                Content="Refresh"
                VerticalAlignment="Bottom"
                Margin="0,0,8,0"
                Command="{Binding RefreshCommand}" />

        <Button Grid.Column="4"
                Style="{StaticResource PrimaryButton}"
                Content="Export CSV"
                VerticalAlignment="Bottom"
                IsEnabled="{Binding CanExport}"
                Command="{Binding ExportCsvCommand}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1"
               Text="{Binding StatusText}"
               Style="{StaticResource Caption}"
               Margin="2,10,0,0"
               TextWrapping="Wrap" />

    <!-- Table -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12,16,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Stored flows" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Upserted by the service every 2 s; retention 30 days"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Top">
              <TextBlock Text="SERVICE DB"
                         Foreground="{DynamicResource Brush.Accent}"
                         FontSize="9"
                         FontWeight="Bold" />
            </Border>
          </Grid>
        </Border>

        <Grid>
          <DataGrid Style="{StaticResource TableDataGrid}"
                    ItemsSource="{Binding Rows}"
                    Margin="0,0,0,6">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="APP"
                                  Width="1.3*"
                                  Binding="{Binding AppDisplayName}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PID"
                                  Width="60"
                                  Binding="{Binding ProcessId}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROTO"
                                  Width="58"
                                  Binding="{Binding Protocol}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LOCAL"
                                  Width="1.2*"
                                  Binding="{Binding LocalEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="REMOTE"
                                  Width="1.3*"
                                  Binding="{Binding RemoteEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="DIR"
                                  Width="44"
                                  Binding="{Binding DirectionText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="STATE"
                                  Width="90"
                                  Binding="{Binding State}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="QUALITY"
                                  Width="72"
                                  Binding="{Binding Quality}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="FIRST SEEN"
                                  Width="82"
                                  Binding="{Binding FirstSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LAST SEEN"
                                  Width="82"
                                  SortMemberPath="LastSeenUtc"
                                  Binding="{Binding LastSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="{DynamicResource Brush.Surface}"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
              <TextBlock Text="No stored flows for this window."
                         Style="{StaticResource EmptyStateTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource BodyMuted}"
                         TextAlignment="Center"
                         Margin="0,6,0,0"
                         Text="{Binding StatusText}" />
              <TextBlock Style="{StaticResource Caption}"
                         TextAlignment="Center"
                         Margin="0,8,0,0"
                         Text="History requires the service (start with --service). Observations are written every two seconds while the service runs." />
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="3"
               Style="{StaticResource Caption}"
               Margin="2,8,0,0"
               FontFamily="{StaticResource Font.Mono}"
               TextTrimming="CharacterEllipsis"
               Text="{Binding DatabaseText}" />
  </Grid>
</UserControl>
