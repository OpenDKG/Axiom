<UserControl x:Class="LocalFirewall.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LocalFirewall.UI.Controls"
             xmlns:vm="clr-namespace:LocalFirewall.UI.ViewModels">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24">

      <!-- What is real in this build -->
      <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="15"
                     Foreground="{DynamicResource Brush.Accent}"
                     VerticalAlignment="Top"
                     Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="Live inventory, read-only"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BodyMuted}"
                       Margin="0,3,0,0"
                       Text="Socket rows and process identities are read from this Windows host with IP Helper. Byte rates are not measured yet, so the throughput chart below is a generated demo series (FND-004). No firewall rule is read or changed." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- KPI row -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="ACTIVE SOCKETS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
              <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="TCP + UDP owner tables" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="PROCESSES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
              <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="with at least one socket" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="LOOPBACK" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
              <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding LoopbackText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="local-only endpoints" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="OWNED RULES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
              <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                <TextBlock Text="READ-ONLY" Style="{StaticResource LiveBadgeText}" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding OwnedRulesText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="firewall adapter is FND-006" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Throughput (demo) -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16,18,14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Throughput" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <Border Style="{StaticResource DemoBadge}" Margin="8,0,0,0">
                  <TextBlock Text="DEMO SERIES" Style="{StaticResource DemoBadgeText}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding BucketLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <ListBox Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Style="{StaticResource SegmentList}"
                     ItemsSource="{Binding Ranges}"
                     SelectedItem="{Binding SelectedRange}" />
          </Grid>

          <Border Margin="0,12,0,0"
                  Height="196"
                  Background="{DynamicResource Brush.SurfaceAlt}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,8,10,10">
            <controls:TrafficChart Upload="{Binding UploadSeries}"
                                    Download="{Binding DownloadSeries}"
                                    UploadBrush="{DynamicResource Brush.Upload}"
                                    DownloadBrush="{DynamicResource Brush.Download}"
                                    GridBrush="{DynamicResource Brush.GridLine}" />
          </Border>

          <DockPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center" />
              <TextBlock Text="Upload (demo)" Style="{StaticResource Caption}" Margin="6,0,16,0" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center" />
              <TextBlock Text="Download (demo)" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Caption}"
                       Text="{Binding RangeNote}" />
          </DockPanel>

          <TextBlock Style="{StaticResource Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="Byte counts are not available from the IP Helper owner tables. Real per-process upload/download arrives with ETW in FND-004 and will be labelled with its measurement source." />
        </StackPanel>
      </Border>

      <!-- Bottom row -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="Top executables by sockets"
                         Style="{StaticResource SectionTitle}"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Background="{DynamicResource Brush.AccentSoft}"
                      CornerRadius="4"
                      Padding="6,2">
                <TextBlock Text="LIVE"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontSize="9"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding TopApps}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppRow}">
                  <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                      <Border Width="{Binding BarWidth}"
                              Height="5"
                              CornerRadius="2.5"
                              Background="{DynamicResource Brush.Accent}"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SocketsText}"
                               Style="{StaticResource Caption}"
                               FontFamily="{StaticResource Font.Mono}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Capture state" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="6,0,0,8" TextTrimming="CharacterEllipsis" MaxWidth="140" />

              <TextBlock Grid.Row="1" Text="Last poll" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Text="Unowned (PID 0)" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnownedText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" Text="Byte measurement" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="not implemented" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="4" Text="Database" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="not connected" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="5" Text="Service install" Style="{StaticResource BodyMuted}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="not installed" Style="{StaticResource BodyMuted}" />
            </Grid>

            <TextBlock Style="{StaticResource Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="Counts are a point-in-time poll: connections shorter than one interval can be missed and are not reconstructed." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
