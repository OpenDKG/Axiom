<Window x:Class="Netpetra.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netpetra Setup"
        Width="640"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Netpetra Setup" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Install Netpetra for this Windows user. No administrator rights, Windows service registration or firewall change is used."
                 Style="{StaticResource BodyMuted}"
                 TextWrapping="Wrap"
                 Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Install location" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="InstallDirText"
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <CheckBox x:Name="ShortcutCheck"
                  Style="{StaticResource AppCheckBox}"
                  Content="Create a Start Menu shortcut"
                  IsChecked="True"
                  Margin="0,14,0,0" />
        <CheckBox x:Name="LaunchCheck"
                  Style="{StaticResource AppCheckBox}"
                  Content="Start Netpetra after installation"
                  IsChecked="True"
                  Margin="0,8,0,0" />
        <CheckBox x:Name="HooksCheck"
                  Style="{StaticResource AppCheckBox}"
                  Content="Complete installation: install agent hooks when Blackbox and a supported agent are present"
                  IsChecked="True"
                  Margin="0,14,0,0" />
        <TextBlock Text="Uncheck agent hooks for a Partial installation. No OpenCode, OpenChamber or Codex hook file will be created or changed. Existing Netpetra-managed files are backed up before replacement."
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="What is included" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Desktop application, local history service, system monitor, tray, four themes, Support page and the bundled community feed. VirusTotal is optional and its API key is configured later on the Security page."
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Margin="0,7,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Installation log" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="LogBox"
                 Margin="0,8,0,0"
                 MinHeight="150"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 Background="{DynamicResource Brush.SurfaceAlt}"
                 Foreground="{DynamicResource Brush.TextPrimary}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 Padding="8" />
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="InstallButton"
              Style="{StaticResource GhostButton}"
              Content="Install Netpetra"
              MinWidth="150"
              Click="OnInstall"
              Margin="0,0,8,0" />
      <Button x:Name="CloseButton"
              Style="{StaticResource GhostButton}"
              Content="Cancel"
              MinWidth="100"
              Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
