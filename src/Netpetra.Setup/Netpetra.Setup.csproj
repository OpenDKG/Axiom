<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Netpetra.Setup</RootNamespace>
    <AssemblyName>Netpetra.Setup</AssemblyName>
    <AssemblyTitle>Axiom Setup</AssemblyTitle>
    <ApplicationIcon>..\Netpetra.UI\Resources\axiom.ico</ApplicationIcon>
    <StartupObject>Netpetra.Setup.Program</StartupObject>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Netpetra.UI\Netpetra.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for a single-file self-contained setup under central package management. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Release publishing sets NetpetraPayloadDir to a staging directory containing the already
    published Desktop/Service executables and community feed. Normal developer builds have no
    embedded payload; the setup then falls back to payload files next to the setup executable.
  -->
  <ItemGroup Condition="'$(NetpetraPayloadDir)' != ''">
    <EmbeddedResource Include="$(NetpetraPayloadDir)\Netpetra.Desktop.exe"
                      LogicalName="Netpetra.Setup.Payload.Netpetra.Desktop.exe" />
    <EmbeddedResource Include="$(NetpetraPayloadDir)\Netpetra.Service.exe"
                      LogicalName="Netpetra.Setup.Payload.Netpetra.Service.exe" />
    <EmbeddedResource Include="$(NetpetraPayloadDir)\community\feed.json"
                      LogicalName="Netpetra.Setup.Payload.community.feed.json" />
  </ItemGroup>

</Project>
