<Window x:Class="Netrigil.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Netrigil.UI.ViewModels"
        Title="Netrigil — Open-Source Firewall &amp; Security Monitor"
        Height="900"
        Width="1460"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- ============================ Navigation rail ============================ -->
    <Border Grid.RowSpan="3"
            Grid.Column="0"
            Background="{DynamicResource Brush.NavBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="0,18,0,10">
        <StackPanel DockPanel.Dock="Top" Margin="20,0,20,18">
          <TextBlock Text="Netrigil" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Open-source firewall &amp; network monitor"
                     Style="{StaticResource Caption}"
                     Margin="0,3,0,0"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Border Style="{StaticResource LiveBadge}">
              <TextBlock Style="{StaticResource LiveBadgeText}" Text="LIVE · READ-ONLY" />
            </Border>
            <TextBlock Text="FND-005" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

          <TextBlock DockPanel.Dock="Bottom"
                   Margin="20,12,20,4"
                   Style="{StaticResource Caption}"
                   TextWrapping="Wrap"
                   Text="Read-only inventory. No service, no driver, no Windows Firewall change." />

        <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource NavItem}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================ Top bar ============================ -->
    <Border Grid.Row="0"
            Grid.Column="1"
            Background="{DynamicResource Brush.WindowBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedPage.Title}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedPage.Subtitle}"
                     Style="{StaticResource PageSubtitle}"
                     Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Read-only monitor" Style="{StaticResource StatusPillText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Firewall writes disabled" Style="{StaticResource StatusPillText}" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource GhostButton}"
                  Content="{Binding ThemeToggleLabel}"
                  Command="{Binding ToggleThemeCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ Page host ============================ -->
    <ContentControl Grid.Row="1"
                    Grid.Column="1"
                    Content="{Binding SelectedPage}"
                    Focusable="False" />

    <!-- ============================ Status bar ============================ -->
    <Border Grid.Row="2"
            Grid.Column="1"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0,20,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMonitoringText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusFirewallText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusStorageText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusDataSourceText}" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource Brush.DemoBadgeText}" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Style="{StaticResource Caption}"
                   Text="IPC: not connected" />
      </Grid>
    </Border>
  </Grid>
</Window>
