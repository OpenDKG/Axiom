<UserControl x:Class="Netrigil.UI.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" MaxWidth="880" HorizontalAlignment="Left">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="38"
                    Height="38"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.AccentSoft}"
                    Margin="0,0,12,0">
              <TextBlock Text="&#xE8A5;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="16"
                         Foreground="{DynamicResource Brush.Accent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource EmptyStateTitle}" />
              <TextBlock Text="Optional module · disabled by default"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="2"
                    Style="{StaticResource StatusPill}"
                    VerticalAlignment="Top">
              <TextBlock Text="COMING LATER" Style="{StaticResource StatusPillText}" />
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource BodyMuted}"
                     Margin="0,14,0,0"
                     Text="{Binding StatusText}" />

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16" />

          <TextBlock Text="Planned scope" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding PlannedCapabilities}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="5"
                           Height="5"
                           Fill="{DynamicResource Brush.Accent}"
                           VerticalAlignment="Top"
                           Margin="0,7,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyMuted}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="Choose folders"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    ToolTip="Disabled: file tracking is not part of this build." />
            <Button Style="{StaticResource GhostButton}"
                    Content="Open Downloads"
                    IsEnabled="False"
                    ToolTip="Disabled: file tracking is not part of this build." />
          </StackPanel>

          <TextBlock Style="{StaticResource Caption}"
                     Margin="0,14,0,0"
                     TextWrapping="Wrap"
                     Text="Nothing on this page is a scan result. No file is read, hashed or sent anywhere while the module is disabled." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
