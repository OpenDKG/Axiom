<UserControl x:Class="Netrigil.UI.Views.FirewallRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Netrigil.UI.ViewModels">

  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource NoticeCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Read-only Windows Firewall inventory"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextPrimary}" />
          <TextBlock Style="{StaticResource BodyMuted}"
                     Margin="0,3,0,0"
                     Text="Rules are read through the service with the documented INetFwPolicy2 COM objects. This build creates, changes and removes no rule." />
        </StackPanel>
        <Border Grid.Column="1"
                Style="{StaticResource StatusPill}"
                Background="Transparent"
                BorderBrush="{DynamicResource Brush.Warning}"
                VerticalAlignment="Top">
          <TextBlock Text="READ-ONLY" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource Brush.Warning}" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="CAPABILITY" Style="{StaticResource MetricLabel}" />
          <TextBlock Text="{Binding CapabilityStatusText}" Style="{StaticResource MetricValue}" />
          <TextBlock Text="{Binding CapabilityDetail}"
                     Style="{StaticResource Caption}"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="OWNED RULES" Style="{StaticResource MetricLabel}" />
          <TextBlock Text="{Binding OwnedRuleCountText}" Style="{StaticResource MetricValue}" />
          <TextBlock Text="Netrigil:: prefix only" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="WRITE PATH" Style="{StaticResource MetricLabel}" />
          <TextBlock Text="disabled" Style="{StaticResource MetricValue}" />
          <TextBlock Text="no rule can be created or removed" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource GhostButton}"
                Content="Recheck Windows policy"
                IsEnabled="{Binding CanRecheck}"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                ToolTip="Reads the capability and owned rules again. Does not change any rule." />
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12,16,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Owned rules" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Only rules named Netrigil::{id}::{OUT|IN} are listed."
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
              <TextBlock Text="LIVE READ" Style="{StaticResource StatusPillText}" />
            </Border>
          </Grid>
        </Border>

        <Grid>
          <DataGrid Style="{StaticResource TableDataGrid}"
                    ItemsSource="{Binding Rules}"
                    AutomationProperties.Name="Owned firewall rules"
                    Margin="0,0,0,6">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="RULE" Width="1.5*" Binding="{Binding OsRuleName}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="APPLICATION" Width="1.2*" Binding="{Binding Application}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="DIR" Width="44" Binding="{Binding DirectionText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="ACTION" Width="64" Binding="{Binding ActionText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROFILES" Width="1.4*" Binding="{Binding ProfilesText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROTO" Width="58" Binding="{Binding ProtocolText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PORTS" Width="80" Binding="{Binding PortsText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="ENABLED" Width="70" Binding="{Binding EnabledText}" ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="STATE" Width="80" Binding="{Binding StateText}" ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="{DynamicResource Brush.Surface}"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
              <TextBlock Text="No owned rules"
                         Style="{StaticResource EmptyStateTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource BodyMuted}"
                         TextAlignment="Center"
                         Margin="0,6,0,0"
                         Text="{Binding StatusText}" />
              <TextBlock Style="{StaticResource Caption}"
                         TextAlignment="Center"
                         Margin="0,8,0,0"
                         Text="An empty list means Netrigil owns no rule; it does not mean Windows Firewall is inactive." />
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="4"
               Style="{StaticResource Caption}"
               Margin="2,8,0,0"
               TextWrapping="Wrap"
               Text="Windows Firewall remains the enforcement authority. External rules and Group Policy can still block or allow traffic; this page reports only Netrigil-owned rules." />
  </Grid>
</UserControl>
