<UserControl x:Class="Netrigil.UI.Views.FirewallRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24">

      <Border Style="{StaticResource NoticeCard}">
        <DockPanel>
          <Border DockPanel.Dock="Right"
                  Style="{StaticResource StatusPill}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Warning}"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding CapabilityStatusText}"
                       Style="{StaticResource StatusPillText}"
                       Foreground="{DynamicResource Brush.Warning}" />
          </Border>
          <StackPanel Margin="0,0,14,0">
            <TextBlock Text="No Windows Firewall write path exists in this build"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
            <TextBlock Style="{StaticResource BodyMuted}"
                       Margin="0,3,0,0"
                       Text="{Binding CapabilityDetail}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="OWNED RULES" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="{Binding OwnedRuleCountText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="none known to this build" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="POLICY READ" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="n/a" Style="{StaticResource MetricValue}" />
            <TextBlock Text="INetFwPolicy2 arrives in FND-006" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="WRITE PATH" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="disabled" Style="{StaticResource MetricValue}" />
            <TextBlock Text="no rule can be created or removed" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
        <StackPanel>
          <Border Padding="16,12,16,10"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="0,0,0,1">
            <DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Text="Owned rule inventory" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Filtered by the Netrigil:: prefix in FND-006"
                             Style="{StaticResource Caption}"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource StatusPill}"
                        VerticalAlignment="Top">
                  <TextBlock Text="READ-ONLY" Style="{StaticResource StatusPillText}" />
                </Border>
              </Grid>
            </DockPanel>
          </Border>

          <Grid Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RULE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="APPLICATION" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="DIRECTION" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="ACTION" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="PROFILES" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="STATE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="VERIFIED" Style="{StaticResource Caption}" FontWeight="SemiBold" />
          </Grid>

          <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="16,8,16,0" />

          <StackPanel Margin="16,26,16,26" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock Text="0 owned rules"
                       Style="{StaticResource EmptyStateTitle}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource BodyMuted}"
                       Margin="0,6,0,0"
                       TextAlignment="Center"
                       Text="Windows Firewall is authoritative and this build does not touch it. An empty list here means “not queried”, not “nothing is blocked on this machine”." />
            <Button Style="{StaticResource GhostButton}"
                    Content="Recheck Windows policy"
                    IsEnabled="False"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    ToolTip="{Binding PolicyCheckNote}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Verification contract for FND-006" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding PlannedScopeNotes}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="5"
                           Height="5"
                           Fill="{DynamicResource Brush.Accent}"
                           VerticalAlignment="Top"
                           Margin="0,7,10,0" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyMuted}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
