<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light palette. Same keys as Dark.xaml; ThemeManager swaps the whole dictionary. -->
  <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F2F5F8" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F6F9FB" />
  <SolidColorBrush x:Key="Brush.Border" Color="#DCE3EA" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C3CED9" />

  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#101820" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#496070" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#74828F" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#0F766E" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#D9F0EC" />
  <SolidColorBrush x:Key="Brush.AccentContrast" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Brush.Upload" Color="#0F766E" />
  <SolidColorBrush x:Key="Brush.Download" Color="#2E5BFF" />

  <SolidColorBrush x:Key="Brush.Success" Color="#15803D" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#B45309" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#B91C1C" />

  <SolidColorBrush x:Key="Brush.NavBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.NavHover" Color="#F0F5F8" />
  <SolidColorBrush x:Key="Brush.NavSelected" Color="#E4F4F1" />

  <SolidColorBrush x:Key="Brush.GridLine" Color="#E6ECF1" />
  <SolidColorBrush x:Key="Brush.DemoBadgeBackground" Color="#FDF2DA" />
  <SolidColorBrush x:Key="Brush.DemoBadgeText" Color="#8A5A07" />

  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C2CCD6" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#9FAEBD" />

</ResourceDictionary>
