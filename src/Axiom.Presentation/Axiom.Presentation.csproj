<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Axiom.Presentation</RootNamespace>
    <AssemblyName>Axiom.Presentation</AssemblyName>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Contracts\Axiom.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for self-contained single-file publish under central package management. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Axiom.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\support-links.json" />
    <EmbeddedResource Include="Resources\support-links.json"
                      LogicalName="Axiom.Presentation.Resources.support-links.json" />
    <EmbeddedResource Include="Resources\dkg\package.json"
                      LogicalName="Axiom.Presentation.Resources.dkg.package.json" />
    <EmbeddedResource Include="Resources\dkg\package-lock.json"
                      LogicalName="Axiom.Presentation.Resources.dkg.package-lock.json" />
  </ItemGroup>

</Project>
