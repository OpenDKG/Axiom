<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Axiom.Desktop.Avalonia.Windows.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ListBox.data-list > ListBoxItem:selected">
      <Setter Property="Background" Value="#123236" />
      <Setter Property="Foreground" Value="#E6EDF3" />
    </Style>
    <Style Selector="ListBox.data-list > ListBoxItem:pointerover">
      <Setter Property="Background" Value="#1A2430" />
    </Style>
  </Application.Styles>
</Application>
