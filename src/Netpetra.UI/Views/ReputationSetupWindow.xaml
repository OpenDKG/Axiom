<Window x:Class="Netpetra.UI.Views.ReputationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VirusTotal reputation provider"
        Width="540"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBackground}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="VirusTotal hash lookup"
               FontSize="17"
               FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Style="{StaticResource BodyMuted}"
               Margin="0,6,0,0"
               TextWrapping="Wrap"
               Text="Opt-in only. Netpetra sends the SHA-256 hash, never the file, path or URL. The key is stored with Windows DPAPI for your user." />

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="API key" Style="{StaticResource Caption}" Margin="0,0,0,5" />
      <PasswordBox x:Name="ApiKeyBox"
                   Padding="10,7"
                   FontSize="12"
                   Background="{DynamicResource Brush.SurfaceAlt}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   BorderBrush="{DynamicResource Brush.Border}"
                   BorderThickness="1"
                   AutomationProperties.Name="VirusTotal API key" />
    </StackPanel>

    <CheckBox x:Name="EnableCheck"
              Grid.Row="3"
              Style="{StaticResource AppCheckBox}"
              Margin="0,14,0,0"
              Content="Enable hash-only lookups" />

    <TextBlock Grid.Row="4"
               Style="{StaticResource Caption}"
               Margin="0,14,0,0"
               TextWrapping="Wrap"
               Text="A VirusTotal result is one source with a timestamp, not a verdict. Rate limits and provider terms apply. Leave the key empty to keep the provider disabled." />

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button Style="{StaticResource GhostButton}"
              Content="Cancel"
              Click="Cancel_Click"
              Margin="0,0,8,0" />
      <Button Style="{StaticResource GhostButton}"
              Content="Save"
              Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
