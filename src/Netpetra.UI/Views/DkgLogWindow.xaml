<Window x:Class="Netpetra.UI.Views.DkgLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DKG diagnostic log"
        Width="820"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="DKG diagnostic log" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Bounded, redacted, read-only tail. Tokens and obvious secrets are masked."
                 Style="{StaticResource Caption}"
                 Margin="0,4,0,0" />
    </StackPanel>

    <TextBox x:Name="LogText"
             Grid.Row="1"
             Margin="0,12,0,12"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             FontFamily="{StaticResource Font.Mono}"
             FontSize="11"
             Background="{DynamicResource Brush.SurfaceAlt}"
             BorderBrush="{DynamicResource Brush.Border}" />

    <Button Grid.Row="2"
            Style="{StaticResource GhostButton}"
            Content="Close"
            HorizontalAlignment="Right"
            Click="Close_Click" />
  </Grid>
</Window>
