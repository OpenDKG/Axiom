<Window x:Class="Netpetra.UI.Views.DkgLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DKG diagnostic log"
        Icon="/Netpetra.UI;component/Resources/axiom.ico"
        Width="820"
        Height="520"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13"
        ShowInTaskbar="False">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Brush.NavBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
            MouseMove="OnTitleBarMouseMove"
            MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Image Source="/Netpetra.UI;component/Resources/axiom-icon.png"
                 Width="20" Height="20" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="DKG diagnostic log" FontWeight="SemiBold" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Style="{StaticResource GhostButton}" Width="44" Height="32" Padding="0"
                  Content="—" ToolTip="Minimize" AutomationProperties.Name="Minimize DKG diagnostic log"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
          <Button x:Name="MaximizeButton" Style="{StaticResource GhostButton}" Width="44" Height="32" Padding="0"
                  Content="□" ToolTip="Maximize" AutomationProperties.Name="Maximize DKG diagnostic log"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" />
          <Button Style="{StaticResource GhostButton}" Width="44" Height="32" Padding="0"
                  Content="×" ToolTip="Close" AutomationProperties.Name="Close DKG diagnostic log"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="DKG diagnostic log" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Bounded, redacted, read-only tail. Tokens and obvious secrets are masked."
                   Style="{StaticResource Caption}"
                   Margin="0,4,0,0" />
      </StackPanel>

      <TextBox x:Name="LogText"
               Grid.Row="1"
               Margin="0,12,0,12"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="11"
               Foreground="{DynamicResource Brush.TextPrimary}"
               CaretBrush="{DynamicResource Brush.TextPrimary}"
               SelectionBrush="{DynamicResource Brush.AccentSoft}"
               Background="{DynamicResource Brush.SurfaceAlt}"
               BorderBrush="{DynamicResource Brush.Border}" />

      <Button Grid.Row="2"
              Style="{StaticResource GhostButton}"
              Content="Close"
              HorizontalAlignment="Right"
              Click="Close_Click" />
    </Grid>
  </Grid>
</Window>
