<UserControl x:Class="Netpetra.UI.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Netpetra.UI.ViewModels">

  <Grid Margin="24,18,24,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.55*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- App list -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,14,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4,8,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Observed executables" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding SummaryText}"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Top">
              <TextBlock Text="{Binding ModeBadgeText}"
                         Foreground="{DynamicResource Brush.Accent}"
                         FontSize="9"
                         FontWeight="Bold" />
            </Border>
          </Grid>
        </Border>

        <ListBox ItemsSource="{Binding View}"
                 SelectedItem="{Binding SelectedApp}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
              <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="Block outbound"
                              Command="{Binding PlacementTarget.Tag.BlockOutboundAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Block inbound"
                              Command="{Binding PlacementTarget.Tag.BlockInboundAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="End task"
                              Command="{Binding PlacementTarget.Tag.EndTaskAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Copy executable path"
                              Command="{Binding PlacementTarget.Tag.CopyPathAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AppRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.AccentSoft}"
                        Margin="0,0,10,0">
                  <TextBlock Text="{Binding Initial}"
                             FontSize="13"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PathText}"
                             Style="{StaticResource Caption}"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="420"
                             HorizontalAlignment="Left" />
                  <Border Width="{Binding BarWidth}"
                          Height="3"
                          CornerRadius="1.5"
                          Background="{DynamicResource Brush.Accent}"
                          HorizontalAlignment="Left"
                          Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SocketsText}"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding ProtocolText}"
                             Style="{StaticResource Caption}"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <Border Grid.Column="1" Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedApp.Name}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Top">
              <TextBlock Text="OBSERVED"
                         Foreground="{DynamicResource Brush.Accent}"
                         FontSize="9"
                         FontWeight="Bold" />
            </Border>
          </Grid>

          <TextBlock Text="{Binding SelectedApp.PathText}"
                     Style="{StaticResource Caption}"
                     FontFamily="{StaticResource Font.Mono}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Sockets" Style="{StaticResource Caption}" Margin="0,0,14,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedApp.SocketsText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Text="Protocols" Style="{StaticResource Caption}" Margin="0,0,14,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedApp.ProtocolText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Text="States" Style="{StaticResource Caption}" Margin="0,0,14,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedApp.StatesText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="3" Text="First seen" Style="{StaticResource Caption}" Margin="0,0,14,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedApp.FirstSeenText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="4" Text="Rule" Style="{StaticResource Caption}" Margin="0,0,14,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedApp.RuleText}" Style="{StaticResource BodyMuted}" />
          </Grid>

          <Expander Header="Advanced scope (protocol, ports, addresses, profiles)"
                    Margin="0,14,0,0"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    IsExpanded="False">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="Protocol" Style="{StaticResource Caption}" />
              <ListBox Style="{StaticResource SegmentList}"
                       ItemsSource="{Binding ProtocolOptions}"
                       SelectedItem="{Binding SelectedProtocolText}"
                       Margin="0,4,0,0"
                       AutomationProperties.Name="Rule protocol" />

              <TextBlock Text="Remote ports (TCP/UDP only; e.g. 443,8000-8100)"
                         Style="{StaticResource Caption}"
                         Margin="0,10,0,0" />
              <TextBox Style="{StaticResource FilterTextBox}"
                       Margin="0,4,0,0"
                       Text="{Binding RemotePortsText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Remote ports" />

              <TextBlock Text="Remote addresses (IPv4/IPv6 or CIDR; comma-separated)"
                         Style="{StaticResource Caption}"
                         Margin="0,10,0,0" />
              <TextBox Style="{StaticResource FilterTextBox}"
                       Margin="0,4,0,0"
                       Text="{Binding RemoteAddressesText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Remote addresses" />

              <TextBlock Text="Profiles" Style="{StaticResource Caption}" Margin="0,10,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Style="{StaticResource AppCheckBox}" Content="Domain" IsChecked="{Binding BlockDomain}" Margin="0,0,14,0" />
                <CheckBox Style="{StaticResource AppCheckBox}" Content="Private" IsChecked="{Binding BlockPrivate}" Margin="0,0,14,0" />
                <CheckBox Style="{StaticResource AppCheckBox}" Content="Public" IsChecked="{Binding BlockPublic}" />
              </StackPanel>

              <TextBlock Text="Scope applies to the next block action."
                         Style="{StaticResource Caption}"
                         Margin="0,8,0,0" />
            </StackPanel>
          </Expander>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="Block outbound"
                    IsEnabled="{Binding CanWrite}"
                    Command="{Binding BlockOutboundCommand}"
                    Margin="0,0,8,0"
                    ToolTip="Creates an owned Windows Firewall block rule. Requires the explicit write gate on an isolated test VM." />
            <Button Style="{StaticResource GhostButton}"
                    Content="Block inbound"
                    IsEnabled="{Binding CanWrite}"
                    Command="{Binding BlockInboundCommand}"
                    ToolTip="Creates an owned Windows Firewall block rule. Requires the explicit write gate on an isolated test VM." />
          </StackPanel>

          <TextBlock Text="{Binding WriteStatusText}"
                     Style="{StaticResource Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap" />

          <TextBlock Style="{StaticResource Caption}"
                     Margin="0,14,0,0"
                     TextWrapping="Wrap"
                     Text="Identity is the resolved executable path plus PID. Signer and hash verification are not implemented yet; a protected process can appear with 'path not readable' and partial quality." />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
