<Window x:Class="Netpetra.UI.Views.BlackboxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Blackbox"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13"
        ShowInTaskbar="False">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Blackbox configuration" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Loaded from the local Blackbox dashboard. Only the fields below are changed."
                 Style="{StaticResource Caption}"
                 Margin="0,4,0,0" />
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource Caption}"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Text="Loading settings…" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Protection" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Protection mode" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <ComboBox x:Name="ModeBox" Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Block severity" Style="{StaticResource BodyMuted}" />
              <ComboBox x:Name="BlockSeverityBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
            </Grid>

            <StackPanel Margin="0,12,0,0">
              <CheckBox x:Name="DiscoverCheck" Content="Discovery and OSV lookups" Style="{StaticResource AppCheckBox}" />
              <CheckBox x:Name="OsvCheck" Content="Use OSV.dev for dependency lookups" Style="{StaticResource AppCheckBox}" Margin="0,6,0,0" />
              <CheckBox x:Name="ReportCheck" Content="Share signed, redacted threat statements with the community" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0" />
              <TextBlock Text="Threat sharing is off unless you explicitly enable it here. It never sends prompts, commands, paths or credentials."
                         Style="{StaticResource Caption}"
                         Margin="24,4,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Detection categories" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Disable a detector or raise its minimum severity. Secret exposure and malicious indicators remain managed by the Blackbox dashboard."
                       Style="{StaticResource Caption}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <CheckBox x:Name="InjectionCheck" Grid.Row="0" Grid.Column="0" Content="Prompt injection" Style="{StaticResource AppCheckBox}" Margin="0,4" />
              <ComboBox x:Name="InjectionSeverity" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4" />

              <CheckBox x:Name="EscalationCheck" Grid.Row="1" Grid.Column="0" Content="Dangerous commands" Style="{StaticResource AppCheckBox}" Margin="0,4" />
              <ComboBox x:Name="EscalationSeverity" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4" />

              <CheckBox x:Name="DependencyCheck" Grid.Row="2" Grid.Column="0" Content="Vulnerable dependencies" Style="{StaticResource AppCheckBox}" Margin="0,4" />
              <ComboBox x:Name="DependencySeverity" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4" />

              <CheckBox x:Name="FileAccessCheck" Grid.Row="3" Grid.Column="0" Content="Sensitive file access" Style="{StaticResource AppCheckBox}" Margin="0,4" />
              <ComboBox x:Name="FileAccessSeverity" Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4" />

              <CheckBox x:Name="SkillCheck" Grid.Row="4" Grid.Column="0" Content="Suspicious skills" Style="{StaticResource AppCheckBox}" Margin="0,4" />
              <ComboBox x:Name="SkillSeverity" Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Protected paths" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Blackbox matches these paths when an agent hook is active. This is not a Windows Firewall rule."
                       Style="{StaticResource Caption}"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap" />

            <ListBox x:Name="PathsList"
                     Height="150"
                     Margin="0,10,0,0"
                     Background="{DynamicResource Brush.SurfaceAlt}"
                     BorderBrush="{DynamicResource Brush.Border}"
                     BorderThickness="1"
                     Padding="4" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathBox"
                       Grid.Column="0"
                       Height="30"
                       VerticalContentAlignment="Center"
                       ToolTip="Enter a file, directory, or Blackbox glob pattern." />
              <Button Grid.Column="1"
                      Style="{StaticResource GhostButton}"
                      Content="Add pattern"
                      Margin="8,0,0,0"
                      Click="AddPattern_Click" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource GhostButton}" Content="Add file…" Click="AddFile_Click" Margin="0,0,8,0" />
              <Button Style="{StaticResource GhostButton}" Content="Add folder…" Click="AddFolder_Click" Margin="0,0,8,0" />
              <Button Style="{StaticResource GhostButton}" Content="Remove selected" Click="RemovePath_Click" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Trader Shield" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="TraderShieldText"
                       Style="{StaticResource BodyMuted}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="Read-only status is unavailable until settings load." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Style="{StaticResource GhostButton}"
              Content="Open Dashboard"
              HorizontalAlignment="Left"
              Click="OpenDashboard_Click" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource GhostButton}" Content="Reload" Click="Reload_Click" Margin="0,0,8,0" />
        <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save and verify" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
