<UserControl x:Class="Netpetra.UI.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Netpetra.UI.ViewModels"
             PreviewKeyDown="OnPreviewKeyDown">

  <Grid Margin="24,18,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <Border Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="Range" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <ListBox Style="{StaticResource SegmentList}"
                   ItemsSource="{Binding Ranges}"
                   SelectedItem="{Binding SelectedRange}"
                   AutomationProperties.Name="Event time range" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Category" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <ListBox Style="{StaticResource SegmentList}"
                   ItemsSource="{Binding Categories}"
                   SelectedItem="{Binding SelectedCategory}"
                   AutomationProperties.Name="Event category" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,14,0">
          <TextBlock Text="Search app, path, remote or PID" Style="{StaticResource Caption}" Margin="0,0,0,5" />
          <TextBox x:Name="SearchBox"
                   Width="250"
                   Style="{StaticResource FilterTextBox}"
                   AutomationProperties.Name="Search events by app, path, remote or PID"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,6">
          <CheckBox Style="{StaticResource AppCheckBox}"
                    Content="Group by application"
                    IsChecked="{Binding IsGroupedByApp}"
                    Margin="0,0,0,5" />
          <TextBlock Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Text="Times are stored in UTC and shown in local time. Byte counts are not stored yet." />
        </StackPanel>

        <Button Grid.Column="4"
                Style="{StaticResource GhostButton}"
                Content="Refresh"
                VerticalAlignment="Bottom"
                Margin="0,0,8,0"
                Command="{Binding RefreshCommand}" />

        <Button Grid.Column="5"
                Style="{StaticResource PrimaryButton}"
                Content="Export CSV"
                VerticalAlignment="Bottom"
                IsEnabled="{Binding CanExport}"
                Command="{Binding ExportCsvCommand}" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1"
               Text="{Binding StatusText}"
               Style="{StaticResource Caption}"
               Margin="2,10,0,0"
               TextWrapping="Wrap" />

    <!-- Timeline table -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,12,16,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Event timeline" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Persisted network flows from the local service. File, agent, system and blocked event feeds are not recorded in this build."
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.AccentSoft}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Top">
              <TextBlock Text="NETWORK"
                         Foreground="{DynamicResource Brush.Accent}"
                         FontSize="9"
                         FontWeight="Bold" />
            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGroupedByApp}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <DataGrid Style="{StaticResource TableDataGrid}"
                    ItemsSource="{Binding Rows}"
                    AutomationProperties.Name="Event timeline"
                    Margin="0,0,0,6">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="TYPE"
                                  Width="70"
                                  Binding="{Binding TypeText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="APP" Width="1.15*"
                                  Binding="{Binding AppDisplayName}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PID"
                                  Width="56"
                                  Binding="{Binding ProcessId}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="PROTO"
                                  Width="56"
                                  Binding="{Binding Protocol}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LOCAL" Width="1.05*"
                                  Binding="{Binding LocalEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="REMOTE" Width="1.15*"
                                  Binding="{Binding RemoteEndpoint}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="DIR"
                                  Width="40"
                                  Binding="{Binding DirectionText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="STATE"
                                  Width="84"
                                  Binding="{Binding State}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="QUALITY" Width="78"
                                  Binding="{Binding Quality}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="FIRST SEEN" Width="80"
                                  Binding="{Binding FirstSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
              <DataGridTextColumn Header="LAST SEEN" Width="80"
                                  SortMemberPath="LastSeenUtc"
                                  Binding="{Binding LastSeenText}"
                                  ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="{DynamicResource Brush.Surface}"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
              <TextBlock Text="No events in this view."
                         Style="{StaticResource EmptyStateTitle}"
                         HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource BodyMuted}"
                         TextAlignment="Center"
                         Margin="0,6,0,0"
                         Text="{Binding StatusText}" />
              <TextBlock Style="{StaticResource Caption}"
                         TextAlignment="Center"
                         Margin="0,8,0,0"
                         Text="Network events require the local service (start with --service). File, agent, system and blocked event feeds are not recorded yet." />
            </StackPanel>
          </Border>
          </Grid>

          <Grid Visibility="{Binding IsGroupedByApp, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
              <ItemsControl ItemsSource="{Binding AppGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:EventAppGroup}">
                    <Border BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="12,4">
                      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Stretch"
                                Foreground="{DynamicResource Brush.TextPrimary}">
                        <Expander.Header>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                              <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}"
                                         FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}" />
                          </Grid>
                        </Expander.Header>
                        <DataGrid Style="{StaticResource TableDataGrid}"
                                  ItemsSource="{Binding Events}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MaxHeight="260"
                                  Margin="0,8,0,0"
                                  HeadersVisibility="Column"
                                  AutomationProperties.Name="Events in application group">
                          <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                              <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
                            </Style>
                          </DataGrid.RowStyle>
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Width="56" Binding="{Binding ProcessId}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="PROTO" Width="56" Binding="{Binding Protocol}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="LOCAL" Width="1.05*" Binding="{Binding LocalEndpoint}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="REMOTE" Width="1.15*" Binding="{Binding RemoteEndpoint}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="DIR" Width="40" Binding="{Binding DirectionText}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="STATE" Width="84" Binding="{Binding State}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="QUALITY" Width="78" Binding="{Binding Quality}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="FIRST SEEN" Width="80" Binding="{Binding FirstSeenText}" ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="LAST SEEN" Width="80" Binding="{Binding LastSeenText}" ElementStyle="{StaticResource TableText}" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </Expander>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource Brush.Surface}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="No applications match these filters."
                           Style="{StaticResource EmptyStateTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource BodyMuted}"
                           TextAlignment="Center"
                           Margin="0,6,0,0"
                           Text="Reset the filters or switch back to the event view." />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="3"
               Style="{StaticResource Caption}"
               Margin="2,8,0,0"
               FontFamily="{StaticResource Font.Mono}"
               TextTrimming="CharacterEllipsis"
               Text="{Binding DatabaseText}" />
  </Grid>
</UserControl>
