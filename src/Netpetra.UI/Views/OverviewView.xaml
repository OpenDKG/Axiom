<UserControl x:Class="Netpetra.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Netpetra.UI.Controls"
             xmlns:vm="clr-namespace:Netpetra.UI.ViewModels">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24">

      <!-- What is real in this build, with the live KPI row kept in the same card -->
      <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE946;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="15"
                     Foreground="{DynamicResource Brush.Accent}"
                     VerticalAlignment="Top"
                     Margin="0,1,10,0" />
          <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <TextBlock Text="Live inventory, read-only"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BodyMuted}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding ThroughputNote}" />
            <TextBlock Text="{Binding NewConnectionsText}"
                       Style="{StaticResource Caption}"
                       Foreground="{DynamicResource Brush.Success}"
                       Margin="0,5,0,0" />
            <TextBlock Text="{Binding UptimeText, StringFormat=Computer uptime: {0}}"
                       Style="{StaticResource Caption}"
                       Margin="0,2,0,0" />
          </StackPanel>

          <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <DockPanel>
                <TextBlock Text="ACTIVE SOCKETS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                  <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
                </Border>
              </DockPanel>
              <TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource MetricValue}" />
              <TextBlock Text="TCP + UDP owner tables" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="14,0,8,0">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="PROCESSES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                    <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
                  </Border>
                </DockPanel>
                <TextBlock Text="{Binding ProcessesText}" Style="{StaticResource MetricValue}" />
                <TextBlock Text="with at least one socket" Style="{StaticResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="14,0,8,0">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="LOOPBACK" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                    <TextBlock Text="LIVE" Style="{StaticResource LiveBadgeText}" />
                  </Border>
                </DockPanel>
                <TextBlock Text="{Binding LoopbackText}" Style="{StaticResource MetricValue}" />
                <TextBlock Text="local-only endpoints" Style="{StaticResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="OWNED RULES" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource LiveBadge}" HorizontalAlignment="Right">
                    <TextBlock Text="READ-ONLY" Style="{StaticResource LiveBadgeText}" />
                  </Border>
                </DockPanel>
                <TextBlock Text="{Binding OwnedRulesText}" Style="{StaticResource MetricValue}" />
                <TextBlock Text="firewall adapter is FND-006" Style="{StaticResource Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0" DataContext="{Binding AgentActivity}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Agent activity" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Recorded sessions, API calls, tool calls and installs from the local Blackbox audit."
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Local audit ? secrets masked"
                       Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ListBox Style="{StaticResource SegmentList}"
                     ItemsSource="{Binding ActivityFilters}"
                     SelectedItem="{Binding SelectedActivityFilter, Mode=TwoWay}"
                     Margin="0,0,8,0"
                     ToolTip="Filter by recorded sessions, API calls, tool calls, installs, file access or threats."
                     AutomationProperties.Name="Activity filter" />
            <ComboBox Width="130"
                      ItemsSource="{Binding AgentFilters}"
                      SelectedItem="{Binding SelectedAgentFilter, Mode=TwoWay}"
                      Margin="0,0,8,0"
                      ToolTip="Filter by agent." />
            <ComboBox Width="140"
                      ItemsSource="{Binding SeverityFilters}"
                      SelectedItem="{Binding SelectedSeverityFilter, Mode=TwoWay}"
                      ToolTip="Filter by severity." />
          </StackPanel>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding ActivityStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ActivityBreakdownText}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
              <TextBlock Text="{Binding LastBlockedText}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProtectedPathViolationsText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
              <TextBlock Text="{Binding UnresolvedText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Content="Load more"
                    Padding="9,4"
                    FontSize="11"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding LoadMoreActivityCommand}"
                    Visibility="{Binding CanLoadMoreActivity, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Load the next 100 recorded events, up to the Blackbox dashboard limit." />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Activity}"
                      SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                      Style="{StaticResource TableDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MaxHeight="360"
                      EnableRowVirtualization="True"
                      HeadersVisibility="Column"
                      RowHeight="28">
              <DataGrid.Columns>
                <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="68" />
                <DataGridTextColumn Header="AGENT" Binding="{Binding Agent}" Width="88" />
                <DataGridTextColumn Header="EVENT" Binding="{Binding EventLabel}" Width="112" />
                <DataGridTextColumn Header="DETAILS" Binding="{Binding ActionSummary}" Width="*" />
                <DataGridTextColumn Header="SESSION" Binding="{Binding Session}" SortMemberPath="Session" Width="78" />
                <DataGridTemplateColumn Header="SECURITY"
                                        SortMemberPath="SecurityOutcome"
                                        CanUserSort="True"
                                        Width="94">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SecurityOutcome}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding SecurityOutcomeDetail}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSecurityThreat}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" SortMemberPath="Severity" Width="70" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    MaxHeight="360"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="Activity details" Style="{StaticResource SectionTitle}" FontSize="13" />
                  <TextBlock Text="{Binding SelectedActivityTitle}"
                             Style="{StaticResource Caption}"
                             Margin="0,3,0,0"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SelectedActivityDetails}" Margin="0,9,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Label}"
                                     Style="{StaticResource Caption}"
                                     VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Value}"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     FontSize="11.5"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Visibility="{Binding HasSelectedActivity, Converter={StaticResource BoolToVisibility}}"
                              Margin="0,8,0,0">
                    <TextBlock Text="RAW EVENT ? SECRETS MASKED"
                               Style="{StaticResource Caption}"
                               FontSize="9.5"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding SelectedActivityRawText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="10.5"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             Background="{DynamicResource Brush.WindowBackground}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Height="150" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Measured throughput (historical data deliberately unavailable until service capture exists) -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12,16,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Throughput" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <Border Margin="8,0,0,0">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DemoBadge}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TrafficBadgeText}" Value="LIVE COUNTERS">
                          <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding TrafficBadgeText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource DemoBadgeText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TrafficBadgeText}" Value="LIVE COUNTERS">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding BucketLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <ListBox Style="{StaticResource SegmentList}"
                       ItemsSource="{Binding RateUnits}"
                       SelectedItem="{Binding SelectedRateUnit}"
                       Margin="0,0,8,0"
                       AutomationProperties.Name="Rate unit" />
              <ListBox Style="{StaticResource SegmentList}"
                       ItemsSource="{Binding Ranges}"
                       SelectedItem="{Binding SelectedRange}"
                       AutomationProperties.Name="Chart range" />
            </StackPanel>
          </Grid>

          <Border Margin="0,10,0,0"
                  Height="128"
                  Background="{DynamicResource Brush.SurfaceAlt}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,8,10,10">
            <controls:TrafficChart Upload="{Binding UploadSeries}"
                                    IsLive="{Binding IsTrafficLive}"
                                    RateUnit="{Binding SelectedRateUnit}"
                                    Download="{Binding DownloadSeries}"
                                    UploadBrush="{DynamicResource Brush.Upload}"
                                    DownloadBrush="{DynamicResource Brush.Download}"
                                    GridBrush="{DynamicResource Brush.GridLine}"
                                    MarkerPositions="{Binding NewConnectionMarkers}"
                                    MarkerLabels="{Binding NewConnectionMarkerLabels}"
                                    MarkerDetails="{Binding NewConnectionMarkerDetails}"
                                    SelectedMarkerIndex="{Binding SelectedMarkerIndex, Mode=TwoWay}"
                                    MarkerBrush="{DynamicResource Brush.Warning}"
                                    AutomationProperties.Name="Throughput chart"
                                    AutomationProperties.HelpText="{Binding ChartHelpText}" />
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Current upload: " Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding UploadRateText}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Margin="0,0,20,0" />
            <TextBlock Text="Current download: " Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding DownloadRateText}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
          </StackPanel>

          <DockPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding UploadLegendText}" Style="{StaticResource Caption}" Margin="6,0,16,0" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DownloadLegendText}" Style="{StaticResource Caption}" Margin="6,0,16,0" VerticalAlignment="Center" />
              <Border Width="1" Height="10" Background="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
              <TextBlock Text="New connection marker" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       Style="{StaticResource Caption}"
                       Text="{Binding RangeNote}" />
          </DockPanel>

          <TextBlock Style="{StaticResource Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="Measured interface-level rates only; per-application rates are not available. Historical throughput requires persistent service-side measurement. Yellow markers are newly observed sockets from this UI session, not evidence of malware." />

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10,0,2" />
          <Button Style="{StaticResource GhostButton}"
                  Command="{Binding ToggleNewConnectionEventsCommand}"
                  HorizontalContentAlignment="Stretch"
                  Padding="0"
                  BorderThickness="0"
                  Background="Transparent"
                  AutomationProperties.Name="Toggle new connection events"
                  ToolTip="Expand or collapse the session connection event list.">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="New connection events" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding NewConnectionEventsEmptyText}"
                           Style="{StaticResource Caption}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0">
                <TextBlock Text="{Binding NewConnectionEventsToggleText}"
                           Style="{StaticResource Caption}"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding NewConnectionEventsChevron}"
                           Foreground="{DynamicResource Brush.Accent}"
                           Margin="6,0,0,0"
                           FontSize="10" />
              </StackPanel>
            </Grid>
          </Button>
          <StackPanel Visibility="{Binding IsNewConnectionEventsExpanded, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="0,8,0,6" Padding="10,8" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}" CornerRadius="5">
              <TextBlock Text="{Binding SelectedConnectionDetails}" TextWrapping="Wrap"
                         Style="{StaticResource BodyMuted}" />
            </Border>
            <ItemsControl ItemsSource="{Binding NewConnectionEvents}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeText}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Summary}"
                               Style="{StaticResource BodyMuted}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Summary}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Session-only time navigator. Historical coverage requires service persistence. -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14,18,14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Connection time explorer" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Inspect first-observed applications and remote endpoints near a moment in the live 5-minute window."
                         Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Jump to now" Margin="12,0,0,0"
                    Command="{Binding JumpToNowCommand}" IsEnabled="{Binding IsTrafficLive}"
                    AutomationProperties.Name="Jump timeline cursor to now" />
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="-5m" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding TimelineCursorPosition, Mode=TwoWay}"
                    SmallChange="1" LargeChange="15" TickFrequency="30"
                    IsSnapToTickEnabled="False" IsEnabled="{Binding IsTrafficLive}"
                    AutomationProperties.Name="Observed connection time cursor in five-minute window"
                    ToolTip="Select a point in the last five minutes to inspect newly observed socket events." />
            <TextBlock Grid.Column="2" Text="Now" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding TimelineCursorTimeText}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
          <TextBlock Text="{Binding TimelineFocusText}" Style="{StaticResource BodyMuted}"
                     TextWrapping="Wrap" Margin="0,7,0,0" />
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,12,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Applications &amp; remote endpoints" Style="{StaticResource SectionTitle}" />
            <TextBlock Grid.Column="1" Text="{Binding TimelineEndpointCountText}"
                       Style="{StaticResource Caption}" HorizontalAlignment="Right" />
          </Grid>
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TimelineEndpoints}" Margin="0,5,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                          Padding="0,8,0,8" ToolTip="{Binding Detail}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding AppText}" Style="{StaticResource BodyMuted}"
                                 TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Remote}" Style="{StaticResource Caption}"
                                 TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="2" Text="{Binding ObservationsText}" Style="{StaticResource Caption}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Observed socket starts only: not a record of all active connections, traffic volume, IP geolocation, or verified alerts."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Bottom row -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="Top executables by sockets"
                         Style="{StaticResource SectionTitle}"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Background="{DynamicResource Brush.AccentSoft}"
                      CornerRadius="4"
                      Padding="6,2">
                <TextBlock Text="LIVE"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontSize="9"
                           FontWeight="Bold" />
              </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding TopApps}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppRow}">
                  <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                      <Border Width="{Binding BarWidth}"
                              Height="5"
                              CornerRadius="2.5"
                              Background="{DynamicResource Brush.Accent}"
                              HorizontalAlignment="Left"
                              Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SocketsText}"
                               Style="{StaticResource Caption}"
                               FontFamily="{StaticResource Font.Mono}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Capture state" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="6,0,0,8" TextTrimming="CharacterEllipsis" MaxWidth="140" />

              <TextBlock Grid.Row="1" Text="Last poll" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Text="Unowned (PID 0)" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnownedText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" Text="Byte measurement" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ByteMeasurementText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="4" Text="Database" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatabaseText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="5" Text="Service install" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="not installed" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="6" Text="Computer uptime" Style="{StaticResource BodyMuted}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource BodyMuted}" />
            </Grid>

            <TextBlock Style="{StaticResource Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Text="Counts are a point-in-time poll: connections shorter than one interval can be missed and are not reconstructed." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
