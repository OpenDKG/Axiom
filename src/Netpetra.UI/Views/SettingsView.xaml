<UserControl x:Class="Netpetra.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding CurrentThemeText, StringFormat=Active theme: {0}}"
                     Style="{StaticResource Caption}"
                     Margin="0,3,0,10" />
          <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Button Content="Dark · Graphite" Command="{Binding UseDarkThemeCommand}" Margin="0,0,8,8" MinWidth="126">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentThemeText}" Value="Dark">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentContrast}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Dark · Midnight" Command="{Binding UseDarkMidnightThemeCommand}" Margin="0,0,8,8" MinWidth="126">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentThemeText}" Value="DarkMidnight">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentContrast}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Light · Clean" Command="{Binding UseLightThemeCommand}" Margin="0,0,8,8" MinWidth="126">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentThemeText}" Value="Light">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentContrast}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Light · Warm" Command="{Binding UseLightWarmThemeCommand}" Margin="0,0,8,8" MinWidth="126">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentThemeText}" Value="LightWarm">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentContrast}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </WrapPanel>
          <TextBlock Style="{StaticResource Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="The theme is saved for the next launch." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="System tray &amp; notifications" Style="{StaticResource SectionTitle}" />
          <CheckBox Style="{StaticResource AppCheckBox}"
                    Content="Show Windows notifications when network monitoring fails"
                    IsChecked="{Binding TrayNotificationsEnabled, Mode=TwoWay}"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="Enable monitoring problem notifications" />
          <TextBlock Text="The icon next to the Windows clock shows measured upload/download on hover and in its menu. A red exclamation warns about an actual monitoring failure, even with pop-up notifications disabled. This does not assert malware detection."
                     Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Build and runtime" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Milestone" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MilestoneText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="1" Text="Data mode" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataModeText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="2" Text="Collector" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CollectorText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="3" Text="Poll interval" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PollText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="4" Text="IPC contract" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProtocolText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="5" Text="History database" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StorageText}" Style="{StaticResource BodyMuted}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Margin="0,0,0,9" />

            <TextBlock Grid.Row="6" Text="Operating system" Style="{StaticResource Caption}" Margin="0,0,0,9" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OsText}" Style="{StaticResource BodyMuted}" Margin="0,0,0,9" />

            <TextBlock Grid.Row="7" Text="Process" Style="{StaticResource Caption}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProcessText}" Style="{StaticResource BodyMuted}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource BodyMuted}"
                     Margin="0,8,0,0"
                     Text="No account, no cloud, no telemetry. Socket rows are read locally from this machine; the 5m throughput view samples system-wide interface counters, and longer ranges remain a demo series. Nothing is uploaded anywhere." />
          <TextBlock Style="{StaticResource BodyMuted}"
                     Margin="0,8,0,0"
                     Text="External lookups are opt-in. VirusTotal hash lookup requires your own API key; the community feed can be the bundled local starter file or an HTTPS source. No file content is uploaded." />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Caption}"
                 Margin="2,12,0,0"
                 TextWrapping="Wrap"
                 Text="Windows 11 x64 is the supported target; Windows 10 is best-effort. This host runs Windows 10 IoT Enterprise LTSC 2021 (10.0.19044)." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
