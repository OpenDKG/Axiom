<Window x:Class="Netpetra.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Netpetra.UI.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Netpetra — Open-Source Firewall &amp; Security Monitor"
        Icon="/Netpetra.UI;component/Resources/netpetra.ico"
        Height="900"
        Width="1460"
        MinHeight="720"
        MinWidth="1080"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="OnWindowStateChanged"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- Custom native-chrome-compatible caption; Windows still owns resize/maximize behavior. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="{DynamicResource Brush.NavBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
            MouseMove="OnTitleBarMouseMove"
            MouseLeftButtonUp="OnTitleBarMouseLeftButtonUp">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="/Netpetra.UI;component/Resources/netpetra-icon.png"
                 Width="22" Height="22" Stretch="Uniform" />
          <TextBlock Text="NETPETRA" FontWeight="SemiBold" FontSize="11"
                     Margin="10,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="Network activity &amp; security" Style="{StaticResource Caption}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Style="{StaticResource GhostButton}" Width="46" Height="33" Padding="0"
                  Content="—" ToolTip="Minimize" AutomationProperties.Name="Minimize Netpetra"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClicked" />
          <Button x:Name="MaximizeButton" Style="{StaticResource GhostButton}" Width="46" Height="33" Padding="0"
                  Content="□" ToolTip="Maximize" AutomationProperties.Name="Maximize Netpetra"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClicked" />
          <Button Style="{StaticResource GhostButton}" Width="46" Height="33" Padding="0"
                  Content="×" ToolTip="Close Netpetra" AutomationProperties.Name="Close Netpetra"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ Navigation rail ============================ -->
    <Border Grid.Row="1" Grid.RowSpan="3"
            Grid.Column="0"
            Background="{DynamicResource Brush.NavBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="0,18,0,10">
        <StackPanel DockPanel.Dock="Top" Margin="20,0,20,18">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Netpetra.UI;component/Resources/netpetra-icon.png"
                   Width="30" Height="30" Stretch="Uniform" />
            <TextBlock Text="Netpetra" FontSize="16" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Border Style="{StaticResource LiveBadge}">
              <TextBlock Style="{StaticResource LiveBadgeText}" Text="{Binding StatusLiveText}" />
            </Border>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,10">
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Netpetra.UI;component/Resources/netpetra-icon.png"
                   Width="38" Height="38" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NetPetra" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Open-source firewall &amp; network monitor"
                     Style="{StaticResource Caption}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="GitHub"
                    Command="{Binding OpenGitHubCommand}"
                    Padding="10,4"
                    Height="27"
                    Margin="0,0,6,0"
                    ToolTip="Open the Netpetra GitHub repository." />
            <Button Style="{StaticResource GhostButton}"
                    Command="{Binding OpenSupportCommand}"
                    Padding="9,4"
                    Height="27"
                    ToolTip="Support Netpetra">
              <TextBlock Text="♥ Donate" Foreground="{DynamicResource Brush.Accent}" FontSize="12" />
            </Button>
          </StackPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 AutomationProperties.Name="Main navigation"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource NavItem}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================ Top bar ============================ -->
    <Border Grid.Row="1"
            Grid.Column="1"
            Background="{DynamicResource Brush.WindowBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1">
      <Grid Margin="24,0,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedPage.Title}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedPage.Subtitle}"
                     Style="{StaticResource PageSubtitle}"
                     Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusModeText}" Style="{StaticResource StatusPillText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusFirewallBadgeText}" Style="{StaticResource StatusPillText}" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource GhostButton}"
                  Content="{Binding ThemeToggleLabel}"
                  Command="{Binding ToggleThemeCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ Page host ============================ -->
    <ContentControl Grid.Row="2"
                    Grid.Column="1"
                    Content="{Binding SelectedPage}"
                    Focusable="False" />

    <!-- ============================ Status bar ============================ -->
    <Border Grid.Row="3"
            Grid.Column="1"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,0,20,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMonitoringText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusFirewallText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusStorageText}" Style="{StaticResource StatusPillText}" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StatusDataSourceText}" Style="{StaticResource StatusPillText}" Foreground="{DynamicResource Brush.DemoBadgeText}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBlock Text="&#xE9D9;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.Accent}"
                     VerticalAlignment="Center" />
          <TextBlock Text="OriginTrail DKG · optional"
                     Style="{StaticResource Caption}"
                     Margin="4,0,12,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="&#xE83D;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.Success}"
                     VerticalAlignment="Center" />
          <TextBlock Text="Umanitek Blackbox · optional"
                     Style="{StaticResource Caption}"
                     Margin="4,0,12,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusIpcText}"
                     Style="{StaticResource Caption}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
