<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark palette. Neutral graphite with a teal measurement accent; no third-party branding. -->
  <SolidColorBrush x:Key="Brush.WindowBackground" Color="#0F1216" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#161B22" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1B222B" />
  <SolidColorBrush x:Key="Brush.Border" Color="#2E3A47" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#5A7088" />

  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E6EDF3" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9BA9B8" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A98A8" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#5EEAD4" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#12332F" />
  <SolidColorBrush x:Key="Brush.AccentContrast" Color="#062A27" />

  <SolidColorBrush x:Key="Brush.Upload" Color="#5EEAD4" />
  <SolidColorBrush x:Key="Brush.Download" Color="#7AA2FF" />

  <SolidColorBrush x:Key="Brush.Success" Color="#4ADE80" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#F2B450" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#F87171" />

  <SolidColorBrush x:Key="Brush.NavBackground" Color="#0B0F13" />
  <SolidColorBrush x:Key="Brush.NavHover" Color="#171E26" />
  <SolidColorBrush x:Key="Brush.NavSelected" Color="#15262A" />

  <SolidColorBrush x:Key="Brush.GridLine" Color="#222B35" />
  <SolidColorBrush x:Key="Brush.DemoBadgeBackground" Color="#3A2E12" />
  <SolidColorBrush x:Key="Brush.DemoBadgeText" Color="#F2B450" />

  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A4756" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#4C5C6E" />

</ResourceDictionary>
