<Project>

  <!--
    Inherit the repository-wide settings, then relax naming rules that conflict with the
    descriptive test-name convention (Create_then_parse_round_trips).
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
