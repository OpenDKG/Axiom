<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the net10.0 (Unix) build of the service, axiomd: runs on Linux and macOS hosts, so a
    macOS-only wiring mistake is caught without a Mac. Skipped by `dotnet test Axiom.sln` on Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</IsTestProject>
    <IsTestProject Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <RootNamespace>Axiom.Service.Unix.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axiom.Service\Axiom.Service.csproj" />
  </ItemGroup>

</Project>
