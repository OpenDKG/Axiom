<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      Linux-only desktop behaviour (pkexec wording, '/' paths, desktop.lock): the project still compiles everywhere, but `dotnet test Axiom.sln` on a Windows runner skips it.
    -->
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</IsTestProject>
    <IsTestProject Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axiom.Desktop.Avalonia.Linux\Axiom.Desktop.Avalonia.Linux.csproj" />
    <ProjectReference Include="..\..\src\Axiom.Presentation\Axiom.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Axiom.Contracts\Axiom.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
